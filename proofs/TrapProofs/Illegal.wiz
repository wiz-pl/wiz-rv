import TrapProofs.Base
-- Pf.illegal_enter: the statement and its form are in proofs/TrapProofs/Base.wiz and docs/csr.md
def Pf.illegal_enter : Pf.EnterClaim 4294967295 := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.entryOk In.idle (Pf.withH a) 4294967295 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio (Pf.entryOf (Rv.exec Pf.cfg (Pf.withH a) 4294967295)) rfl h
