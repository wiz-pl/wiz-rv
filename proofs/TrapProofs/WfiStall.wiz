import TrapProofs.Base
-- Pf.wfi_stall: the statement and its form are in proofs/TrapProofs/Base.wiz and docs/csr.md
def Pf.wfi_stall : Pf.IrqClaim In.idle Pf.withH Rv.wfiWord := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h hs =>
  Pf.irqOk In.idle (Pf.withH a) Rv.wfiWord m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h hs
