import PipeProofs.Base
-- ANDI, field by field: the three cycles with D presenting the word as a hit (`Qp.G`,
-- the step function `pipeStepW` with D's word and hit given) agree with the specification
-- in each observed value. (The claim in the form of Xor.wiz, `Qp.ok` with one `rfl` of the
-- whole record, went over heavy's 5 GB memory cap for the immediate forms; each field
-- takes seconds. FINDINGS.md, H10.)
def Qp.andi_npc (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (ea eb mres rval : BitVec 32) :
    (Qp.G (Qp.at a (Qp.w (A.andi 9 3 (-2048))) m0 m1 m2 m3 ea eb mres rval) (BitVec.ofNat 32 (Qp.w (A.andi 9 3 (-2048))), BitVec.ofNat 1 1)).npc = (Qp.spec a (Qp.w (A.andi 9 3 (-2048))) 9).npc := rfl
def Qp.andi_pc (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (ea eb mres rval : BitVec 32) :
    (Qp.G (Qp.at a (Qp.w (A.andi 9 3 (-2048))) m0 m1 m2 m3 ea eb mres rval) (BitVec.ofNat 32 (Qp.w (A.andi 9 3 (-2048))), BitVec.ofNat 1 1)).pc = (Qp.spec a (Qp.w (A.andi 9 3 (-2048))) 9).pc := rfl
