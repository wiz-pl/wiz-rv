def Qp.andi_rd (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (ea eb mres rval : BitVec 32) :
    (Qp.G (Qp.at a (Qp.w (A.andi 9 3 (-2048))) m0 m1 m2 m3 ea eb mres rval) (BitVec.ofNat 32 (Qp.w (A.andi 9 3 (-2048))), BitVec.ofNat 1 1)).rd = (Qp.spec a (Qp.w (A.andi 9 3 (-2048))) 9).rd := rfl
