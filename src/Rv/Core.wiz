import Hdl.Core
import Rv.Isa
-- A multi-cycle RV32I / RV32E core: a 32-bit datapath, the registers and the memory in
-- block RAM. Parameters: `ab`, the register address bits (5: RV32I, 4: RV32E), and
-- `wb`, the memory's word address bits (2^wb words of 32 bits, as four byte lanes of
-- 2^wb bytes each, so that byte and halfword stores need no read-modify-write).
--
-- Every memory read is registered (an iCE40 or Xilinx block RAM): the four `q` lanes
-- are the memory's read data, `x1`, `x2` the register file's. The register file is two
-- copies (`rfa`, `rfb`, written together), so that rs1 and rs2 are read in one cycle.
--
-- Phases (`ph`):
--   F  fetch: read the word at PC (after reset and after a store)
--   D  decode: the instruction is in `q`; read rs1 and rs2
--   E  execute: ALU, branch, next PC, register write; a load reads memory, a store
--      writes it; the next instruction's word is read (unless a load or store)
--   M  memory: the loaded word is in `q`; write rd; read the word at PC
--   S  shift: one place per cycle, `cnt` left; then write rd
--   H  stopped (the trap cause in `trap`, what faulted in `tval`; the PC, which is not
--      written on a trap, is the trap's epc: the instruction it stopped on)
--   P  a bus access (DDR: the fetch or load before D or M, a store before F), until
--      it is answered
--   X  (M) the product is written
--   V  (M) division: one quotient bit per cycle, 32 cycles, then the result is written
-- So an instruction takes 2 cycles (D, E), a load 3, a store 3, a shift 3 + its amount,
-- a multiplication 3, a division 34. `mx` adds the M extension (without it, X and V
-- and the multiplier and divider are not built).

def B2 : HwTy := HwTy.bits 2
def B3 : HwTy := HwTy.bits 3
def B4 : HwTy := HwTy.bits 4
def B5 : HwTy := HwTy.bits 5
def B7 : HwTy := HwTy.bits 7
def W8 : HwTy := HwTy.bits 8
def B12 : HwTy := HwTy.bits 12
def B16 : HwTy := HwTy.bits 16
def B20 : HwTy := HwTy.bits 20
def B32 : HwTy := HwTy.bits 32
def B34 : HwTy := HwTy.bits 34
def W1 : HwTy := HwTy.bit

def Ph.f : Nat := 0
def Ph.d : Nat := 1
def Ph.e : Nat := 2
def Ph.m : Nat := 3
def Ph.s : Nat := 4
def Ph.h : Nat := 5
def Ph.x : Nat := 6   -- M: the product (one cycle)
def Ph.v : Nat := 7   -- M: division, one quotient bit per cycle
def Ph.p : Nat := 8   -- a bus access (DDR), until it is answered
def Ph.q : Nat := 9   -- after a cache line was filled: read it again
def Ph.w : Nat := 10  -- FENCE: the drain point between two instructions
def Ph.a : Nat := 11  -- a local AMO writes the word (its old value is in `amoO`)
def Ph.j : Nat := 12  -- C: read the second word of a 32-bit instruction at pc[1] = 1

-- The L1 cache in front of DDR (unified: the core reads one word at a time, an
-- instruction or data): 2^lb lines of 16 bytes in block RAM, direct-mapped, write-through
-- without allocation (a store to a line that is present updates it). A tag is the
-- valid bit and address bits 27 … 4 + lb. 16 KB (lb = 10) for the Doom machine (wb = 12);
-- one line for the smaller configurations, which have no DDR.
def L1.bits (wb : Nat) : Nat := if Nat.lt wb 12 then 1 else 10
def L1.tagW (wb : Nat) : Nat := Nat.add 1 (24 - L1.bits wb)
def B128 : HwTy := HwTy.bits 128

-- The uncached shared aperture: the top 16 MB of DDR (0x4F00_0000 … 0x4FFF_FFFF) is
-- never read into or written from the private L1. A word there is one bus request, so
-- every access goes to the single shared DDR cache, the point where the harts' stores
-- are serialised. Golem's mailbox flags and shared data live here; `GMap.uncBase`
-- repeats the constant for the memory map (this module does not import the SoC).
-- (`Rv.Isa`/`Rv.Golem.CohModel` call the aperture `ldu`/`stu`.)
def Core.uncBase : Nat := 1325400064   -- 0x4F00_0000
def Core.uncBytes : Nat := 16777216    -- 16 MB

def Core.isUncached {r : HwTy → Type} [Hw r] (a : r B32) : r W1 :=
  Hw.and (Hw.not (Hw.ult a (Hw.lit 32 Core.uncBase)))
    (Hw.ult a (Hw.lit 32 (Core.uncBase + Core.uncBytes)))

-- The machine-mode CSRs (the subset the SoC needs). `mtval` is `CoreSt.tval`; `mip`
-- is the `In.irq*` input, read-only.
structure CsrFile (r : HwTy → Type) where
  mstatus : r B32
  mie : r B32
  mtvec : r B32
  mscratch : r B32
  mepc : r B32
  mcause : r B32
  deriving Bundle

-- (`mstatus` resets to MPP = M, 0x1800: the field is read-only 3 on an M-only hart)
def CsrFile.init : CsrFile HwTy.El :=
  CsrFile.mk (BitVec.ofNat 32 Csr.mppM) (BitVec.ofNat 32 0) (BitVec.ofNat 32 0)
    (BitVec.ofNat 32 0) (BitVec.ofNat 32 0) (BitVec.ofNat 32 0)

def CsrFile.zero {r : HwTy → Type} [Hw r] : CsrFile r :=
  CsrFile.mk (Hw.lit 32 Csr.mppM) (Hw.lit 32 0) (Hw.lit 32 0) (Hw.lit 32 0) (Hw.lit 32 0) (Hw.lit 32 0)

-- the reset: every CSR zero, except mstatus.MPP (3)
def CsrFile.reset {r : HwTy → Type} [Hw r] (rst : r W1) (c : CsrFile r) : CsrFile r :=
  CsrFile.mk (Hw.mux rst (Hw.lit 32 Csr.mppM) c.mstatus) (Hw.mux rst (Hw.lit 32 0) c.mie)
    (Hw.mux rst (Hw.lit 32 0) c.mtvec) (Hw.mux rst (Hw.lit 32 0) c.mscratch)
    (Hw.mux rst (Hw.lit 32 0) c.mepc) (Hw.mux rst (Hw.lit 32 0) c.mcause)

structure CoreSt (ab wb : Nat) (r : HwTy → Type) where
  ph : r B4
  pc : r B32
  q0 : r W8
  q1 : r W8
  q2 : r W8
  q3 : r W8
  m0 : r (HwTy.mem wb 8)
  m1 : r (HwTy.mem wb 8)
  m2 : r (HwTy.mem wb 8)
  m3 : r (HwTy.mem wb 8)
  rfa : r (HwTy.mem ab 32)
  rfb : r (HwTy.mem ab 32)
  x1 : r B32
  x2 : r B32
  acc : r B32     -- the shifter; the divider's dividend and quotient
  dv : r B32      -- the divider's divisor and remainder (M only)
  rm : r B32
  cnt : r B5      -- places still to shift
  srd : r B5      -- saved for M and S: rd, funct3, the address's low bits / instr bit 30
  sf3 : r B3
  slo : r B2
  sio : r W1     -- saved for M: the load reads the input port
  trap : r B3     -- the trap cause (0 while running); the PC in the H phase is its epc
  tval : r B32    -- what faulted: the bad address, or the instruction word (a trap's
                  -- tval; RISC-V mtval). Latched with `trap` in E, kept while stopped.
  busq : r B32    -- the bus: the word read (used instead of q while `fromBus`)
  fromBus : r W1
  badr : r B32    -- the request: address, write, data, byte enables, the phase after
  bwe : r W1
  bwd : r B32
  bst : r B4
  bret : r B4
  bsent : r W1   -- the request has been taken (`ready` seen)
  ra : r B32      -- the address the memories were last read at (q, l1q, l1t)
  l1q : r B128    -- the L1's read registers: the line, its tag
  l1t : r (HwTy.bits (L1.tagW wb))
  l1d : r (HwTy.mem (L1.bits wb) 128)
  l1tag : r (HwTy.mem (L1.bits wb) (L1.tagW wb))
  fromL1 : r W1   -- the word read is the L1's (DDR)
  rmode : r W1    -- the bus phase is a line fill: word rk of the line at rline, into rbuf
  rk : r B2
  rgap : r W1     -- (a cycle without a request between two words)
  rbuf : r B128
  rline : r B32
  bnew : r W1     -- the first cycle of a store's bus phase (the L1 is updated then)
  resv : r B32    -- the private-memory LR reservation's address (valid if `resOk`)
  resOk : r W1
  amoA : r B32    -- the local atomic's address, and its rs2 (`amoD`)
  amoD : r B32
  amoO : r B32    -- the word the local AMO read (M), written back + rs2 in A
  sf5 : r B5      -- the AMO's funct5
  ak : r B2       -- 0: not atomic; 1: a local LR (M); 2: a local AMO (M then A);
                  -- 3: a shared atomic on the uncached aperture (P then M)
  baop : r B2     -- the shared atomic request: 1 LR, 2 SC, 3 AMO
  baf5 : r B5
  csr : CsrFile r -- the machine CSRs
  w1 : r B32      -- C: the word at the instruction's pc, while `j` fetches the next one
  ins : r B32     -- C: a 32-bit instruction at pc[1] = 1, assembled from two words
  half : r W1     -- C: `ins` is the instruction (the D phase after `j`)
  al : r W1       -- C: bit 1 of the instruction's pc (a register: the 2-cycle proofs
                  -- are about an aligned 32-bit instruction and take it as 0)
  deriving Bundle

-- what the core shows: the trap code (0 while running), and a byte written to the
-- output port (`wr` for one cycle)
-- what the core shows: the trap code (0 while running); an I/O store (`wr` for one
-- cycle, at `ioa` with `iod`; `byte` its low byte) or load (`rd`, its value is `ioIn`);
-- a bus request (DDR: `valid` until `ready`)
structure Out (r : HwTy → Type) where
  trap : r B3
  wr : r W1
  byte : r W8
  rd : r W1
  ioa : r B32
  iod : r B32
  valid : r W1
  addr : r B32
  we : r W1
  wdata : r B32
  wstrb : r B4
  aop : r B2     -- 0: an ordinary word; 1 LR, 2 SC, 3 AMO (the uncached aperture)
  af5 : r B5     -- the AMO's funct5
  pend : r W1    -- a bus access is in progress (phase P)
  deriving Bundle

-- what the core sees: an I/O store may go ahead (it waits in E until it may); the value
-- of an I/O load at `ioa`; the bus's answer (`ready`: the request is taken, and for a
-- write done; `rvalid` with `rdata`: a read's data). The board latches `ready` and
-- `rvalid` until the core has seen them (it may run at a lower rate than the bus).
structure In (r : HwTy → Type) where
  txReady : r W1
  ioIn : r B32
  ready : r W1
  rvalid : r W1
  rdata : r B32
  irqM : r W1    -- the pending machine interrupt inputs: MSIP, MTIP, MEIP
  irqT : r W1
  irqE : r W1
  deriving Bundle

-- `mip` from the three inputs: bits 3 (MSIP), 7 (MTIP) and 11 (MEIP)
def In.mip {r : HwTy → Type} [Hw r] (x : In r) : r B32 :=
  Hw.cat (Hw.lit 20 0) (Hw.cat x.irqE (Hw.cat (Hw.lit 3 0)
    (Hw.cat x.irqT (Hw.cat (Hw.lit 3 0) (Hw.cat x.irqM (Hw.lit 3 0))))))

------------------------------------------------------------------------------------
-- Helpers

-- a barrel shifter: `x` shifted left (`left`) or right by `amt` places, filling with
-- `fill` from the left (0, or the sign bit for an arithmetic shift)
def shift1 {r : HwTy → Type} [Hw r] (left fill on : r W1) (x : r B32) : r B32 :=
  Hw.mux on (Hw.mux left (Hw.cat (Hw.slice 0 31 x : r (HwTy.bits 31)) (Hw.lit 1 0))
    (Hw.cat (Hw.mux fill (Hw.lit 1 1) (Hw.lit 1 0) : r (HwTy.bits 1)) (Hw.slice 1 31 x : r (HwTy.bits 31)))) x
def shift2 {r : HwTy → Type} [Hw r] (left fill on : r W1) (x : r B32) : r B32 :=
  Hw.mux on (Hw.mux left (Hw.cat (Hw.slice 0 30 x : r (HwTy.bits 30)) (Hw.lit 2 0))
    (Hw.cat (Hw.mux fill (Hw.lit 2 3) (Hw.lit 2 0) : r (HwTy.bits 2)) (Hw.slice 2 30 x : r (HwTy.bits 30)))) x
def shift4 {r : HwTy → Type} [Hw r] (left fill on : r W1) (x : r B32) : r B32 :=
  Hw.mux on (Hw.mux left (Hw.cat (Hw.slice 0 28 x : r (HwTy.bits 28)) (Hw.lit 4 0))
    (Hw.cat (Hw.mux fill (Hw.lit 4 15) (Hw.lit 4 0) : r (HwTy.bits 4)) (Hw.slice 4 28 x : r (HwTy.bits 28)))) x
def shift8 {r : HwTy → Type} [Hw r] (left fill on : r W1) (x : r B32) : r B32 :=
  Hw.mux on (Hw.mux left (Hw.cat (Hw.slice 0 24 x : r (HwTy.bits 24)) (Hw.lit 8 0))
    (Hw.cat (Hw.mux fill (Hw.lit 8 255) (Hw.lit 8 0) : r (HwTy.bits 8)) (Hw.slice 8 24 x : r (HwTy.bits 24)))) x
def shift16 {r : HwTy → Type} [Hw r] (left fill on : r W1) (x : r B32) : r B32 :=
  Hw.mux on (Hw.mux left (Hw.cat (Hw.slice 0 16 x : r (HwTy.bits 16)) (Hw.lit 16 0))
    (Hw.cat (Hw.mux fill (Hw.lit 16 65535) (Hw.lit 16 0) : r (HwTy.bits 16)) (Hw.slice 16 16 x : r (HwTy.bits 16)))) x
def barrel {r : HwTy → Type} [Hw r] (left fill : r W1) (amt : r B5) (x : r B32) : r B32 :=
  shift16 left fill (Hw.slice 4 1 amt) (shift8 left fill (Hw.slice 3 1 amt) (shift4 left fill (Hw.slice 2 1 amt)
    (shift2 left fill (Hw.slice 1 1 amt) (shift1 left fill (Hw.slice 0 1 amt) x))))

def bitOf {r : HwTy → Type} [Hw r] {ω n : Nat} (i : Nat) (w : r (HwTy.bits n)) : r W1 := Hw.slice i 1 w
def rep {r : HwTy → Type} [Hw r] (ω n : Nat) (b : r W1) : r (HwTy.bits n) :=
  Hw.mux b (Hw.lit n (Nat.pow 2 n - 1)) (Hw.lit n 0)
def isK {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) (k : Nat) : r W1 := Hw.eq x (Hw.lit n k)

-- the CSR numbers (the machine-mode subset; the ISA's `Csr.a*` has the same values)
def coreCsrExists {r : HwTy → Type} [Hw r] (a : r B12) : r W1 :=
  let info := Hw.and (Hw.not (Hw.ult a (Hw.lit 12 Csr.aMvendorid))) (Hw.ult a (Hw.lit 12 (Csr.aMconfigptr + 1)));
  Hw.or (Hw.or (Hw.or (isK a Csr.aMstatus) (isK a Csr.aMie)) (Hw.or (isK a Csr.aMtvec) (isK a Csr.aMscratch)))
    (Hw.or (Hw.or (Hw.or (isK a Csr.aMepc) (isK a Csr.aMcause)) (Hw.or (isK a Csr.aMtval) (isK a Csr.aMip)))
      (Hw.or (isK a Csr.aMisa) info))
-- (as `Rv.csrWritable`: the 0xc00 … 0xfff block is read-only)
def coreCsrWritable {r : HwTy → Type} [Hw r] (a : r B12) : r W1 :=
  Hw.not (isK (Hw.slice 10 2 a : r B2) 3)

-- a CSR write's value, through the WARL masks of `Rv.csrWrite`
def coreCsrWarl {r : HwTy → Type} [Hw r] (a : r B12) (v : r B32) : r B32 :=
  Hw.mux (isK a Csr.aMstatus) (Hw.or (Hw.and v (Hw.lit 32 Csr.mstatusW)) (Hw.lit 32 Csr.mppM))
    (Hw.mux (isK a Csr.aMie) (Hw.and v (Hw.lit 32 Csr.mieW))
    (Hw.mux (isK a Csr.aMtvec) (Hw.and v (Hw.lit 32 Csr.mtvecW))
    (Hw.mux (isK a Csr.aMepc) (Hw.and v (Hw.lit 32 Csr.mepcW)) v)))

-- `mcause` of an exception: the standard code of the 3-bit trap code (`Trap.mcause`)
def coreTrapMcause {r : HwTy → Type} [Hw r] (t : r B3) : r B32 :=
  Hw.mux (isK t Trap.ecall) (Hw.lit 32 11) (Hw.mux (isK t Trap.ebreak) (Hw.lit 32 3)
    (Hw.mux (isK t Trap.illegal) (Hw.lit 32 2) (Hw.mux (isK t Trap.jump) (Hw.lit 32 0)
    (Hw.mux (isK t Trap.load) (Hw.lit 32 4) (Hw.lit 32 6)))))

-- `mstatus` after trap entry (MPIE = MIE, MIE = 0, MPP = M) and after MRET (MIE = MPIE,
-- MPIE = 1, MPP = M)
def coreTrapMstatus {r : HwTy → Type} [Hw r] (ms : r B32) : r B32 :=
  let noMie := Hw.and ms (Hw.lit 32 4294967287);
  Hw.or (Hw.mux (bitOf Csr.mieBit ms) (Hw.or noMie (Hw.lit 32 128)) (Hw.and noMie (Hw.lit 32 4294967167)))
    (Hw.lit 32 Csr.mppM)
def coreRetMstatus {r : HwTy → Type} [Hw r] (ms : r B32) : r B32 :=
  Hw.or (Hw.or (Hw.mux (bitOf Csr.mpieBit ms) (Hw.or ms (Hw.lit 32 8)) (Hw.and ms (Hw.lit 32 4294967287)))
    (Hw.lit 32 128)) (Hw.lit 32 Csr.mppM)

-- the interrupt to take from `mip & mie`: MEI, then MSI, then MTI (`Rv.irqCause`)
def coreIrqCode {r : HwTy → Type} [Hw r] (on : r B32) : r B4 :=
  Hw.mux (bitOf Csr.meipBit on) (Hw.lit 4 Csr.meiCause)
    (Hw.mux (bitOf Csr.msipBit on) (Hw.lit 4 Csr.msiCause) (Hw.lit 4 Csr.mtiCause))

-- the trap's target (`Rv.vector`): BASE, or BASE + 4 × cause for an interrupt when
-- mtvec.MODE is 1 (vectored)
def coreVector {r : HwTy → Type} [Hw r] (mtvec : r B32) (intr : r W1) (code : r B4) : r B32 :=
  let base := Hw.and mtvec (Hw.lit 32 4294967292);
  Hw.mux (Hw.and intr (bitOf 0 mtvec)) (Hw.add base (Hw.cat (Hw.lit 26 0) (Hw.cat code (Hw.lit 2 0)))) base

-- (`hart` is `mhartid`: 0 on the single-hart machines, the hart's number in golem's
-- four-hart SoC; the other information registers and misa read 0)
def coreCsrRead {r : HwTy → Type} [Hw r] (hart : Nat) (c : CsrFile r) (tval mip : r B32) (a : r B12) : r B32 :=
  Hw.mux (isK a Csr.aMstatus) c.mstatus
    (Hw.mux (isK a Csr.aMie) c.mie
    (Hw.mux (isK a Csr.aMtvec) c.mtvec
    (Hw.mux (isK a Csr.aMscratch) c.mscratch
    (Hw.mux (isK a Csr.aMepc) c.mepc
    (Hw.mux (isK a Csr.aMcause) c.mcause
    (Hw.mux (isK a Csr.aMtval) tval
    (Hw.mux (isK a Csr.aMip) mip
    (Hw.mux (isK a Csr.aMhartid) (Hw.lit 32 hart) (Hw.lit 32 0)))))))))
-- `c and x` for a control signal `c` (one that the instruction alone determines) and a
-- data-dependent `x`, as a multiplexer: at values with `c` known it reduces whatever `x`
-- is, which the single-instruction proofs need (`Hw.and 0 x` is stuck for a symbolic
-- `x`; icestick-uart FINDINGS.md, C2). yosys makes the same AND of it.
def gate {r : HwTy → Type} [Hw r] (c x : r W1) : r W1 := Hw.mux c x (Hw.lit 1 0)
def zext32 {r : HwTy → Type} [Hw r] (b : r W1) : r B32 := Hw.cat (Hw.lit 31 0) b

-- a register field names a register of the configuration (RV32E: below x16)
def regOk {r : HwTy → Type} [Hw r] (ab : Nat) (f : r B5) : r W1 :=
  if Nat.lt ab 5 then isK (bitOf 4 f) 0 else Hw.lit 1 1
def regIx {r : HwTy → Type} [Hw r] (ab : Nat) (f : r B5) : r (HwTy.bits ab) := Hw.slice 0 ab f

-- the physical address of a word: DDR in full, the on-chip memory modulo its size
def coreDdr {r : HwTy → Type} [Hw r] (a : r B32) : r W1 := Hw.and (bitOf 30 a) (Hw.not (bitOf 31 a))
def corePhys {r : HwTy → Type} [Hw r] (wb : Nat) (a : r B32) : r B32 :=
  Hw.mux (coreDdr a) a (Hw.and a (Hw.lit 32 (Nat.pow 2 (wb + 2) - 1)))
-- do two addresses name the same word?
def sameWord {r : HwTy → Type} [Hw r] (wb : Nat) (a b : r B32) : r W1 :=
  Hw.eq (Hw.slice 2 30 (corePhys wb a) : r (HwTy.bits 30)) (Hw.slice 2 30 (corePhys wb b) : r (HwTy.bits 30))

-- The AMO's result from the old word `a` and the source `b` (shared by the core's
-- private-memory AMO and the bus's shared-point RMW, `GBus.amoVal`).
def amoVal {r : HwTy → Type} [Hw r] (f5 : r B5) (a b : r B32) : r B32 :=
  let ult := Hw.ult a b;
  let slt := Hw.mux (Hw.xor (bitOf 31 a) (bitOf 31 b)) (bitOf 31 a) ult;
  Hw.mux (isK f5 0) (Hw.add a b) (Hw.mux (isK f5 1) b (Hw.mux (isK f5 4) (Hw.xor a b)
    (Hw.mux (isK f5 8) (Hw.or a b) (Hw.mux (isK f5 12) (Hw.and a b)
    (Hw.mux (isK f5 16) (Hw.mux slt a b) (Hw.mux (isK f5 20) (Hw.mux slt b a)
    (Hw.mux (isK f5 24) (Hw.mux ult a b) (Hw.mux (isK f5 28) (Hw.mux ult b a) a))))))))

------------------------------------------------------------------------------------
-- The decoded instruction

structure Dec (r : HwTy → Type) where
  rd : r B5
  f3 : r B3
  r1 : r B5
  r2 : r B5
  alt : r W1      -- bit 30 (SUB, SRA, SRAI)
  lui : r W1
  auipc : r W1
  jal : r W1
  jalr : r W1
  branch : r W1
  load : r W1
  store : r W1
  opimm : r W1
  op : r W1
  md : r W1       -- M: OP with funct7 = 1
  ecall : r W1
  ebreak : r W1
  fence : r W1
  legal : r W1
  immI : r B32
  immS : r B32
  immB : r B32
  immU : r B32
  immJ : r B32
  atm : r W1      -- A: opcode 0101111 (LR.W, SC.W, an AMO)
  lr : r W1
  sc : r W1
  amo : r W1      -- an AMO (not LR.W or SC.W)
  f5 : r B5       -- A: the operation
  csr : r W1      -- a CSR instruction (CSRRW/CSRRS/CSRRC and their immediates)
  csrAddr : r B12
  csrWrite : r W1 -- it writes the CSR (CSRRW, or rs1/zimm not zero)
  mret : r W1
  wfi : r W1
  c : r W1        -- a 16-bit (C) instruction: the PC advances by 2
  iw : r B32      -- the instruction word after expansion (`w` for a 32-bit one)

------------------------------------------------------------------------------------
-- The C extension, at the gate level
--
-- One expansion function, `Cx.expand`, called by `decode` and so shared by both cores
-- (the pipeline calls `decode` too: it has no second decode path). `Rv.expand` in
-- src/Rv/Isa.wiz is the same function on numbers; `tests/spec.wiz` checks all 65536
-- encodings agree. An illegal encoding expands to its own 16-bit word (zero-extended),
-- whose low bits are not 11, so `decode` marks it illegal and `tval` is the encoding.

def Cx.b {r : HwTy → Type} [Hw r] (i : Nat) (h : r B16) : r W1 := Hw.slice i 1 h
def Cx.rd {r : HwTy → Type} [Hw r] (h : r B16) : r B5 := Hw.slice 7 5 h
def Cx.rs2 {r : HwTy → Type} [Hw r] (h : r B16) : r B5 := Hw.slice 2 5 h
def Cx.shamt {r : HwTy → Type} [Hw r] (h : r B16) : r B5 := Hw.slice 2 5 h
-- 8 + bits[4:2] (x8 … x15)
def Cx.rdp {r : HwTy → Type} [Hw r] (h : r B16) : r B5 :=
  Hw.cat (Hw.lit 2 1) (Hw.slice 2 3 h)
-- 8 + bits[9:7]
def Cx.rs1p {r : HwTy → Type} [Hw r] (h : r B16) : r B5 :=
  Hw.cat (Hw.lit 2 1) (Hw.slice 7 3 h)

def Cx.I12 {r : HwTy → Type} [Hw r] (op f3 : Nat) (rd rs1 : r B5) (imm : r B12) : r B32 :=
  Hw.cat imm (Hw.cat rs1 (Hw.cat (Hw.lit 3 f3) (Hw.cat rd (Hw.lit 7 op))))
def Cx.S12 {r : HwTy → Type} [Hw r] (op f3 : Nat) (rs1 rs2 : r B5) (imm : r B12) : r B32 :=
  Hw.cat (Hw.slice 5 7 imm) (Hw.cat rs2 (Hw.cat rs1
    (Hw.cat (Hw.lit 3 f3) (Hw.cat (Hw.slice 0 5 imm) (Hw.lit 7 op)))))
def Cx.R {r : HwTy → Type} [Hw r] (op f3 f7 : Nat) (rd rs1 rs2 : r B5) : r B32 :=
  Hw.cat (Hw.lit 7 f7) (Hw.cat rs2 (Hw.cat rs1
    (Hw.cat (Hw.lit 3 f3) (Hw.cat rd (Hw.lit 7 op)))))
def Cx.U {r : HwTy → Type} [Hw r] (op : Nat) (rd : r B5) (imm : r B32) : r B32 :=
  Hw.cat (Hw.slice 12 20 imm) (Hw.cat rd (Hw.lit 7 op))
def Cx.B {r : HwTy → Type} [Hw r] (f3 : Nat) (rs1 rs2 : r B5) (imm : r B32) : r B32 :=
  Hw.cat (Hw.slice 12 1 imm) (Hw.cat (Hw.slice 5 6 imm) (Hw.cat rs2 (Hw.cat rs1
    (Hw.cat (Hw.lit 3 f3) (Hw.cat (Hw.slice 1 4 imm)
      (Hw.cat (Hw.slice 11 1 imm) (Hw.lit 7 Op.branch)))))))
def Cx.J {r : HwTy → Type} [Hw r] (rd : r B5) (imm : r B32) : r B32 :=
  Hw.cat (Hw.slice 20 1 imm) (Hw.cat (Hw.slice 1 10 imm) (Hw.cat (Hw.slice 11 1 imm)
    (Hw.cat (Hw.slice 12 8 imm) (Hw.cat rd (Hw.lit 7 Op.jal)))))

-- the halfwords' immediates as 12-bit I/S fields (zero-extended or sign-extended)
def Cx.shamt12 {r : HwTy → Type} [Hw r] (h : r B16) : r B12 :=
  Hw.cat (Hw.lit 7 0) (Cx.shamt h)
def Cx.shamtSra {r : HwTy → Type} [Hw r] (h : r B16) : r B12 :=
  Hw.cat (Hw.lit 7 32) (Cx.shamt h)
-- imm[5|4:0] sign-extended to 12
def Cx.imm6 {r : HwTy → Type} [Hw r] (h : r B16) : r B12 :=
  Hw.cat (rep 6 (Cx.b 12 h)) (Hw.cat (Cx.b 12 h) (Hw.slice 2 5 h))
-- C.ADDI4SPN nzuimm[9:6|5:4|3|2] (bits 11:0, low 2 zero)
def Cx.uimm10 {r : HwTy → Type} [Hw r] (h : r B16) : r B12 :=
  Hw.cat (Hw.lit 2 0) (Hw.cat (Hw.slice 7 4 h) (Hw.cat (Hw.slice 11 2 h)
    (Hw.cat (Cx.b 5 h) (Hw.cat (Cx.b 6 h) (Hw.lit 2 0)))))
-- C.LW / C.SW uimm[6|5:3|2]
def Cx.lwuimm {r : HwTy → Type} [Hw r] (h : r B16) : r B12 :=
  Hw.cat (Hw.lit 5 0) (Hw.cat (Cx.b 5 h) (Hw.cat (Hw.slice 10 3 h)
    (Hw.cat (Cx.b 6 h) (Hw.lit 2 0))))
-- C.LWSP uimm[7:6|5|4:2]
def Cx.lwspimm {r : HwTy → Type} [Hw r] (h : r B16) : r B12 :=
  Hw.cat (Hw.lit 4 0) (Hw.cat (Hw.slice 2 2 h) (Hw.cat (Cx.b 12 h)
    (Hw.cat (Hw.slice 4 3 h) (Hw.lit 2 0))))
-- C.SWSP uimm[7:6|5:2]
def Cx.swspimm {r : HwTy → Type} [Hw r] (h : r B16) : r B12 :=
  Hw.cat (Hw.lit 4 0) (Hw.cat (Hw.slice 7 2 h) (Hw.cat (Hw.slice 9 4 h) (Hw.lit 2 0)))
-- C.ADDI16SP nzimm[9|4|6|8:7|5], sign-extended to 12
def Cx.spoff {r : HwTy → Type} [Hw r] (h : r B16) : r B12 :=
  Hw.cat (rep 2 (Cx.b 12 h)) (Hw.cat (Cx.b 12 h) (Hw.cat (Cx.b 4 h)
    (Hw.cat (Cx.b 3 h) (Hw.cat (Cx.b 5 h) (Hw.cat (Cx.b 2 h)
      (Hw.cat (Cx.b 6 h) (Hw.lit 4 0)))))))
-- C.LUI imm[17|16:12], sign-extended with the low 12 bits zero
def Cx.luiimm {r : HwTy → Type} [Hw r] (h : r B16) : r B32 :=
  Hw.cat (rep 14 (Cx.b 12 h)) (Hw.cat (Cx.b 12 h) (Hw.cat (Hw.slice 2 5 h) (Hw.lit 12 0)))
-- C.J / C.JAL imm[11|4|9:8|10|6|7|3:1|5], sign-extended
def Cx.joff {r : HwTy → Type} [Hw r] (h : r B16) : r B32 :=
  Hw.cat (rep 20 (Cx.b 12 h)) (Hw.cat (Cx.b 12 h) (Hw.cat (Cx.b 8 h)
    (Hw.cat (Hw.slice 10 2 h) (Hw.cat (Cx.b 6 h) (Hw.cat (Cx.b 7 h)
      (Hw.cat (Cx.b 2 h) (Hw.cat (Cx.b 11 h)
        (Hw.cat (Hw.slice 3 3 h) (Hw.lit 1 0)))))))))
-- C.BEQZ / C.BNEZ imm[8|4:3|7:6|2:1|5], sign-extended
def Cx.boff {r : HwTy → Type} [Hw r] (h : r B16) : r B32 :=
  Hw.cat (rep 23 (Cx.b 12 h)) (Hw.cat (Cx.b 12 h) (Hw.cat (Cx.b 6 h)
    (Hw.cat (Cx.b 5 h) (Hw.cat (Cx.b 2 h) (Hw.cat (Cx.b 11 h)
      (Hw.cat (Cx.b 10 h) (Hw.cat (Cx.b 4 h)
        (Hw.cat (Cx.b 3 h) (Hw.lit 1 0)))))))))

def Cx.expand {r : HwTy → Type} [Hw r] (h : r B16) : r B32 :=
  let bad := Hw.cat (Hw.lit 16 0) h;
  let q := Hw.slice 0 2 h;
  let f3 := Hw.slice 13 3 h;
  let b12 := Cx.b 12 h;
  let rd := Cx.rd h; let rs2 := Cx.rs2 h;
  let rdp := Cx.rdp h; let rs1p := Cx.rs1p h;
  let imm6 := Cx.imm6 h; let sh := Cx.shamt h;
  -- Q0 (00): C.ADDI4SPN, C.LW, C.SW (the FP forms are illegal on this machine)
  let q0w := Hw.mux (isK f3 0)
      (Hw.mux (Hw.eq (Cx.uimm10 h) (Hw.lit 12 0)) bad
        (Cx.I12 Op.opimm 0 rdp (Hw.lit 5 2) (Cx.uimm10 h)))
    (Hw.mux (isK f3 2) (Cx.I12 Op.load 2 rdp rs1p (Cx.lwuimm h))
      (Hw.mux (isK f3 6) (Cx.S12 Op.store 2 rs1p rdp (Cx.lwuimm h)) bad));
  -- Q1 (01)
  let subw := Hw.mux (isK (Hw.slice 10 2 h) 0)
      (Hw.mux b12 bad (Cx.I12 Op.opimm 5 rs1p rs1p (Cx.shamt12 h)))
    (Hw.mux (isK (Hw.slice 10 2 h) 1)
      (Hw.mux b12 bad (Cx.I12 Op.opimm 5 rs1p rs1p (Cx.shamtSra h)))
      (Hw.mux (isK (Hw.slice 10 2 h) 2)
        (Cx.I12 Op.opimm 7 rs1p rs1p imm6)
        (Hw.mux b12 bad
          (Hw.mux (isK (Hw.slice 5 2 h) 0) (Cx.R Op.op 0 32 rs1p rs1p rdp)
          (Hw.mux (isK (Hw.slice 5 2 h) 1) (Cx.R Op.op 4 0 rs1p rs1p rdp)
          (Hw.mux (isK (Hw.slice 5 2 h) 2) (Cx.R Op.op 6 0 rs1p rs1p rdp)
            (Cx.R Op.op 7 0 rs1p rs1p rdp)))))));
  let q1w := Hw.mux (isK f3 0) (Cx.I12 Op.opimm 0 rd rd imm6)
    (Hw.mux (isK f3 1) (Cx.J (Hw.lit 5 1) (Cx.joff h))
      (Hw.mux (isK f3 2) (Cx.I12 Op.opimm 0 rd (Hw.lit 5 0) imm6)
        (Hw.mux (isK f3 3)
          (Hw.mux (isK rd 2)
            (Hw.mux (Hw.eq (Cx.spoff h) (Hw.lit 12 0)) bad
              (Cx.I12 Op.opimm 0 (Hw.lit 5 2) (Hw.lit 5 2) (Cx.spoff h)))
            (Hw.mux (isK rd 0) bad (Cx.U Op.lui rd (Cx.luiimm h))))
          (Hw.mux (isK f3 4) subw
            (Hw.mux (isK f3 5) (Cx.J (Hw.lit 5 0) (Cx.joff h))
              (Hw.mux (isK f3 6) (Cx.B 0 rs1p (Hw.lit 5 0) (Cx.boff h))
                (Cx.B 1 rs1p (Hw.lit 5 0) (Cx.boff h))))))));
  -- Q2 (10)
  let jrmv := Hw.mux (Hw.not b12)
      (Hw.mux (isK rs2 0)
        (Hw.mux (isK rd 0) bad (Cx.I12 Op.jalr 0 (Hw.lit 5 0) rd (Hw.lit 12 0)))
        (Cx.R Op.op 0 0 rd (Hw.lit 5 0) rs2))
      (Hw.mux (isK rd 0)
        (Hw.mux (isK rs2 0) (Hw.lit 32 1048691) bad)
        (Hw.mux (isK rs2 0) (Cx.I12 Op.jalr 0 (Hw.lit 5 1) rd (Hw.lit 12 0))
          (Cx.R Op.op 0 0 rd rd rs2)));
  let q2w := Hw.mux (isK f3 0)
      (Hw.mux b12 bad (Cx.I12 Op.opimm 1 rd rd (Cx.shamt12 h)))
    (Hw.mux (isK f3 2)
      (Hw.mux (isK rd 0) bad (Cx.I12 Op.load 2 rd (Hw.lit 5 2) (Cx.lwspimm h)))
      (Hw.mux (isK f3 4) jrmv
        (Hw.mux (isK f3 6) (Cx.S12 Op.store 2 (Hw.lit 5 2) rs2 (Cx.swspimm h)) bad)));
  Hw.mux (isK q 0) q0w (Hw.mux (isK q 1) q1w (Hw.mux (isK q 2) q2w bad))

def decode {r : HwTy → Type} [Hw r] (ab : Nat) (mx : Bool) (w : r B32) : Dec r :=
  let c : r W1 := Hw.not (isK (Hw.slice 0 2 w : r B2) 3);
  let we : r B32 := Hw.mux c (Cx.expand (Hw.slice 0 16 w : r B16)) w;
  let opc : r B7 := Hw.slice 0 7 we;
  let rd : r B5 := Hw.slice 7 5 we;
  let f3 : r B3 := Hw.slice 12 3 we;
  let r1 : r B5 := Hw.slice 15 5 we;
  let r2 : r B5 := Hw.slice 20 5 we;
  let f7 : r B7 := Hw.slice 25 7 we;
  let sgn := bitOf 31 we;
  let lui := isK opc Op.lui;
  let auipc := isK opc Op.auipc;
  let jal := isK opc Op.jal;
  let jalr := isK opc Op.jalr;
  let branch := isK opc Op.branch;
  let load := isK opc Op.load;
  let store := isK opc Op.store;
  let opimm := isK opc Op.opimm;
  let opRaw := isK opc Op.op;
  let f7one := isK (Hw.slice 25 7 we : r B7) 1;
  let op : r W1 := if mx then Hw.and opRaw (Hw.not f7one) else opRaw;
  let md : r W1 := if mx then Hw.and opRaw f7one else Hw.lit 1 0;
  let fence := isK opc Op.fence;
  let ecall := isK we 115;
  let ebreak := isK we 1048691;
  let okd := regOk ab rd;
  let ok1 := regOk ab r1;
  let ok2 := regOk ab r2;
  let f7z := isK f7 0;
  let f7a := isK f7 32;
  let f30 := Hw.or (isK f3 0) (isK f3 5);
  -- A: funct3 is the width (2 = .W), funct5 the operation
  let opA := isK opc Op.amo;
  let f5 : r B5 := Hw.slice 27 5 we;
  let lrA := Hw.and opA (Hw.and (isK f3 2) (isK f5 2));
  let scA := Hw.and opA (Hw.and (isK f3 2) (isK f5 3));
  let f5ok := Hw.or (Hw.ult f5 (Hw.lit 5 4)) (Hw.or (isK f5 4) (Hw.or (isK f5 8) (Hw.or (isK f5 12)
    (Hw.or (isK f5 16) (Hw.or (isK f5 20) (Hw.or (isK f5 24) (isK f5 28)))))));
  let amoA := Hw.and opA (Hw.and (isK f3 2) (Hw.and f5ok (Hw.not (Hw.or lrA scA))));
  -- LR.W has no rs2 (it must be x0); SC.W and the AMOs read it
  let aLeg := Hw.and opA (Hw.and (isK f3 2) (Hw.and f5ok
    (Hw.and okd (Hw.and ok1 (Hw.mux (isK f5 2) (isK r2 0) ok2)))));
  -- CSR and the two privileged instructions (mtvec is checked for existence below)
  let sysOp := isK opc Op.system;
  let csrAddr : r B12 := Hw.slice 20 12 we;
  let csrKind := Hw.and sysOp (Hw.or (Hw.or (isK f3 1) (isK f3 2)) (Hw.or (isK f3 3)
    (Hw.or (isK f3 5) (Hw.or (isK f3 6) (isK f3 7)))));
  let csrWrite := Hw.or (isK f3 1) (Hw.not (isK r1 0));
  let csrLegal := Hw.and csrKind (Hw.and (coreCsrExists csrAddr)
    (Hw.or (Hw.not csrWrite) (coreCsrWritable csrAddr)));
  let mret := isK we 807403635;
  let wfi := isK we 273678451;
  let legal := Hw.or (Hw.or (Hw.and (Hw.or (Hw.or lui auipc) jal) okd)
      (Hw.or (Hw.and jalr (Hw.and (isK f3 0) (Hw.and okd ok1)))
        (Hw.and branch (Hw.and (Hw.not (isK (Hw.slice 1 2 f3 : r B2) 1)) (Hw.and ok1 ok2)))))
    (Hw.or (Hw.or (Hw.and load (Hw.and (Hw.or (Hw.ult f3 (Hw.lit 3 3)) (Hw.or (isK f3 4) (isK f3 5))) (Hw.and okd ok1)))
        (Hw.and store (Hw.and (Hw.ult f3 (Hw.lit 3 3)) (Hw.and ok1 ok2))))
      (Hw.or (Hw.or (Hw.and opimm (Hw.and okd (Hw.and ok1
            (Hw.mux (isK f3 1) f7z (Hw.mux (isK f3 5) (Hw.or f7z f7a) (Hw.lit 1 1))))))
          (Hw.and op (Hw.and (Hw.and okd (Hw.and ok1 ok2)) (Hw.or f7z (Hw.and f7a f30)))))
        (Hw.or (Hw.or fence (Hw.or ecall (Hw.or ebreak (Hw.or aLeg (Hw.or csrLegal (Hw.or mret wfi))))))
          (Hw.and md (Hw.and okd (Hw.and ok1 ok2))))));
  let immI : r B32 := Hw.cat (rep 20 sgn) (Hw.slice 20 12 we : r B12);
  let immS : r B32 := Hw.cat (rep 20 sgn) (Hw.cat (Hw.slice 25 7 we : r B7) (Hw.slice 7 5 we : r B5));
  let immB : r B32 := Hw.cat (rep 20 sgn) (Hw.cat (bitOf 7 we) (Hw.cat (Hw.slice 25 6 we : r (HwTy.bits 6))
      (Hw.cat (Hw.slice 8 4 we : r (HwTy.bits 4)) (Hw.lit 1 0))));
  let immU : r B32 := Hw.cat (Hw.slice 12 20 we : r B20) (Hw.lit 12 0);
  let immJ : r B32 := Hw.cat (rep 12 sgn) (Hw.cat (Hw.slice 12 8 we : r W8) (Hw.cat (bitOf 20 we)
      (Hw.cat (Hw.slice 21 10 we : r (HwTy.bits 10)) (Hw.lit 1 0))));
  Dec.mk rd f3 r1 r2 (bitOf 30 we) lui auipc jal jalr branch load store opimm op md ecall ebreak fence legal
    immI immS immB immU immJ opA lrA scA amoA f5 csrLegal csrAddr csrWrite mret wfi c we

------------------------------------------------------------------------------------
-- One cycle

-- `cache` enables the private L1. With `cache = false` every DDR access is one word
-- on the bus (no tag, no line fill) and the L1's memories are never written, so yosys
-- removes them: the hart is then 4 RAMB36 (16 KB of local RAM) instead of 8.
def coreStepHC {r : HwTy → Type} [Hw r] (hart ab wb : Nat) (mx cache : Bool) (s : CoreSt ab wb r) (x : In r) :
    r (HwTy.prod (CoreSt.code ab wb) Out.code) :=
  let ph := s.ph;
  let inF := isK ph Ph.f;
  let inD := isK ph Ph.d;
  let inE := isK ph Ph.e;
  let inM := isK ph Ph.m;
  let inS := isK ph Ph.s;
  let inX : r W1 := if mx then isK ph Ph.x else Hw.lit 1 0;
  let inV : r W1 := if mx then isK ph Ph.v else Hw.lit 1 0;
  let inP := isK ph Ph.p;
  let inQ := isK ph Ph.q;
  let inW := isK ph Ph.w;
  let inA := isK ph Ph.a;
  let inJ := isK ph Ph.j;
  -- the L1: a hit is the tag read with the line equal to the address's. An uncached
  -- address (the shared aperture, or any DDR address when `cache` is false) never hits.
  let lb := L1.bits wb;
  let l1idx := fun (a : r B32) => (Hw.slice 4 lb a : r (HwTy.bits lb));
  let l1tagOf := fun (a : r B32) => (Hw.cat (Hw.lit 1 1) (Hw.slice (4 + lb) (24 - lb) a : r (HwTy.bits (24 - lb))) : r (HwTy.bits (L1.tagW wb)));
  let cached := if cache then Hw.not (Core.isUncached s.ra) else Hw.lit 1 0;
  let hit := Hw.and cached (Hw.eq s.l1t (l1tagOf s.ra));
  let l1w : r B32 := Hw.mux (bitOf 3 s.ra) (Hw.mux (bitOf 2 s.ra) (Hw.slice 96 32 s.l1q) (Hw.slice 64 32 s.l1q))
    (Hw.mux (bitOf 2 s.ra) (Hw.slice 32 32 s.l1q) (Hw.slice 0 32 s.l1q));
  let miss := gate (Hw.or inD (Hw.or inM inJ)) (gate s.fromL1 (Hw.not hit));
  -- the word read: from block RAM (the q lanes), the L1, or the bus
  let w : r B32 := Hw.mux s.fromL1 l1w (Hw.mux s.fromBus s.busq (Hw.cat s.q3 (Hw.cat s.q2 (Hw.cat s.q1 s.q0))));
  -- C: the instruction as the decoder sees it. A 16-bit instruction is the halfword
  -- selected by pc[1]; a 32-bit instruction at pc[1] = 1 is the two words `j` fetched.
  let win : r B32 := Hw.mux s.half s.ins
    (Hw.mux s.al (Hw.cat (Hw.lit 16 0) (Hw.slice 16 16 w : r B16)) w);
  -- C: a 32-bit instruction at an odd halfword: its second word is at pc + 2
  -- (`gate`, not `Hw.and`: with `al` known to be 0 this is 0 whatever the word, so the
  -- next phase and read address of a symbolic instruction still reduce; FINDINGS H2)
  let need2 : r W1 := gate (Hw.not s.half)
    (gate s.al (isK (Hw.slice 16 2 w : r B2) 3));
  let wq0 : r W8 := Hw.slice 0 8 w;
  let wq1 : r W8 := Hw.slice 8 8 w;
  let wq2 : r W8 := Hw.slice 16 8 w;
  let wq3 : r W8 := Hw.slice 24 8 w;
  let ω d := decode ab mx win;
  let a := s.x1;
  let rs2v := s.x2;
  let regB := Hw.or d.op d.branch;
  -- an atomic's address is rs1 (it has no immediate)
  let b := Hw.mux d.atm (Hw.lit 32 0) (Hw.mux regB rs2v (Hw.mux d.store d.immS d.immI));
  let arith := Hw.or d.op d.opimm;
  let cmpOp := Hw.and arith (Hw.or (isK d.f3 2) (isK d.f3 3));
  let sub := Hw.or d.branch (Hw.or cmpOp (Hw.and d.op (Hw.and d.alt (isK d.f3 0))));
  -- a + b, or a - b as a + ~b + 1 (the carry in through a low bit), with the carry out
  let s34 : r B34 := Hw.add (Hw.cat (Hw.lit 1 0) (Hw.cat a (Hw.lit 1 1)))
    (Hw.cat (Hw.lit 1 0) (Hw.cat (Hw.mux sub (Hw.not b) b) sub));
  let sum : r B32 := Hw.slice 1 32 s34;
  -- Atomic placement. A private-cached DDR line cannot support LR/SC or an AMO until
  -- there is coherence (another hart's store can make the private copy stale), so an
  -- atomic to one is illegal. The shared aperture is uncached and goes to the bus's
  -- single serialisation point; the on-chip RAM is per hart, so a local atomic is
  -- trivially correct. I/O (bit 31) is illegal.
  let ddrA := Hw.and (bitOf 30 sum) (Hw.not (bitOf 31 sum));
  let sharedA := gate d.atm (Hw.and ddrA (Core.isUncached sum));
  let localA := gate d.atm (Hw.not ddrA);
  let badA := gate d.atm (Hw.or (bitOf 31 sum) (Hw.and ddrA (Hw.not (Core.isUncached sum))));
  let ult := Hw.not (bitOf 33 s34);
  let slt := Hw.mux (Hw.xor (bitOf 31 a) (bitOf 31 b)) (bitOf 31 a) (bitOf 31 sum);
  let eq := Hw.eq a b;
  let taken := Hw.xor (Hw.mux (bitOf 2 d.f3) (Hw.mux (bitOf 1 d.f3) ult slt) eq) (bitOf 0 d.f3);
  let f3 := d.f3;
  -- shifts in one cycle (a barrel shifter; the S phase is no longer used).
  -- SRA is the complement form the specification uses (`ashr x k = ~(~x >> k)` for a
  -- negative `x`): the barrel always shifts right with a zero fill, and the result is
  -- complemented when the sign is set. The old ones-fill (`2^w - 1` in the top `k`
  -- bits) was correct but its proof had to relate the fill to the logical shift by
  -- arithmetic on a full-width constant (`Bits.sub_one_high` at w = 32), whose
  -- `Nat.add_sub_of_le` recurses over `2^31`; the complement form needs only the
  -- definitional `IntN.shiftRight` branches and the logical shift's stage chain.
  let shamt : r B5 := Hw.slice 0 5 b;
  let isSra : r W1 := Hw.and (isK f3 5) d.alt;
  let sraNeg : r W1 := gate isSra (bitOf 31 a);
  let shIn : r B32 := Hw.mux sraNeg (Hw.not a) a;
  let shOut : r B32 := barrel (isK f3 1) (Hw.lit 1 0) shamt shIn;
  let shRes : r B32 := Hw.mux sraNeg (Hw.not shOut) shOut;
  let aluRes := Hw.mux (isK f3 0) sum (Hw.mux (isK f3 2) (zext32 slt) (Hw.mux (isK f3 3) (zext32 ult)
    (Hw.mux (isK f3 4) (Hw.xor a b) (Hw.mux (isK f3 6) (Hw.or a b) (Hw.mux (isK f3 7) (Hw.and a b) shRes)))));
  let shift := Hw.lit 1 0;
  -- the next PC (2 bytes on for a 16-bit instruction)
  let pcInc := Hw.add s.pc (Hw.mux d.c (Hw.lit 32 2) (Hw.lit 32 4));
  let pcImm := Hw.add s.pc (Hw.mux d.jal d.immJ (Hw.mux d.branch d.immB d.immU));
  let jalrT : r B32 := Hw.cat (Hw.slice 1 31 sum : r (HwTy.bits 31)) (Hw.lit 1 0);
  let jump := Hw.mux (Hw.or d.jal d.jalr) (Hw.lit 1 1) (gate d.branch taken);
  let target := Hw.mux d.jalr jalrT pcImm;
  let npc := Hw.mux jump target pcInc;
  -- CSRs: read the addressed register, and the new value a CSR instruction writes
  let mip := In.mip x;
  let csrOld := coreCsrRead hart s.csr s.tval mip d.csrAddr;
  let csrSrc := Hw.mux (Hw.or (isK d.f3 1) (Hw.or (isK d.f3 2) (isK d.f3 3)))
    a (Hw.cat (Hw.lit 27 0) d.r1);
  let csrNew := Hw.mux (Hw.or (isK d.f3 1) (isK d.f3 5)) csrSrc
    (Hw.mux (Hw.or (isK d.f3 2) (isK d.f3 6)) (Hw.or csrOld csrSrc)
      (Hw.and csrOld (Hw.not csrSrc)));
  -- traps
  let lo2 : r B2 := Hw.slice 0 2 sum;
  let mis := Hw.mux (isK (Hw.slice 0 2 f3 : r B2) 2) (Hw.not (isK lo2 0))
    (Hw.mux (isK (Hw.slice 0 2 f3 : r B2) 1) (bitOf 0 sum) (Hw.lit 1 0));
  let misJ := gate jump (bitOf 0 target);
  let misL := gate d.load mis;
  let misS := gate d.store mis;
  let misA := gate d.atm mis;
  let code : r B3 := Hw.mux (Hw.not d.legal) (Hw.lit 3 Trap.illegal) (Hw.mux d.ecall (Hw.lit 3 Trap.ecall)
    (Hw.mux d.ebreak (Hw.lit 3 Trap.ebreak) (Hw.mux badA (Hw.lit 3 Trap.illegal)
    (Hw.mux misJ (Hw.lit 3 Trap.jump)
    (Hw.mux (Hw.or misL (Hw.and misA d.lr)) (Hw.lit 3 Trap.load)
    (Hw.mux (Hw.or misS (Hw.and misA (Hw.not d.lr))) (Hw.lit 3 Trap.store) (Hw.lit 3 0)))))));
  -- what a trap records (mtval): the instruction word for an illegal instruction (an
  -- atomic to an address it may not use included), the
  -- target for a misaligned jump, the effective address for a misaligned access, 0 for
  -- ECALL/EBREAK. A C encoding is recorded as its 16 bits. The PC is not written on a
  -- trap, so it is the epc as it stands.
  let tvalI : r B32 := Hw.mux d.c (Hw.cat (Hw.lit 16 0) (Hw.slice 0 16 win : r B16)) win;
  let tvalE : r B32 := Hw.mux (Hw.or (Hw.not d.legal) badA) tvalI
    (Hw.mux d.ecall (Hw.lit 32 0) (Hw.mux d.ebreak (Hw.lit 32 0)
    (Hw.mux misJ target (Hw.mux (Hw.or misL (Hw.and misA d.lr)) sum
    (Hw.mux (Hw.or misS (Hw.and misA (Hw.not d.lr))) sum (Hw.lit 32 0))))));
  -- (the trap controls are `gate`s: with inE known to be 0 they are 0 without the
  -- trap code, which in the decode cycle depends on leftover latches; FINDINGS H13)
  let trapE := gate inE (Hw.not (isK code 0));
  -- an interrupt is taken between instructions, in E before the instruction there:
  -- MIE and a pending enabled bit. It always goes to the vector (a zero mtvec
  -- included); only an exception halts while mtvec is 0 (docs/csr.md). A WFI is not
  -- interrupted: it waits in E until `mip & mie` is not zero, completes, and the
  -- interrupt is taken on the next instruction (as `Rv.step`).
  let handled := Hw.not (isK s.csr.mtvec 0);
  let irqOn := Hw.and mip s.csr.mie;
  let irqCode := coreIrqCode irqOn;
  let intr := gate inE (gate (Hw.not d.wfi)
    (gate (bitOf Csr.mieBit s.csr.mstatus) (Hw.not (isK irqOn 0))));
  let takeTrap := Hw.or trapE intr;
  let stopTrap := gate trapE (Hw.not handled);
  let enterTrap := gate takeTrap (Hw.not stopTrap);
  -- a store to the output port waits in E while the output is busy; a WFI while no
  -- enabled interrupt is pending
  let io := bitOf 31 sum;
  let wait := Hw.or (gate (gate d.store io) (Hw.not x.txReady)) (gate d.wfi (isK irqOn 0));
  let goE := gate inE (gate (isK code 0) (gate (Hw.not intr) (Hw.not wait)));
  let retireM := Hw.and d.mret goE;
  let csrWe := Hw.and d.csr (Hw.and goE d.csrWrite);
  let csrW := coreCsrWarl d.csrAddr csrNew;
  -- `mcause`: an interrupt has bit 31 set; an exception the standard code
  let intCause : r B32 := Hw.or (Hw.lit 32 Csr.intrBit) (Hw.cat (Hw.lit 28 0) irqCode);
  let trapCauseV := Hw.mux intr intCause (coreTrapMcause code);
  -- trap entry and mret update mstatus (MIE, MPIE, MPP = M); a halt (`stopTrap`)
  -- leaves it, as `Rv.stop` does, and records mepc/mcause/mtval
  let msN := Hw.mux enterTrap (coreTrapMstatus s.csr.mstatus) (Hw.mux retireM (coreRetMstatus s.csr.mstatus)
    (Hw.mux (Hw.and csrWe (isK d.csrAddr Csr.aMstatus)) csrW s.csr.mstatus));
  let mieN := Hw.mux (Hw.and csrWe (isK d.csrAddr Csr.aMie)) csrW s.csr.mie;
  let mtvecN := Hw.mux (Hw.and csrWe (isK d.csrAddr Csr.aMtvec)) csrW s.csr.mtvec;
  let mscratchN := Hw.mux (Hw.and csrWe (isK d.csrAddr Csr.aMscratch)) csrW s.csr.mscratch;
  let mepcN := Hw.mux takeTrap s.pc
    (Hw.mux (Hw.and csrWe (isK d.csrAddr Csr.aMepc)) csrW s.csr.mepc);
  let mcauseN := Hw.mux takeTrap trapCauseV
    (Hw.mux (Hw.and csrWe (isK d.csrAddr Csr.aMcause)) csrW s.csr.mcause);
  let tvalN := Hw.mux intr (Hw.lit 32 0)
    (Hw.mux trapE tvalE (Hw.mux (Hw.and csrWe (isK d.csrAddr Csr.aMtval)) csrW s.tval));
  let pcN := Hw.mux enterTrap (coreVector s.csr.mtvec intr irqCode)
    (Hw.mux retireM s.csr.mepc (Hw.mux goE npc s.pc));
  -- a private-memory SC.W succeeds iff the reservation is for this word; its store
  -- happens in E. A shared SC.W is decided by the bus, and its success bit comes back
  -- as the load value.
  let scOk := Hw.and s.resOk (sameWord wb s.resv sum);
  let scVal := Hw.mux scOk (Hw.lit 32 0) (Hw.lit 32 1);
  let scE := gate goE d.sc;
  -- the private-memory SC writes in E and returns its success bit there; a shared SC's
  -- decision and success bit come back from the bus in M
  let scLocal := gate scE (Hw.not ddrA);
  let scWr := gate scLocal scOk;
  let ddrS := Hw.and (bitOf 30 sum) (Hw.not io);
  -- register writes: in E (everything but loads and shifts), M (loads and an AMO's
  -- old word), S (shifts)
  let rdNZ := Hw.not (isK d.rd 0);
  let wE := gate goE (gate rdNZ (Hw.or (Hw.or (Hw.or d.lui d.auipc) (Hw.or d.jal d.jalr))
    (Hw.or (Hw.or (Hw.and arith (Hw.not shift)) scLocal) (Hw.or d.csr d.mret))));
  let resE := Hw.mux d.lui d.immU (Hw.mux d.auipc pcImm (Hw.mux (Hw.or d.jal d.jalr) pcInc
    (Hw.mux scLocal scVal (Hw.mux d.csr csrOld aluRes))));
  -- the loaded value
  let slo := s.slo;
  let byte := Hw.mux (bitOf 1 slo) (Hw.mux (bitOf 0 slo) wq3 wq2) (Hw.mux (bitOf 0 slo) wq1 wq0);
  let half : r B16 := Hw.mux (bitOf 1 slo) (Hw.cat wq3 wq2) (Hw.cat wq1 wq0);
  let sx := Hw.not (bitOf 2 s.sf3);
  let ldm := Hw.mux (bitOf 1 s.sf3) w (Hw.mux (bitOf 0 s.sf3)
    (Hw.cat (rep 16 (Hw.and sx (bitOf 15 half))) half) (Hw.cat (rep 24 (Hw.and sx (bitOf 7 byte))) byte));
  let ldv := Hw.mux s.sio s.acc ldm;
  let sNZ := Hw.not (isK s.srd 0);
  let sDone := isK s.cnt 0;
  let wM := gate inM (gate (Hw.not miss) sNZ);
  let wS := gate inS (Hw.and sDone sNZ);
  -- M: the operands' signs and magnitudes (E), the product (X), a division step (V)
  let signed := Hw.not (bitOf 0 f3);
  let negA := Hw.and signed (bitOf 31 a);
  let negB := Hw.and signed (bitOf 31 rs2v);
  let absA := Hw.mux negA (Hw.sub (Hw.lit 32 0) a) a;
  let absB := Hw.mux negB (Hw.sub (Hw.lit 32 0) rs2v) rs2v;
  let negQ := Hw.and (Hw.xor negA negB) (Hw.not (isK rs2v 0));
  let sA := Hw.and (Hw.or (isK s.sf3 1) (isK s.sf3 2)) (bitOf 31 s.x1);
  let sB := Hw.and (isK s.sf3 1) (bitOf 31 s.x2);
  let prod : r (HwTy.bits 64) := Hw.mul (Hw.cat (rep 32 sA) s.x1) (Hw.cat (rep 32 sB) s.x2);
  let mres : r B32 := Hw.mux (isK s.sf3 0) (Hw.slice 0 32 prod) (Hw.slice 32 32 prod);
  let rm2 : r B32 := Hw.cat (Hw.slice 0 31 s.rm : r (HwTy.bits 31)) (bitOf 31 s.acc);
  let ge := Hw.not (Hw.ult rm2 s.dv);
  let rmN := Hw.mux ge (Hw.sub rm2 s.dv) rm2;
  let accN : r B32 := Hw.cat (Hw.slice 0 31 s.acc : r (HwTy.bits 31)) ge;
  let dres := Hw.mux (bitOf 1 s.sf3) (Hw.mux (bitOf 1 s.slo) (Hw.sub (Hw.lit 32 0) rmN) rmN)
    (Hw.mux (bitOf 0 s.slo) (Hw.sub (Hw.lit 32 0) accN) accN);
  let wX := gate inX sNZ;
  let wV := gate inV (Hw.and sDone sNZ);
  let we := Hw.or (Hw.or wE (Hw.or wM wS)) (Hw.or wX wV);
  let wa := Hw.mux inE (regIx ab d.rd) (regIx ab s.srd);
  let wd := Hw.mux inE resE (Hw.mux inM ldv (Hw.mux inX mres (Hw.mux inV dres s.acc)));
  -- the shifter: left (funct3 1), right logical or arithmetic (bit 30)
  let left := isK s.sf3 1;
  let sh := Hw.mux left (Hw.cat (Hw.slice 0 31 s.acc : r (HwTy.bits 31)) (Hw.lit 1 0))
    (Hw.cat (Hw.and (bitOf 0 slo) (bitOf 31 s.acc)) (Hw.slice 1 31 s.acc : r (HwTy.bits 31)));
  -- memory: stores in E (not to I/O, not to DDR), byte lanes
  let st := gate goE (gate d.store (Hw.and (Hw.not io) (Hw.not ddrS)));
  let sb := isK f3 0;
  let sh16 := isK f3 1;
  let laneOn := fun (l : Nat) => Hw.mux sb (isK lo2 l) (Hw.mux sh16 (isK (bitOf 1 sum) (Nat.div l 2)) (Hw.lit 1 1));
  let lane := fun (l : Nat) => gate st (laneOn l);
  let d0 : r W8 := Hw.slice 0 8 rs2v;
  let d1 : r W8 := Hw.mux sb d0 (Hw.slice 8 8 rs2v);
  let d2 : r W8 := Hw.mux (isK f3 2) (Hw.slice 16 8 rs2v) d0;
  let d3 : r W8 := Hw.mux sb d0 (Hw.mux sh16 d1 (Hw.slice 24 8 rs2v));
  -- A local AMO writes the old word + rs2 in A; a local SC.W writes its rs2 in E.
  -- Both are whole words.
  let amwr := gate inA (gate (isK s.ak 2) (Hw.not ddrA));
  let amoNew := amoVal s.sf5 s.amoO s.amoD;
  let wLane := fun (l : Nat) => Hw.or (lane l) (Hw.or scWr amwr);
  let wByte := fun (l : Nat) =>
    Hw.mux amwr (Hw.slice (8 * l) 8 amoNew) (Hw.mux scWr (Hw.slice (8 * l) 8 rs2v)
      (if Nat.beq l 0 then d0 else if Nat.beq l 1 then d1 else if Nat.beq l 2 then d2 else d3));
  -- the memory read: the load's or atomic's address, else the next instruction's
  -- (one address for reading and writing, so that each lane is a single-port RAM: a
  -- store's read is not used, the next cycle fetches again)
  let raddr := Hw.mux inQ s.rline (Hw.mux (gate goE (Hw.or (Hw.or d.load d.store) d.atm)) sum
    (Hw.mux goE npc (Hw.mux (Hw.or (gate inD need2) inJ) (Hw.add s.pc (Hw.lit 32 2)) s.pc)));
  -- in A the memory and the L1 are addressed by the private atomic's address
  let laddr : r B32 := Hw.mux inA s.amoA raddr;
  let rix : r (HwTy.bits wb) := Hw.slice 2 wb laddr;
  let eNext : r B4 := Hw.mux enterTrap (Hw.lit 4 Ph.f) (Hw.mux stopTrap (Hw.lit 4 Ph.h)
    (Hw.mux d.mret (Hw.lit 4 Ph.f) (Hw.mux wait (Hw.lit 4 Ph.e) (Hw.mux d.fence (Hw.lit 4 Ph.w)
    (Hw.mux d.atm (Hw.mux d.sc (Hw.lit 4 Ph.f) (Hw.lit 4 Ph.m))
    (Hw.mux d.md (Hw.mux (bitOf 2 f3) (Hw.lit 4 Ph.v) (Hw.lit 4 Ph.x)) (Hw.mux d.load (Hw.lit 4 Ph.m) (Hw.mux shift (Hw.lit 4 Ph.s)
    (Hw.mux d.store (Hw.lit 4 Ph.f) (Hw.lit 4 Ph.d))))))))));
  let nphB : r B4 := Hw.mux inF (Hw.lit 4 Ph.d) (Hw.mux inD (Hw.mux need2 (Hw.lit 4 Ph.j) (Hw.lit 4 Ph.e))
    (Hw.mux inE eNext
    (Hw.mux inM (Hw.mux (isK s.ak 2) (Hw.lit 4 Ph.a) (Hw.lit 4 Ph.d))
    (Hw.mux inS (Hw.mux sDone (Hw.lit 4 Ph.d) (Hw.lit 4 Ph.s))
    (Hw.mux inX (Hw.lit 4 Ph.d) (Hw.mux inV (Hw.mux sDone (Hw.lit 4 Ph.d) (Hw.lit 4 Ph.v))
    (Hw.mux inA (Hw.lit 4 Ph.f) (Hw.mux inW (Hw.lit 4 Ph.d) (Hw.mux inJ (Hw.lit 4 Ph.d) ph)))))))));
  -- DDR (bit 30 set, bit 31 clear): a fetch or load reads the L1 (a miss in D or M fills
  -- the line over the bus, word by word, then reads it again: P, Q); a store goes to the
  -- bus (write-through) and updates the line if it is present
  let ddrR := Hw.and (bitOf 30 raddr) (Hw.not (bitOf 31 raddr));
  let readNext := Hw.or (isK nphB Ph.d) (Hw.or (isK nphB Ph.m) (isK nphB Ph.j));
  let busRd := Hw.lit 1 0;
  let busWr := gate goE (gate d.store ddrS);
  let busWrA := gate goE sharedA;
  let enterP := Hw.or (Hw.or miss busWr) busWrA;
  -- a shared atomic waits for `rvalid` (its old word or SC's success bit), not `ready`
  let bweN : r W1 := Hw.mux enterP (Hw.mux miss (Hw.lit 1 0) (Hw.mux busWr (Hw.lit 1 1) (Hw.lit 1 0))) s.bwe;
  -- (not in the gap: an answer the board still shows from the word before)
  let fillWord := gate inP (gate s.rmode (gate (Hw.not s.rgap) x.rvalid));
  let fillDone := gate fillWord (isK s.rk 3);
  let done := Hw.mux s.rmode fillDone (Hw.mux s.bwe x.ready x.rvalid);
  -- a one-word bus read (an uncached address, or a hart with the L1 off) leaves P
  -- after its answer; the L1 word it was reading is stale, so clear `fromL1`
  let wordP := gate inP (gate (Hw.not s.rmode) done);
  let nph : r B4 := Hw.mux inP (Hw.mux done (Hw.mux s.rmode (Hw.lit 4 Ph.q) s.bret) ph)
    (Hw.mux inQ s.bret (Hw.mux enterP (Hw.lit 4 Ph.p) nphB));
  -- the L1's writes: a filled line (and its tag), or a store's bytes into a present line
  let rk := s.rk;
  let fillLine : r B128 := Hw.cat (Hw.mux (isK rk 3) x.rdata (Hw.slice 96 32 s.rbuf : r B32))
    (Hw.cat (Hw.mux (isK rk 2) x.rdata (Hw.slice 64 32 s.rbuf : r B32))
    (Hw.cat (Hw.mux (isK rk 1) x.rdata (Hw.slice 32 32 s.rbuf : r B32)) (Hw.mux (isK rk 0) x.rdata (Hw.slice 0 32 s.rbuf : r B32))));
  let storeHit := gate inP (gate s.bnew (gate s.bwe hit));
  let sbyte := fun (j : Nat) => (Hw.mux (Hw.and (isK (Hw.slice 2 2 s.ra : r B2) (Nat.div j 4)) (bitOf (Nat.mod j 4) s.bst))
    (Hw.slice (8 * Nat.mod j 4) 8 s.bwd) (Hw.slice (8 * j) 8 s.l1q) : r W8);
  let w4 := fun (k : Nat) => (Hw.cat (sbyte (4 * k + 3)) (Hw.cat (sbyte (4 * k + 2)) (Hw.cat (sbyte (4 * k + 1)) (sbyte (4 * k)))) : r B32);
  let stLine : r B128 := Hw.cat (w4 3) (Hw.cat (w4 2) (Hw.cat (w4 1) (w4 0)));
  let l1wIdx := Hw.mux fillDone (l1idx s.rline) (l1idx s.ra);
  -- The private-memory reservation: LR sets it in M, a local SC clears it in E, and a
  -- local store or AMO to the word clears it. The shared aperture's reservation lives
  -- in the bus (`GBus.Atom`), where every hart's store can invalidate it.
  let lrSet := gate inM (gate (isK s.ak 1) (Hw.not miss));
  let scE := gate goE d.sc;
  let stClr := Hw.or (gate (gate goE (gate d.store (Hw.not io))) (sameWord wb sum s.resv))
    (Hw.or scE (gate inA (sameWord wb s.amoA s.resv)));
  let resOkN := Hw.mux stClr (Hw.lit 1 0) (Hw.mux lrSet (Hw.lit 1 1) s.resOk);
  let resvN := Hw.mux lrSet s.amoA s.resv;
  let opN : r B2 := Hw.mux d.lr (Hw.lit 2 1) (Hw.mux d.sc (Hw.lit 2 2) (Hw.mux d.amo (Hw.lit 2 3) (Hw.lit 2 0)));
  let akN : r B2 := Hw.mux inE (Hw.mux d.atm (Hw.mux sharedA (Hw.lit 2 3)
      (Hw.mux d.lr (Hw.lit 2 1) (Hw.mux d.amo (Hw.lit 2 2) (Hw.lit 2 0)))) s.ak)
    (Hw.mux inA (Hw.lit 2 0) s.ak);
  let baopN : r B2 := Hw.mux inE (Hw.mux sharedA opN (Hw.lit 2 0)) s.baop;
  let baf5N : r B5 := Hw.mux inE d.f5 s.baf5;
  let rfa := Hw.memWrite s.rfa we wa wd;
  let rfb := Hw.memWrite s.rfb we wa wd;
  let storeWord : r B32 := Hw.cat d3 (Hw.cat d2 (Hw.cat d1 d0));
  Hw.pair
    (CoreSt.pack ab wb (CoreSt.mk nph
      pcN
      (Hw.memRead s.m0 rix) (Hw.memRead s.m1 rix) (Hw.memRead s.m2 rix) (Hw.memRead s.m3 rix)
      (Hw.memWrite s.m0 (wLane 0) rix (wByte 0)) (Hw.memWrite s.m1 (wLane 1) rix (wByte 1))
      (Hw.memWrite s.m2 (wLane 2) rix (wByte 2)) (Hw.memWrite s.m3 (wLane 3) rix (wByte 3))
      rfa rfb
      (Hw.memRead s.rfa (regIx ab d.r1)) (Hw.memRead s.rfb (regIx ab d.r2))
      (Hw.mux inE (Hw.mux (gate d.load io) x.ioIn (Hw.mux d.md absA a)) (Hw.mux inS sh (Hw.mux inV accN s.acc)))
      (Hw.mux inE absB s.dv)
      (Hw.mux inE (Hw.lit 32 0) (Hw.mux inV rmN s.rm))
      (Hw.mux inE (Hw.mux d.md (Hw.lit 5 31) (Hw.slice 0 5 b)) (Hw.mux (Hw.or inS inV) (Hw.sub s.cnt (Hw.lit 5 1)) s.cnt))
      (Hw.mux inE d.rd s.srd)
      (Hw.mux inE (Hw.mux d.atm (Hw.lit 3 2) f3) s.sf3)
      (Hw.mux inE (Hw.mux d.atm (Hw.lit 2 0) (Hw.mux d.md (Hw.cat negA negQ) (Hw.mux d.load lo2 (Hw.cat (Hw.lit 1 0) d.alt)))) s.slo)
      (Hw.mux inE (gate d.load io) s.sio)
      (Hw.mux stopTrap code s.trap)
      tvalN
      (Hw.mux (gate inP x.rvalid) x.rdata s.busq)
      (Hw.mux (gate inP (gate (Hw.not s.bwe) x.rvalid)) (Hw.lit 1 1)
        (Hw.mux (Hw.and (Hw.not inP) (gate readNext (Hw.not ddrR))) (Hw.lit 1 0) s.fromBus))
      (Hw.mux enterP (Hw.mux (Hw.or busWr busWrA) sum raddr) s.badr)
      bweN
      (Hw.mux enterP (Hw.mux busWr storeWord (Hw.mux busWrA rs2v storeWord)) s.bwd)
      (Hw.mux enterP (Hw.mux busWrA (Hw.lit 4 15)
        (Hw.cat (laneOn 3) (Hw.cat (laneOn 2) (Hw.cat (laneOn 1) (laneOn 0))))) s.bst)
      (Hw.mux enterP (Hw.mux busWrA (Hw.lit 4 Ph.m) (Hw.mux miss ph (Hw.mux busWr (Hw.lit 4 Ph.f) nphB))) s.bret)
      (Hw.mux inP (Hw.mux (Hw.or fillWord s.rgap) (Hw.lit 1 0) (Hw.or s.bsent x.ready)) (Hw.lit 1 0))
      (Hw.mux inQ s.rline laddr)
      (Hw.memRead s.l1d (l1idx laddr))
      (Hw.memRead s.l1tag (l1idx laddr))
      (Hw.memWrite s.l1d (Hw.or fillDone storeHit) l1wIdx (Hw.mux fillDone fillLine stLine))
      (Hw.memWrite s.l1tag fillDone (l1idx s.rline) (l1tagOf s.rline))
      (Hw.mux inQ (Hw.lit 1 1) (Hw.mux wordP (Hw.lit 1 0) (Hw.mux (gate (Hw.not enterP) readNext) ddrR s.fromL1)))
      (Hw.mux enterP (Hw.and miss cached) (Hw.mux fillDone (Hw.lit 1 0) s.rmode))
      (Hw.mux enterP (Hw.lit 2 0) (Hw.mux fillWord (Hw.add rk (Hw.lit 2 1)) rk))
      (gate inP fillWord)
      (Hw.mux fillWord fillLine s.rbuf)
      (Hw.mux (gate enterP miss) s.ra s.rline)
      busWr resvN resOkN
      (Hw.mux inE sum s.amoA) (Hw.mux inE rs2v s.amoD) (Hw.mux inM w s.amoO)
      (Hw.mux inE d.f5 s.sf5) akN baopN baf5N
      (CsrFile.mk msN mieN mtvecN mscratchN mepcN mcauseN)
      (Hw.mux inD w s.w1)
      (Hw.mux inJ (Hw.cat (Hw.slice 0 16 w : r B16) (Hw.slice 16 16 s.w1 : r B16)) s.ins)
      (Hw.mux inE (Hw.lit 1 0) (Hw.mux inJ (Hw.lit 1 1) s.half))
      (Hw.mux goE (bitOf 1 npc) (Hw.mux inF (bitOf 1 s.pc) s.al))))
    (Out.pack (Out.mk s.trap (gate goE (gate d.store io)) (Hw.slice 0 8 rs2v) (gate goE (gate d.load io)) sum rs2v
      (gate inP (Hw.and (Hw.not s.bsent) (Hw.not s.rgap)))
      (Hw.mux s.rmode (Hw.cat (Hw.slice 4 28 s.rline : r (HwTy.bits 28)) (Hw.cat s.rk (Hw.lit 2 0))) s.badr)
      (Hw.mux inP (Hw.or s.bwe (isK s.baop 2)) s.bwe)
      s.bwd s.bst
      (Hw.mux inP s.baop (Hw.lit 2 0)) (Hw.mux inP s.baf5 (Hw.lit 5 0))
      (gate inP (Hw.not s.rgap))))

------------------------------------------------------------------------------------
-- The core as a circuit, with a program in memory from address 0

-- The state next cycle, with a synchronous reset and a clock enable: `rst` sets the
-- phase, the PC and the trap code and keeps the memories and registers (`Doom.oldStep`
-- did this by hand); `en` low holds the whole state (the multi-cycle harts run at half
-- rate behind it). The reset wins over the hold.
def CoreSt.held {r : HwTy → Type} [Hw r] (ab wb : Nat) (rst en : r W1)
    (next cur : r (CoreSt.code ab wb)) : r (CoreSt.code ab wb) :=
  let ω c := CoreSt.unpack ab wb next;
  let z := CoreSt.pack ab wb (CoreSt.mk
    (Hw.mux rst (Hw.lit 4 Ph.f) c.ph) (Hw.mux rst (Hw.lit 32 0) c.pc)
    c.q0 c.q1 c.q2 c.q3 c.m0 c.m1 c.m2 c.m3 c.rfa c.rfb c.x1 c.x2 c.acc c.dv c.rm c.cnt c.srd c.sf3
    c.slo c.sio (Hw.mux rst (Hw.lit 3 0) c.trap) (Hw.mux rst (Hw.lit 32 0) c.tval)
    c.busq c.fromBus c.badr c.bwe c.bwd c.bst c.bret c.bsent c.ra c.l1q c.l1t c.l1d c.l1tag c.fromL1
    c.rmode c.rk c.rgap c.rbuf c.rline c.bnew (Hw.mux rst (Hw.lit 32 0) c.resv)
    (Hw.mux rst (Hw.lit 1 0) c.resOk)
    c.amoA c.amoD c.amoO c.sf5 (Hw.mux rst (Hw.lit 2 0) c.ak)
    c.baop c.baf5 (CsrFile.reset rst c.csr)
    (Hw.mux rst (Hw.lit 32 0) c.w1) (Hw.mux rst (Hw.lit 32 0) c.ins) (Hw.mux rst (Hw.lit 1 0) c.half)
    (Hw.mux rst (Hw.lit 1 0) c.al));
  Hw.hold en z cur

-- hart 0 (`mhartid` 0): every machine but golem's four-hart SoC
def coreStepC {r : HwTy → Type} [Hw r] (ab wb : Nat) (mx cache : Bool) (s : CoreSt ab wb r) (x : In r) :
    r (HwTy.prod (CoreSt.code ab wb) Out.code) :=
  coreStepHC 0 ab wb mx cache s x

-- the single-hart configurations (the Arty board, the Doom machine, the proofs) keep
-- the private L1; `coreStepC` is the parameterised form
def coreStep {r : HwTy → Type} [Hw r] (ab wb : Nat) (mx : Bool) (s : CoreSt ab wb r) (x : In r) :
    r (HwTy.prod (CoreSt.code ab wb) Out.code) :=
  coreStepC ab wb mx .true s x

-- byte `l` of word `k` of the program (the image is halfwords: 2k + l/2, byte l%2)
def Core.lane (prog : List Nat) (wb l : Nat) : HwTy.El (HwTy.mem wb 8) :=
  fun (a : BitVec wb) =>
    BitVec.ofNat 8 (Rv.bits (Rv.halfAt prog (2 * a.toNat + Nat.div l 2)) (8 * Nat.mod l 2) 8)

def CoreSt.init (ab wb : Nat) (prog : List Nat) : CoreSt ab wb HwTy.El :=
  CoreSt.mk (BitVec.ofNat 4 Ph.f) (BitVec.ofNat 32 0)
    (BitVec.ofNat 8 0) (BitVec.ofNat 8 0) (BitVec.ofNat 8 0) (BitVec.ofNat 8 0)
    (Core.lane prog wb 0) (Core.lane prog wb 1) (Core.lane prog wb 2) (Core.lane prog wb 3)
    (fun (a : BitVec ab) => BitVec.ofNat 32 0) (fun (a : BitVec ab) => BitVec.ofNat 32 0)
    (BitVec.ofNat 32 0) (BitVec.ofNat 32 0) (BitVec.ofNat 32 0) (BitVec.ofNat 32 0) (BitVec.ofNat 32 0)
    (BitVec.ofNat 5 0) (BitVec.ofNat 5 0) (BitVec.ofNat 3 0) (BitVec.ofNat 2 0) (BitVec.ofNat 1 0) (BitVec.ofNat 3 0)
    (BitVec.ofNat 32 0)
    (BitVec.ofNat 32 0) (BitVec.ofNat 1 0) (BitVec.ofNat 32 0) (BitVec.ofNat 1 0) (BitVec.ofNat 32 0)
    (BitVec.ofNat 4 0) (BitVec.ofNat 4 0) (BitVec.ofNat 1 0)
    (BitVec.ofNat 32 0) (BitVec.ofNat 128 0) (BitVec.ofNat (L1.tagW wb) 0)
    (fun (a : BitVec (L1.bits wb)) => BitVec.ofNat 128 0) (fun (a : BitVec (L1.bits wb)) => BitVec.ofNat (L1.tagW wb) 0)
    (BitVec.ofNat 1 0) (BitVec.ofNat 1 0) (BitVec.ofNat 2 0) (BitVec.ofNat 1 0) (BitVec.ofNat 128 0) (BitVec.ofNat 32 0) (BitVec.ofNat 1 0)
    (BitVec.ofNat 32 0) (BitVec.ofNat 1 0) (BitVec.ofNat 32 0) (BitVec.ofNat 32 0) (BitVec.ofNat 32 0)
    (BitVec.ofNat 5 0) (BitVec.ofNat 2 0) (BitVec.ofNat 2 0) (BitVec.ofNat 5 0) CsrFile.init
    (BitVec.ofNat 32 0) (BitVec.ofNat 32 0) (BitVec.ofNat 1 0) (BitVec.ofNat 1 0)

def core (ab wb : Nat) (mx : Bool) (prog : List Nat) : Circuit In.code Out.code :=
  Circuit.mk (CoreSt.code ab wb) (Bundle.toEl (CoreSt.bundle ab wb) (CoreSt.init ab wb prog))
    (fun s x => coreStep ab wb mx (CoreSt.unpack ab wb s) (In.unpack x))

-- the ports with nothing attached: stores may go, loads read -1, no bus
def In.quiet {r : HwTy → Type} [Hw r] : In r :=
  In.mk (Hw.lit 1 1) (Hw.lit 32 4294967295) (Hw.lit 1 0) (Hw.lit 1 0) (Hw.lit 32 0)
    (Hw.lit 1 0) (Hw.lit 1 0) (Hw.lit 1 0)

-- the ports at values: always ready, nothing to read, no interrupt pending
def In.idle : In HwTy.El :=
  In.mk (BitVec.ofNat 1 1) (BitVec.ofNat 32 4294967295) (BitVec.ofNat 1 0) (BitVec.ofNat 1 0)
    (BitVec.ofNat 32 0) (BitVec.ofNat 1 0) (BitVec.ofNat 1 0) (BitVec.ofNat 1 0)
