import Hdl.Core
import Rv.Isa
-- A multi-cycle RV32I / RV32E core: a 32-bit datapath, the registers and the memory in
-- block RAM. Parameters: `ab`, the register address bits (5: RV32I, 4: RV32E), and
-- `wb`, the memory's word address bits (2^wb words of 32 bits, as four byte lanes of
-- 2^wb bytes each, so that byte and halfword stores need no read-modify-write).
--
-- Every memory read is registered (an iCE40 or Xilinx block RAM): the four `q` lanes
-- are the memory's read data, `x1`, `x2` the register file's. The register file is two
-- copies (`rfa`, `rfb`, written together), so that rs1 and rs2 are read in one cycle.
--
-- Phases (`ph`):
--   F  fetch: read the word at PC (after reset and after a store)
--   D  decode: the instruction is in `q`; read rs1 and rs2
--   E  execute: ALU, branch, next PC, register write; a load reads memory, a store
--      writes it; the next instruction's word is read (unless a load or store)
--   M  memory: the loaded word is in `q`; write rd; read the word at PC
--   S  shift: one place per cycle, `cnt` left; then write rd
--   H  stopped (the trap code is in `trap`)
--   P  a bus access (DDR: the fetch or load before D or M, a store before F), until
--      it is answered
--   X  (M) the product is written
--   V  (M) division: one quotient bit per cycle, 32 cycles, then the result is written
-- So an instruction takes 2 cycles (D, E), a load 3, a store 3, a shift 3 + its amount,
-- a multiplication 3, a division 34. `mx` adds the M extension (without it, X and V
-- and the multiplier and divider are not built).

def B2 : HwTy := HwTy.bits 2
def B3 : HwTy := HwTy.bits 3
def B4 : HwTy := HwTy.bits 4
def B5 : HwTy := HwTy.bits 5
def B7 : HwTy := HwTy.bits 7
def W8 : HwTy := HwTy.bits 8
def B12 : HwTy := HwTy.bits 12
def B16 : HwTy := HwTy.bits 16
def B20 : HwTy := HwTy.bits 20
def B32 : HwTy := HwTy.bits 32
def B34 : HwTy := HwTy.bits 34
def W1 : HwTy := HwTy.bit

def Ph.f : Nat := 0
def Ph.d : Nat := 1
def Ph.e : Nat := 2
def Ph.m : Nat := 3
def Ph.s : Nat := 4
def Ph.h : Nat := 5
def Ph.x : Nat := 6   -- M: the product (one cycle)
def Ph.v : Nat := 7   -- M: division, one quotient bit per cycle
def Ph.p : Nat := 8   -- a bus access (DDR), until it is answered
def Ph.q : Nat := 9   -- after a cache line was filled: read it again

-- The L1 cache in front of DDR (unified: the core reads one word at a time, an
-- instruction or data): 2^lb lines of 16 bytes in block RAM, direct-mapped, write-through
-- without allocation (a store to a line that is present updates it). A tag is the
-- valid bit and address bits 27 … 4 + lb. 16 KB (lb = 10) for the Doom machine (wb = 12);
-- one line for the smaller configurations, which have no DDR.
def L1.bits (wb : Nat) : Nat := if Nat.lt wb 12 then 1 else 10
def L1.tagW (wb : Nat) : Nat := Nat.add 1 (24 - L1.bits wb)
def B128 : HwTy := HwTy.bits 128

structure CoreSt (ab wb : Nat) (r : HwTy → Type) where
  ph : r B4
  pc : r B32
  q0 : r W8
  q1 : r W8
  q2 : r W8
  q3 : r W8
  m0 : r (HwTy.mem wb 8)
  m1 : r (HwTy.mem wb 8)
  m2 : r (HwTy.mem wb 8)
  m3 : r (HwTy.mem wb 8)
  rfa : r (HwTy.mem ab 32)
  rfb : r (HwTy.mem ab 32)
  x1 : r B32
  x2 : r B32
  acc : r B32     -- the shifter; the divider's dividend and quotient
  dv : r B32      -- the divider's divisor and remainder (M only)
  rm : r B32
  cnt : r B5      -- places still to shift
  srd : r B5      -- saved for M and S: rd, funct3, the address's low bits / instr bit 30
  sf3 : r B3
  slo : r B2
  sio : r W1     -- saved for M: the load reads the input port
  trap : r B3
  busq : r B32    -- the bus: the word read (used instead of q while `fromBus`)
  fromBus : r W1
  badr : r B32    -- the request: address, write, data, byte enables, the phase after
  bwe : r W1
  bwd : r B32
  bst : r B4
  bret : r B4
  bsent : r W1   -- the request has been taken (`ready` seen)
  ra : r B32      -- the address the memories were last read at (q, l1q, l1t)
  l1q : r B128    -- the L1's read registers: the line, its tag
  l1t : r (HwTy.bits (L1.tagW wb))
  l1d : r (HwTy.mem (L1.bits wb) 128)
  l1tag : r (HwTy.mem (L1.bits wb) (L1.tagW wb))
  fromL1 : r W1   -- the word read is the L1's (DDR)
  rmode : r W1    -- the bus phase is a line fill: word rk of the line at rline, into rbuf
  rk : r B2
  rgap : r W1     -- (a cycle without a request between two words)
  rbuf : r B128
  rline : r B32
  bnew : r W1     -- the first cycle of a store's bus phase (the L1 is updated then)
  deriving Bundle

-- what the core shows: the trap code (0 while running), and a byte written to the
-- output port (`wr` for one cycle)
-- what the core shows: the trap code (0 while running); an I/O store (`wr` for one
-- cycle, at `ioa` with `iod`; `byte` its low byte) or load (`rd`, its value is `ioIn`);
-- a bus request (DDR: `valid` until `ready`)
structure Out (r : HwTy → Type) where
  trap : r B3
  wr : r W1
  byte : r W8
  rd : r W1
  ioa : r B32
  iod : r B32
  valid : r W1
  addr : r B32
  we : r W1
  wdata : r B32
  wstrb : r B4
  pend : r W1    -- a bus access is in progress (phase P)
  deriving Bundle

-- what the core sees: an I/O store may go ahead (it waits in E until it may); the value
-- of an I/O load at `ioa`; the bus's answer (`ready`: the request is taken, and for a
-- write done; `rvalid` with `rdata`: a read's data). The board latches `ready` and
-- `rvalid` until the core has seen them (it may run at a lower rate than the bus).
structure In (r : HwTy → Type) where
  txReady : r W1
  ioIn : r B32
  ready : r W1
  rvalid : r W1
  rdata : r B32
  deriving Bundle

------------------------------------------------------------------------------------
-- Helpers

-- a barrel shifter: `x` shifted left (`left`) or right by `amt` places, filling with
-- `fill` from the left (0, or the sign bit for an arithmetic shift)
def shift1 {r : HwTy → Type} [Hw r] (left fill on : r W1) (x : r B32) : r B32 :=
  Hw.mux on (Hw.mux left (Hw.cat (Hw.slice 0 31 x : r (HwTy.bits 31)) (Hw.lit 1 0))
    (Hw.cat (Hw.mux fill (Hw.lit 1 1) (Hw.lit 1 0) : r (HwTy.bits 1)) (Hw.slice 1 31 x : r (HwTy.bits 31)))) x
def shift2 {r : HwTy → Type} [Hw r] (left fill on : r W1) (x : r B32) : r B32 :=
  Hw.mux on (Hw.mux left (Hw.cat (Hw.slice 0 30 x : r (HwTy.bits 30)) (Hw.lit 2 0))
    (Hw.cat (Hw.mux fill (Hw.lit 2 3) (Hw.lit 2 0) : r (HwTy.bits 2)) (Hw.slice 2 30 x : r (HwTy.bits 30)))) x
def shift4 {r : HwTy → Type} [Hw r] (left fill on : r W1) (x : r B32) : r B32 :=
  Hw.mux on (Hw.mux left (Hw.cat (Hw.slice 0 28 x : r (HwTy.bits 28)) (Hw.lit 4 0))
    (Hw.cat (Hw.mux fill (Hw.lit 4 15) (Hw.lit 4 0) : r (HwTy.bits 4)) (Hw.slice 4 28 x : r (HwTy.bits 28)))) x
def shift8 {r : HwTy → Type} [Hw r] (left fill on : r W1) (x : r B32) : r B32 :=
  Hw.mux on (Hw.mux left (Hw.cat (Hw.slice 0 24 x : r (HwTy.bits 24)) (Hw.lit 8 0))
    (Hw.cat (Hw.mux fill (Hw.lit 8 255) (Hw.lit 8 0) : r (HwTy.bits 8)) (Hw.slice 8 24 x : r (HwTy.bits 24)))) x
def shift16 {r : HwTy → Type} [Hw r] (left fill on : r W1) (x : r B32) : r B32 :=
  Hw.mux on (Hw.mux left (Hw.cat (Hw.slice 0 16 x : r (HwTy.bits 16)) (Hw.lit 16 0))
    (Hw.cat (Hw.mux fill (Hw.lit 16 65535) (Hw.lit 16 0) : r (HwTy.bits 16)) (Hw.slice 16 16 x : r (HwTy.bits 16)))) x
def barrel {r : HwTy → Type} [Hw r] (left fill : r W1) (amt : r B5) (x : r B32) : r B32 :=
  shift16 left fill (Hw.slice 4 1 amt) (shift8 left fill (Hw.slice 3 1 amt) (shift4 left fill (Hw.slice 2 1 amt)
    (shift2 left fill (Hw.slice 1 1 amt) (shift1 left fill (Hw.slice 0 1 amt) x))))

def bitOf {r : HwTy → Type} [Hw r] {ω n : Nat} (i : Nat) (w : r (HwTy.bits n)) : r W1 := Hw.slice i 1 w
def rep {r : HwTy → Type} [Hw r] (ω n : Nat) (b : r W1) : r (HwTy.bits n) :=
  Hw.mux b (Hw.lit n (Nat.pow 2 n - 1)) (Hw.lit n 0)
def isK {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) (k : Nat) : r W1 := Hw.eq x (Hw.lit n k)
-- `c and x` for a control signal `c` (one that the instruction alone determines) and a
-- data-dependent `x`, as a multiplexer: at values with `c` known it reduces whatever `x`
-- is, which the single-instruction proofs need (`Hw.and 0 x` is stuck for a symbolic
-- `x`; icestick-uart FINDINGS.md, C2). yosys makes the same AND of it.
def gate {r : HwTy → Type} [Hw r] (c x : r W1) : r W1 := Hw.mux c x (Hw.lit 1 0)
def zext32 {r : HwTy → Type} [Hw r] (b : r W1) : r B32 := Hw.cat (Hw.lit 31 0) b

-- a register field names a register of the configuration (RV32E: below x16)
def regOk {r : HwTy → Type} [Hw r] (ab : Nat) (f : r B5) : r W1 :=
  if Nat.lt ab 5 then isK (bitOf 4 f) 0 else Hw.lit 1 1
def regIx {r : HwTy → Type} [Hw r] (ab : Nat) (f : r B5) : r (HwTy.bits ab) := Hw.slice 0 ab f

------------------------------------------------------------------------------------
-- The decoded instruction

structure Dec (r : HwTy → Type) where
  rd : r B5
  f3 : r B3
  r1 : r B5
  r2 : r B5
  alt : r W1      -- bit 30 (SUB, SRA, SRAI)
  lui : r W1
  auipc : r W1
  jal : r W1
  jalr : r W1
  branch : r W1
  load : r W1
  store : r W1
  opimm : r W1
  op : r W1
  md : r W1       -- M: OP with funct7 = 1
  ecall : r W1
  ebreak : r W1
  legal : r W1
  immI : r B32
  immS : r B32
  immB : r B32
  immU : r B32
  immJ : r B32

def decode {r : HwTy → Type} [Hw r] (ab : Nat) (mx : Bool) (w : r B32) : Dec r :=
  let opc : r B7 := Hw.slice 0 7 w;
  let rd : r B5 := Hw.slice 7 5 w;
  let f3 : r B3 := Hw.slice 12 3 w;
  let r1 : r B5 := Hw.slice 15 5 w;
  let r2 : r B5 := Hw.slice 20 5 w;
  let f7 : r B7 := Hw.slice 25 7 w;
  let sgn := bitOf 31 w;
  let lui := isK opc Op.lui;
  let auipc := isK opc Op.auipc;
  let jal := isK opc Op.jal;
  let jalr := isK opc Op.jalr;
  let branch := isK opc Op.branch;
  let load := isK opc Op.load;
  let store := isK opc Op.store;
  let opimm := isK opc Op.opimm;
  let opRaw := isK opc Op.op;
  let f7one := isK (Hw.slice 25 7 w : r B7) 1;
  let op : r W1 := if mx then Hw.and opRaw (Hw.not f7one) else opRaw;
  let md : r W1 := if mx then Hw.and opRaw f7one else Hw.lit 1 0;
  let fence := isK opc Op.fence;
  let ecall := isK w 115;
  let ebreak := isK w 1048691;
  let okd := regOk ab rd;
  let ok1 := regOk ab r1;
  let ok2 := regOk ab r2;
  let f7z := isK f7 0;
  let f7a := isK f7 32;
  let f30 := Hw.or (isK f3 0) (isK f3 5);
  let legal := Hw.or (Hw.or (Hw.and (Hw.or (Hw.or lui auipc) jal) okd)
      (Hw.or (Hw.and jalr (Hw.and (isK f3 0) (Hw.and okd ok1)))
        (Hw.and branch (Hw.and (Hw.not (isK (Hw.slice 1 2 f3 : r B2) 1)) (Hw.and ok1 ok2)))))
    (Hw.or (Hw.or (Hw.and load (Hw.and (Hw.or (Hw.ult f3 (Hw.lit 3 3)) (Hw.or (isK f3 4) (isK f3 5))) (Hw.and okd ok1)))
        (Hw.and store (Hw.and (Hw.ult f3 (Hw.lit 3 3)) (Hw.and ok1 ok2))))
      (Hw.or (Hw.or (Hw.and opimm (Hw.and okd (Hw.and ok1
            (Hw.mux (isK f3 1) f7z (Hw.mux (isK f3 5) (Hw.or f7z f7a) (Hw.lit 1 1))))))
          (Hw.and op (Hw.and (Hw.and okd (Hw.and ok1 ok2)) (Hw.or f7z (Hw.and f7a f30)))))
        (Hw.or (Hw.or fence (Hw.or ecall ebreak)) (Hw.and md (Hw.and okd (Hw.and ok1 ok2))))));
  let immI : r B32 := Hw.cat (rep 20 sgn) (Hw.slice 20 12 w : r B12);
  let immS : r B32 := Hw.cat (rep 20 sgn) (Hw.cat (Hw.slice 25 7 w : r B7) (Hw.slice 7 5 w : r B5));
  let immB : r B32 := Hw.cat (rep 20 sgn) (Hw.cat (bitOf 7 w) (Hw.cat (Hw.slice 25 6 w : r (HwTy.bits 6))
      (Hw.cat (Hw.slice 8 4 w : r (HwTy.bits 4)) (Hw.lit 1 0))));
  let immU : r B32 := Hw.cat (Hw.slice 12 20 w : r B20) (Hw.lit 12 0);
  let immJ : r B32 := Hw.cat (rep 12 sgn) (Hw.cat (Hw.slice 12 8 w : r W8) (Hw.cat (bitOf 20 w)
      (Hw.cat (Hw.slice 21 10 w : r (HwTy.bits 10)) (Hw.lit 1 0))));
  Dec.mk rd f3 r1 r2 (bitOf 30 w) lui auipc jal jalr branch load store opimm op md ecall ebreak legal
    immI immS immB immU immJ

------------------------------------------------------------------------------------
-- One cycle

def coreStep {r : HwTy → Type} [Hw r] (ab wb : Nat) (mx : Bool) (s : CoreSt ab wb r) (x : In r) :
    r (HwTy.prod (CoreSt.code ab wb) Out.code) :=
  let ph := s.ph;
  let inF := isK ph Ph.f;
  let inD := isK ph Ph.d;
  let inE := isK ph Ph.e;
  let inM := isK ph Ph.m;
  let inS := isK ph Ph.s;
  let inX : r W1 := if mx then isK ph Ph.x else Hw.lit 1 0;
  let inV : r W1 := if mx then isK ph Ph.v else Hw.lit 1 0;
  let inP := isK ph Ph.p;
  let inQ := isK ph Ph.q;
  -- the L1: a hit is the tag read with the line equal to the address's
  let lb := L1.bits wb;
  let l1idx := fun (a : r B32) => (Hw.slice 4 lb a : r (HwTy.bits lb));
  let l1tagOf := fun (a : r B32) => (Hw.cat (Hw.lit 1 1) (Hw.slice (4 + lb) (24 - lb) a : r (HwTy.bits (24 - lb))) : r (HwTy.bits (L1.tagW wb)));
  let hit := Hw.eq s.l1t (l1tagOf s.ra);
  let l1w : r B32 := Hw.mux (bitOf 3 s.ra) (Hw.mux (bitOf 2 s.ra) (Hw.slice 96 32 s.l1q) (Hw.slice 64 32 s.l1q))
    (Hw.mux (bitOf 2 s.ra) (Hw.slice 32 32 s.l1q) (Hw.slice 0 32 s.l1q));
  let miss := gate (Hw.or inD inM) (gate s.fromL1 (Hw.not hit));
  -- the word read: from block RAM (the q lanes), the L1, or the bus
  let w : r B32 := Hw.mux s.fromL1 l1w (Hw.mux s.fromBus s.busq (Hw.cat s.q3 (Hw.cat s.q2 (Hw.cat s.q1 s.q0))));
  let wq0 : r W8 := Hw.slice 0 8 w;
  let wq1 : r W8 := Hw.slice 8 8 w;
  let wq2 : r W8 := Hw.slice 16 8 w;
  let wq3 : r W8 := Hw.slice 24 8 w;
  let ω d := decode ab mx w;
  let a := s.x1;
  let rs2v := s.x2;
  let regB := Hw.or d.op d.branch;
  let b := Hw.mux regB rs2v (Hw.mux d.store d.immS d.immI);
  let arith := Hw.or d.op d.opimm;
  let cmpOp := Hw.and arith (Hw.or (isK d.f3 2) (isK d.f3 3));
  let sub := Hw.or d.branch (Hw.or cmpOp (Hw.and d.op (Hw.and d.alt (isK d.f3 0))));
  -- a + b, or a - b as a + ~b + 1 (the carry in through a low bit), with the carry out
  let s34 : r B34 := Hw.add (Hw.cat (Hw.lit 1 0) (Hw.cat a (Hw.lit 1 1)))
    (Hw.cat (Hw.lit 1 0) (Hw.cat (Hw.mux sub (Hw.not b) b) sub));
  let sum : r B32 := Hw.slice 1 32 s34;
  let ult := Hw.not (bitOf 33 s34);
  let slt := Hw.mux (Hw.xor (bitOf 31 a) (bitOf 31 b)) (bitOf 31 a) (bitOf 31 sum);
  let eq := Hw.eq a b;
  let taken := Hw.xor (Hw.mux (bitOf 2 d.f3) (Hw.mux (bitOf 1 d.f3) ult slt) eq) (bitOf 0 d.f3);
  let f3 := d.f3;
  -- shifts in one cycle (a barrel shifter; the S phase is no longer used).
  -- SRA is the complement form the specification uses (`ashr x k = ~(~x >> k)` for a
  -- negative `x`): the barrel always shifts right with a zero fill, and the result is
  -- complemented when the sign is set. The old ones-fill (`2^w - 1` in the top `k`
  -- bits) was correct but its proof had to relate the fill to the logical shift by
  -- arithmetic on a full-width constant (`Bits.sub_one_high` at w = 32), whose
  -- `Nat.add_sub_of_le` recurses over `2^31`; the complement form needs only the
  -- definitional `IntN.shiftRight` branches and the logical shift's stage chain.
  let shamt : r B5 := Hw.slice 0 5 b;
  let isSra : r W1 := Hw.and (isK f3 5) d.alt;
  let sraNeg : r W1 := gate isSra (bitOf 31 a);
  let shIn : r B32 := Hw.mux sraNeg (Hw.not a) a;
  let shOut : r B32 := barrel (isK f3 1) (Hw.lit 1 0) shamt shIn;
  let shRes : r B32 := Hw.mux sraNeg (Hw.not shOut) shOut;
  let aluRes := Hw.mux (isK f3 0) sum (Hw.mux (isK f3 2) (zext32 slt) (Hw.mux (isK f3 3) (zext32 ult)
    (Hw.mux (isK f3 4) (Hw.xor a b) (Hw.mux (isK f3 6) (Hw.or a b) (Hw.mux (isK f3 7) (Hw.and a b) shRes)))));
  let shift := Hw.lit 1 0;
  -- the next PC
  let pcInc := Hw.add s.pc (Hw.lit 32 4);
  let pcImm := Hw.add s.pc (Hw.mux d.jal d.immJ (Hw.mux d.branch d.immB d.immU));
  let jalrT : r B32 := Hw.cat (Hw.slice 1 31 sum : r (HwTy.bits 31)) (Hw.lit 1 0);
  let jump := Hw.mux (Hw.or d.jal d.jalr) (Hw.lit 1 1) (gate d.branch taken);
  let target := Hw.mux d.jalr jalrT pcImm;
  let npc := Hw.mux jump target pcInc;
  -- traps
  let lo2 : r B2 := Hw.slice 0 2 sum;
  let mis := Hw.mux (isK (Hw.slice 0 2 f3 : r B2) 2) (Hw.not (isK lo2 0))
    (Hw.mux (isK (Hw.slice 0 2 f3 : r B2) 1) (bitOf 0 sum) (Hw.lit 1 0));
  let misJ := gate jump (bitOf 1 target);
  let misL := gate d.load mis;
  let misS := gate d.store mis;
  let code : r B3 := Hw.mux (Hw.not d.legal) (Hw.lit 3 Trap.illegal) (Hw.mux d.ecall (Hw.lit 3 Trap.ecall)
    (Hw.mux d.ebreak (Hw.lit 3 Trap.ebreak) (Hw.mux misJ (Hw.lit 3 Trap.jump)
    (Hw.mux misL (Hw.lit 3 Trap.load) (Hw.mux misS (Hw.lit 3 Trap.store) (Hw.lit 3 0))))));
  let trapE := Hw.and inE (Hw.not (isK code 0));
  -- a store to the output port waits in E while the output is busy
  let io := bitOf 31 sum;
  let wait := gate (gate d.store io) (Hw.not x.txReady);
  let goE := gate inE (gate (isK code 0) (Hw.not wait));
  -- register writes: in E (everything but loads and shifts), M (loads), S (shifts)
  let rdNZ := Hw.not (isK d.rd 0);
  let wE := gate goE (gate rdNZ (Hw.or (Hw.or (Hw.or d.lui d.auipc) (Hw.or d.jal d.jalr)) (Hw.and arith (Hw.not shift))));
  let resE := Hw.mux d.lui d.immU (Hw.mux d.auipc pcImm (Hw.mux (Hw.or d.jal d.jalr) pcInc aluRes));
  -- the loaded value
  let slo := s.slo;
  let byte := Hw.mux (bitOf 1 slo) (Hw.mux (bitOf 0 slo) wq3 wq2) (Hw.mux (bitOf 0 slo) wq1 wq0);
  let half : r B16 := Hw.mux (bitOf 1 slo) (Hw.cat wq3 wq2) (Hw.cat wq1 wq0);
  let sx := Hw.not (bitOf 2 s.sf3);
  let ldm := Hw.mux (bitOf 1 s.sf3) w (Hw.mux (bitOf 0 s.sf3)
    (Hw.cat (rep 16 (Hw.and sx (bitOf 15 half))) half) (Hw.cat (rep 24 (Hw.and sx (bitOf 7 byte))) byte));
  let ldv := Hw.mux s.sio s.acc ldm;
  let sNZ := Hw.not (isK s.srd 0);
  let sDone := isK s.cnt 0;
  let wM := gate inM (gate (Hw.not miss) sNZ);
  let wS := gate inS (Hw.and sDone sNZ);
  -- M: the operands' signs and magnitudes (E), the product (X), a division step (V)
  let signed := Hw.not (bitOf 0 f3);
  let negA := Hw.and signed (bitOf 31 a);
  let negB := Hw.and signed (bitOf 31 rs2v);
  let absA := Hw.mux negA (Hw.sub (Hw.lit 32 0) a) a;
  let absB := Hw.mux negB (Hw.sub (Hw.lit 32 0) rs2v) rs2v;
  let negQ := Hw.and (Hw.xor negA negB) (Hw.not (isK rs2v 0));
  let sA := Hw.and (Hw.or (isK s.sf3 1) (isK s.sf3 2)) (bitOf 31 s.x1);
  let sB := Hw.and (isK s.sf3 1) (bitOf 31 s.x2);
  let prod : r (HwTy.bits 64) := Hw.mul (Hw.cat (rep 32 sA) s.x1) (Hw.cat (rep 32 sB) s.x2);
  let mres : r B32 := Hw.mux (isK s.sf3 0) (Hw.slice 0 32 prod) (Hw.slice 32 32 prod);
  let rm2 : r B32 := Hw.cat (Hw.slice 0 31 s.rm : r (HwTy.bits 31)) (bitOf 31 s.acc);
  let ge := Hw.not (Hw.ult rm2 s.dv);
  let rmN := Hw.mux ge (Hw.sub rm2 s.dv) rm2;
  let accN : r B32 := Hw.cat (Hw.slice 0 31 s.acc : r (HwTy.bits 31)) ge;
  let dres := Hw.mux (bitOf 1 s.sf3) (Hw.mux (bitOf 1 s.slo) (Hw.sub (Hw.lit 32 0) rmN) rmN)
    (Hw.mux (bitOf 0 s.slo) (Hw.sub (Hw.lit 32 0) accN) accN);
  let wX := gate inX sNZ;
  let wV := gate inV (Hw.and sDone sNZ);
  let we := Hw.or (Hw.or wE (Hw.or wM wS)) (Hw.or wX wV);
  let wa := Hw.mux inE (regIx ab d.rd) (regIx ab s.srd);
  let wd := Hw.mux inE resE (Hw.mux inM ldv (Hw.mux inX mres (Hw.mux inV dres s.acc)));
  -- the shifter: left (funct3 1), right logical or arithmetic (bit 30)
  let left := isK s.sf3 1;
  let sh := Hw.mux left (Hw.cat (Hw.slice 0 31 s.acc : r (HwTy.bits 31)) (Hw.lit 1 0))
    (Hw.cat (Hw.and (bitOf 0 slo) (bitOf 31 s.acc)) (Hw.slice 1 31 s.acc : r (HwTy.bits 31)));
  -- memory: stores in E (not to I/O, not to DDR), byte lanes
  let ddrS := Hw.and (bitOf 30 sum) (Hw.not io);
  let st := gate goE (gate d.store (Hw.and (Hw.not io) (Hw.not ddrS)));
  let sb := isK f3 0;
  let sh16 := isK f3 1;
  let laneOn := fun (l : Nat) => Hw.mux sb (isK lo2 l) (Hw.mux sh16 (isK (bitOf 1 sum) (Nat.div l 2)) (Hw.lit 1 1));
  let lane := fun (l : Nat) => gate st (laneOn l);
  let d0 : r W8 := Hw.slice 0 8 rs2v;
  let d1 : r W8 := Hw.mux sb d0 (Hw.slice 8 8 rs2v);
  let d2 : r W8 := Hw.mux (isK f3 2) (Hw.slice 16 8 rs2v) d0;
  let d3 : r W8 := Hw.mux sb d0 (Hw.mux sh16 d1 (Hw.slice 24 8 rs2v));
  -- the memory read: the load's address, else the next instruction's
  -- (one address for reading and writing, so that each lane is a single-port RAM: a
  -- store's read is not used, the next cycle fetches again)
  let raddr := Hw.mux inQ s.rline (Hw.mux (gate goE (Hw.or d.load d.store)) sum (Hw.mux goE npc s.pc));
  let rix : r (HwTy.bits wb) := Hw.slice 2 wb raddr;
  let nphB : r B4 := Hw.mux inF (Hw.lit 4 Ph.d) (Hw.mux inD (Hw.lit 4 Ph.e)
    (Hw.mux inE (Hw.mux trapE (Hw.lit 4 Ph.h) (Hw.mux wait (Hw.lit 4 Ph.e) (Hw.mux d.md (Hw.mux (bitOf 2 f3) (Hw.lit 4 Ph.v) (Hw.lit 4 Ph.x)) (Hw.mux d.load (Hw.lit 4 Ph.m) (Hw.mux shift (Hw.lit 4 Ph.s)
      (Hw.mux d.store (Hw.lit 4 Ph.f) (Hw.lit 4 Ph.d)))))))
    (Hw.mux inM (Hw.lit 4 Ph.d) (Hw.mux inS (Hw.mux sDone (Hw.lit 4 Ph.d) (Hw.lit 4 Ph.s))
    (Hw.mux inX (Hw.lit 4 Ph.d) (Hw.mux inV (Hw.mux sDone (Hw.lit 4 Ph.d) (Hw.lit 4 Ph.v)) ph))))));
  -- DDR (bit 30 set, bit 31 clear): a fetch or load reads the L1 (a miss in D or M fills
  -- the line over the bus, word by word, then reads it again: P, Q); a store goes to the
  -- bus (write-through) and updates the line if it is present
  let ddrR := Hw.and (bitOf 30 raddr) (Hw.not (bitOf 31 raddr));
  let readNext := Hw.or (isK nphB Ph.d) (isK nphB Ph.m);
  let busRd := Hw.lit 1 0;
  let busWr := gate goE (gate d.store ddrS);
  let enterP := Hw.or miss busWr;
  -- (not in the gap: an answer the board still shows from the word before)
  let fillWord := gate inP (gate s.rmode (gate (Hw.not s.rgap) x.rvalid));
  let fillDone := gate fillWord (isK s.rk 3);
  let done := Hw.mux s.rmode fillDone (Hw.mux s.bwe x.ready x.rvalid);
  let nph : r B4 := Hw.mux inP (Hw.mux done (Hw.mux s.rmode (Hw.lit 4 Ph.q) s.bret) ph)
    (Hw.mux inQ s.bret (Hw.mux enterP (Hw.lit 4 Ph.p) nphB));
  -- the L1's writes: a filled line (and its tag), or a store's bytes into a present line
  let rk := s.rk;
  let fillLine : r B128 := Hw.cat (Hw.mux (isK rk 3) x.rdata (Hw.slice 96 32 s.rbuf : r B32))
    (Hw.cat (Hw.mux (isK rk 2) x.rdata (Hw.slice 64 32 s.rbuf : r B32))
    (Hw.cat (Hw.mux (isK rk 1) x.rdata (Hw.slice 32 32 s.rbuf : r B32)) (Hw.mux (isK rk 0) x.rdata (Hw.slice 0 32 s.rbuf : r B32))));
  let storeHit := gate inP (gate s.bnew (gate s.bwe hit));
  let sbyte := fun (j : Nat) => (Hw.mux (Hw.and (isK (Hw.slice 2 2 s.ra : r B2) (Nat.div j 4)) (bitOf (Nat.mod j 4) s.bst))
    (Hw.slice (8 * Nat.mod j 4) 8 s.bwd) (Hw.slice (8 * j) 8 s.l1q) : r W8);
  let w4 := fun (k : Nat) => (Hw.cat (sbyte (4 * k + 3)) (Hw.cat (sbyte (4 * k + 2)) (Hw.cat (sbyte (4 * k + 1)) (sbyte (4 * k)))) : r B32);
  let stLine : r B128 := Hw.cat (w4 3) (Hw.cat (w4 2) (Hw.cat (w4 1) (w4 0)));
  let l1wIdx := Hw.mux fillDone (l1idx s.rline) (l1idx s.ra);
  let rfa := Hw.memWrite s.rfa we wa wd;
  let rfb := Hw.memWrite s.rfb we wa wd;
  Hw.pair
    (CoreSt.pack ab wb (CoreSt.mk nph
      (Hw.mux goE npc s.pc)
      (Hw.memRead s.m0 rix) (Hw.memRead s.m1 rix) (Hw.memRead s.m2 rix) (Hw.memRead s.m3 rix)
      (Hw.memWrite s.m0 (lane 0) rix d0) (Hw.memWrite s.m1 (lane 1) rix d1)
      (Hw.memWrite s.m2 (lane 2) rix d2) (Hw.memWrite s.m3 (lane 3) rix d3)
      rfa rfb
      (Hw.memRead s.rfa (regIx ab d.r1)) (Hw.memRead s.rfb (regIx ab d.r2))
      (Hw.mux inE (Hw.mux (gate d.load io) x.ioIn (Hw.mux d.md absA a)) (Hw.mux inS sh (Hw.mux inV accN s.acc)))
      (Hw.mux inE absB s.dv)
      (Hw.mux inE (Hw.lit 32 0) (Hw.mux inV rmN s.rm))
      (Hw.mux inE (Hw.mux d.md (Hw.lit 5 31) (Hw.slice 0 5 b)) (Hw.mux (Hw.or inS inV) (Hw.sub s.cnt (Hw.lit 5 1)) s.cnt))
      (Hw.mux inE d.rd s.srd)
      (Hw.mux inE f3 s.sf3)
      (Hw.mux inE (Hw.mux d.md (Hw.cat negA negQ) (Hw.mux d.load lo2 (Hw.cat (Hw.lit 1 0) d.alt))) s.slo)
      (Hw.mux inE (gate d.load io) s.sio)
      (Hw.mux trapE code s.trap)
      (Hw.mux (gate inP x.rvalid) x.rdata s.busq)
      (Hw.mux (gate inP (gate (Hw.not s.bwe) x.rvalid)) (Hw.lit 1 1)
        (Hw.mux (Hw.and (Hw.not inP) (gate readNext (Hw.not ddrR))) (Hw.lit 1 0) s.fromBus))
      (Hw.mux enterP (Hw.mux busWr sum raddr) s.badr)
      (Hw.mux enterP (Hw.mux miss (Hw.lit 1 0) busWr) s.bwe)
      (Hw.mux enterP (Hw.cat d3 (Hw.cat d2 (Hw.cat d1 d0))) s.bwd)
      (Hw.mux enterP (Hw.cat (laneOn 3) (Hw.cat (laneOn 2) (Hw.cat (laneOn 1) (laneOn 0)))) s.bst)
      (Hw.mux enterP (Hw.mux miss ph (Hw.mux busWr (Hw.lit 4 Ph.f) nphB)) s.bret)
      (Hw.mux inP (Hw.mux (Hw.or fillWord s.rgap) (Hw.lit 1 0) (Hw.or s.bsent x.ready)) (Hw.lit 1 0))
      (Hw.mux inQ s.rline raddr)
      (Hw.memRead s.l1d (l1idx raddr))
      (Hw.memRead s.l1tag (l1idx raddr))
      (Hw.memWrite s.l1d (Hw.or fillDone storeHit) l1wIdx (Hw.mux fillDone fillLine stLine))
      (Hw.memWrite s.l1tag fillDone (l1idx s.rline) (l1tagOf s.rline))
      (Hw.mux inQ (Hw.lit 1 1) (Hw.mux (gate (Hw.not enterP) readNext) ddrR s.fromL1))
      (Hw.mux enterP miss (Hw.mux fillDone (Hw.lit 1 0) s.rmode))
      (Hw.mux enterP (Hw.lit 2 0) (Hw.mux fillWord (Hw.add rk (Hw.lit 2 1)) rk))
      (gate inP fillWord)
      (Hw.mux fillWord fillLine s.rbuf)
      (Hw.mux (gate enterP miss) s.ra s.rline)
      busWr))
    (Out.pack (Out.mk s.trap (gate goE (gate d.store io)) (Hw.slice 0 8 rs2v) (gate goE (gate d.load io)) sum rs2v
      (gate inP (Hw.and (Hw.not s.bsent) (Hw.not s.rgap)))
      (Hw.mux s.rmode (Hw.cat (Hw.slice 4 28 s.rline : r (HwTy.bits 28)) (Hw.cat s.rk (Hw.lit 2 0))) s.badr)
      s.bwe s.bwd s.bst (gate inP (Hw.not s.rgap))))

------------------------------------------------------------------------------------
-- The core as a circuit, with a program in memory from address 0

-- byte `l` of word `k` of the program
def Core.lane (prog : List Nat) (wb l : Nat) : HwTy.El (HwTy.mem wb 8) :=
  fun (a : BitVec wb) => BitVec.ofNat 8 (Rv.bits (Rv.wordAt prog a.toNat) (8 * l) 8)

def CoreSt.init (ab wb : Nat) (prog : List Nat) : CoreSt ab wb HwTy.El :=
  CoreSt.mk (BitVec.ofNat 4 Ph.f) (BitVec.ofNat 32 0)
    (BitVec.ofNat 8 0) (BitVec.ofNat 8 0) (BitVec.ofNat 8 0) (BitVec.ofNat 8 0)
    (Core.lane prog wb 0) (Core.lane prog wb 1) (Core.lane prog wb 2) (Core.lane prog wb 3)
    (fun (a : BitVec ab) => BitVec.ofNat 32 0) (fun (a : BitVec ab) => BitVec.ofNat 32 0)
    (BitVec.ofNat 32 0) (BitVec.ofNat 32 0) (BitVec.ofNat 32 0) (BitVec.ofNat 32 0) (BitVec.ofNat 32 0)
    (BitVec.ofNat 5 0) (BitVec.ofNat 5 0) (BitVec.ofNat 3 0) (BitVec.ofNat 2 0) (BitVec.ofNat 1 0) (BitVec.ofNat 3 0)
    (BitVec.ofNat 32 0) (BitVec.ofNat 1 0) (BitVec.ofNat 32 0) (BitVec.ofNat 1 0) (BitVec.ofNat 32 0)
    (BitVec.ofNat 4 0) (BitVec.ofNat 4 0) (BitVec.ofNat 1 0)
    (BitVec.ofNat 32 0) (BitVec.ofNat 128 0) (BitVec.ofNat (L1.tagW wb) 0)
    (fun (a : BitVec (L1.bits wb)) => BitVec.ofNat 128 0) (fun (a : BitVec (L1.bits wb)) => BitVec.ofNat (L1.tagW wb) 0)
    (BitVec.ofNat 1 0) (BitVec.ofNat 1 0) (BitVec.ofNat 2 0) (BitVec.ofNat 1 0) (BitVec.ofNat 128 0) (BitVec.ofNat 32 0) (BitVec.ofNat 1 0)

def core (ab wb : Nat) (mx : Bool) (prog : List Nat) : Circuit In.code Out.code :=
  Circuit.mk (CoreSt.code ab wb) (Bundle.toEl (CoreSt.bundle ab wb) (CoreSt.init ab wb prog))
    (fun s x => coreStep ab wb mx (CoreSt.unpack ab wb s) (In.unpack x))

-- the ports with nothing attached: stores may go, loads read -1, no bus
def In.quiet {r : HwTy → Type} [Hw r] : In r :=
  In.mk (Hw.lit 1 1) (Hw.lit 32 4294967295) (Hw.lit 1 0) (Hw.lit 1 0) (Hw.lit 32 0)

-- the ports at values: always ready, nothing to read
def In.idle : In HwTy.El := In.mk (BitVec.ofNat 1 1) (BitVec.ofNat 32 4294967295) (BitVec.ofNat 1 0) (BitVec.ofNat 1 0) (BitVec.ofNat 32 0)
