import Rv.PipeProofs.Base
import BitVecShift
-- SLLI x9, x2, 5, the full claim at retirement.
--
-- The register value is the M stage's barrel shifter (`barrel` in src/Rv/Core.wiz):
-- a left shift by 5 turns on the 1 and 4 stages, `BitVec.shlStage` in
-- lib/BitVecShift.wiz, and `Bits.low_shift`/`Bits.low_low` put the chain in
-- `BitVec.shl`'s normal form (the lemma that was missing before the pipeline proofs,
-- wiz-notes/rv-shift-lemmas.md). The pipeline's fill is `Hw.and alt (bit 31 a)` with
-- `alt = 0`; a left shift never reads the fill, so the barrel lemma holds for any fill.
--
-- As in the other field-by-field files, the six observed values are one `rfl` (or one
-- barrel lemma) each, and `Qp.glueG` assembles them along D's word/hit hypothesis
-- without re-evaluating the three cycles (FINDINGS.md H10).


def Sl.stage1 (x : BitVec 32) : BitVec 32 := BitVec.shlStage 31 1 x
def Sl.stage2 (x : BitVec 32) : BitVec 32 := BitVec.shlStage 30 2 x
def Sl.stage4 (x : BitVec 32) : BitVec 32 := BitVec.shlStage 28 4 x
def Sl.stage8 (x : BitVec 32) : BitVec 32 := BitVec.shlStage 24 8 x
def Sl.stage16 (x : BitVec 32) : BitVec 32 := BitVec.shlStage 16 16 x

def Sl.slli5Stages (x : BitVec 32) : BitVec 32 := Sl.stage4 (Sl.stage1 x)

def Sl.slli5Stages_toNat (x : BitVec 32) :
    (Sl.slli5Stages x).toNat = Bits.low 32 (Nat.mul x.toNat 32) :=
  let X := Nat.mul x.toNat (Nat.pow 2 1);
  Eq.trans
    (BitVec.shlStage_toNat 28 4 (Sl.stage1 x))
    (Eq.trans
      (Bits.congr (fun t => Bits.low 32 (Nat.mul t (Nat.pow 2 4))) (BitVec.shlStage_toNat 31 1 x))
      (Eq.trans
        (Bits.low_shift 28 4 (Bits.low 32 X))
        (Eq.trans
          (Bits.congr (fun t => Nat.mul t (Nat.pow 2 4))
            (Bits.low_low 28 32 X rfl))
          (Eq.trans
            (Bits.congr (fun t => Nat.mul t (Nat.pow 2 4)) (Bits.low_shift 27 1 x.toNat))
            (Eq.trans
              (nat_ring! (Bits.low 27 x.toNat * 2) * 16 = Bits.low 27 x.toNat * 32)
              (Eq.symm (Bits.low_shift 27 5 x.toNat)))))))

def Sl.barrel5_toNat (fill : BitVec 1) (x : BitVec 32) :
    (barrel (r := HwTy.El) (BitVec.ofNat 1 1) fill (BitVec.ofNat 5 5) x).toNat
      = Bits.low 32 (Nat.mul x.toNat 32) :=
  Sl.slli5Stages_toNat x

def Qp.barrel5 (fill : BitVec 1) (x : BitVec 32) :
    barrel (r := HwTy.El) (BitVec.ofNat 1 1) fill (BitVec.ofNat 5 5) x = BitVec.shl x 5 :=
  UIntN.ext (barrel (r := HwTy.El) (BitVec.ofNat 1 1) fill (BitVec.ofNat 5 5) x) (BitVec.shl x 5)
    (Eq.trans (Sl.barrel5_toNat fill x) (Eq.symm (BitVec.shl_toNat 32 5 x)))

def Qp.sllbit (a : Arch) : BitVec 1 := bitOf (r := HwTy.El) (n := 32) 31 (Qp.rf a (BitVec.ofNat 4 2))
def Qp.sllalt : BitVec 1 := bitOf (r := HwTy.El) (n := 32) 30 (BitVec.ofNat 32 (Qp.w (A.slli 9 2 5)))
def Qp.sllFill (a : Arch) : BitVec 1 := Hw.and (r := HwTy.El) (n := 1) (Qp.sllalt) (Qp.sllbit a)
def Qp.sllX (a : Arch) : BitVec 32 := Qp.rf a (BitVec.ofNat 4 2)
def Qp.sllBarrel (a : Arch) : BitVec 32 :=
  barrel (r := HwTy.El) (BitVec.ofNat 1 1) (Qp.sllFill a) (BitVec.ofNat 5 5) (Qp.sllX a)

def Qp.slli_val1 (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (ea eb mres rval : BitVec 32) :
    (Qp.G (Qp.at a (Qp.w (A.slli 9 2 5)) m0 m1 m2 m3 ea eb mres rval)
      (BitVec.ofNat 32 (Qp.w (A.slli 9 2 5)), BitVec.ofNat 1 1)).val
    = Qp.sllBarrel a := rfl

def Qp.slli_val (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (ea eb mres rval : BitVec 32) :
    (Qp.G (Qp.at a (Qp.w (A.slli 9 2 5)) m0 m1 m2 m3 ea eb mres rval)
      (BitVec.ofNat 32 (Qp.w (A.slli 9 2 5)), BitVec.ofNat 1 1)).val
    = (Qp.spec a (Qp.w (A.slli 9 2 5)) 9).val :=
  Eq.trans (Qp.slli_val1 a m0 m1 m2 m3 ea eb mres rval)
    (Eq.trans (Qp.barrel5 (Qp.sllFill a) (Qp.sllX a)) rfl)

def Qp.slli_npc (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (ea eb mres rval : BitVec 32) :
    (Qp.G (Qp.at a (Qp.w (A.slli 9 2 5)) m0 m1 m2 m3 ea eb mres rval)
      (BitVec.ofNat 32 (Qp.w (A.slli 9 2 5)), BitVec.ofNat 1 1)).npc
    = (Qp.spec a (Qp.w (A.slli 9 2 5)) 9).npc := rfl

def Qp.slli_pc (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (ea eb mres rval : BitVec 32) :
    (Qp.G (Qp.at a (Qp.w (A.slli 9 2 5)) m0 m1 m2 m3 ea eb mres rval)
      (BitVec.ofNat 32 (Qp.w (A.slli 9 2 5)), BitVec.ofNat 1 1)).pc
    = (Qp.spec a (Qp.w (A.slli 9 2 5)) 9).pc := rfl

def Qp.slli_v (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (ea eb mres rval : BitVec 32) :
    (Qp.G (Qp.at a (Qp.w (A.slli 9 2 5)) m0 m1 m2 m3 ea eb mres rval)
      (BitVec.ofNat 32 (Qp.w (A.slli 9 2 5)), BitVec.ofNat 1 1)).v
    = (Qp.spec a (Qp.w (A.slli 9 2 5)) 9).v := rfl

def Qp.slli_we (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (ea eb mres rval : BitVec 32) :
    (Qp.G (Qp.at a (Qp.w (A.slli 9 2 5)) m0 m1 m2 m3 ea eb mres rval)
      (BitVec.ofNat 32 (Qp.w (A.slli 9 2 5)), BitVec.ofNat 1 1)).we
    = (Qp.spec a (Qp.w (A.slli 9 2 5)) 9).we := rfl

def Qp.slli_rd (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (ea eb mres rval : BitVec 32) :
    (Qp.G (Qp.at a (Qp.w (A.slli 9 2 5)) m0 m1 m2 m3 ea eb mres rval)
      (BitVec.ofNat 32 (Qp.w (A.slli 9 2 5)), BitVec.ofNat 1 1)).rd
    = (Qp.spec a (Qp.w (A.slli 9 2 5)) 9).rd := rfl

def Qp.slli_ok : Qp.ClaimG (Qp.w (A.slli 9 2 5)) 9 :=
  fun a m0 m1 m2 m3 ea eb mres rval h =>
  Qp.glueG (Qp.at a (Qp.w (A.slli 9 2 5)) m0 m1 m2 m3 ea eb mres rval) a
    (Qp.w (A.slli 9 2 5)) 9
    (Qp.slli_npc a m0 m1 m2 m3 ea eb mres rval)
    (Qp.slli_pc a m0 m1 m2 m3 ea eb mres rval)
    (Qp.slli_v a m0 m1 m2 m3 ea eb mres rval)
    (Qp.slli_we a m0 m1 m2 m3 ea eb mres rval)
    (Qp.slli_rd a m0 m1 m2 m3 ea eb mres rval)
    (Qp.slli_val a m0 m1 m2 m3 ea eb mres rval)
    h
