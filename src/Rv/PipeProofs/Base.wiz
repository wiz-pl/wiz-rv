import Rv.Pipe
import Rv.Asm
-- Kernel-checked single-instruction proofs for the pipelined core (src/Rv/Pipe.wiz), at
-- retirement: the RV32E core (16 registers, 2 KB), with an instruction word in D and
-- the stages behind it empty (E, M and R bubbles, no divider, bus or store buffer
-- busy), is after one cycle fetching the specification's next PC, and after three
-- cycles has the instruction in R, retiring (valid, writing rd) with the
-- specification's value for rd and the instruction's PC. The architectural state is
-- symbolic: any PC, any registers (both copies of the register file hold them), any
-- on-chip memory (both copies); so are the data the bubbles leave in E, M and R
-- (`ea`, `eb`, `mres`, `rval`: forwarding must not pick them up). The other leftovers
-- are fixed at 0. What D presents is a hypothesis (`Pp.dWord`, `Pp.dHit`: the word, a
-- hit), moved into the first cycle by a generic lemma (`Qp.ok`), as in
-- src/Rv/Proofs.wiz.
--
-- One instruction per file (src/Rv/PipeProofs/Xor.wiz …), so `grail build` checks each
-- in its own job (one process per claim keeps the memory per check bounded). The
-- `Qp.Claim` files are the slow ones: the `rfl` of the six observed values at the
-- instruction's state is slow as a whole (FINDINGS.md, H10; README.md here has the
-- measured time and peak memory of each file). Outside grail: scripts/pipe-proofs.sh.

def Qp.wb : Nat := 9
def Qp.cfg : Cfg := Cfg.rv32e 11
def Qp.rf (a : Arch) : BitVec 4 → BitVec 32 := fun (i : BitVec 4) => a.regs (BitVec.ofNat 5 i.toNat)
def Qp.w (i : Asm) : Nat := Rv.wordAt (Asm.assemble (.cons i .nil)) 0
def Qp.b (n : Nat) : BitVec n := BitVec.ofNat n 0
def Qp.b8 (w k : Nat) : BitVec 8 := BitVec.ofNat 8 (Rv.bits w (8 * k) 8)
def Qp.zm (aw dw : Nat) : BitVec aw → BitVec dw := fun (i : BitVec aw) => BitVec.ofNat dw 0

-- the core with `w` in D at the PC (the on-chip read registers hold its bytes), the
-- stages behind it empty
def Qp.at (a : Arch) (w : Nat) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (ea eb mres rval : BitVec 32) : PpSt 4 9 HwTy.El :=
  PpSt.mk
    (PpFe.mk a.pc (BitVec.ofNat 1 1) (Qp.b 2) (Qp.b 32) (Qp.b 1) (Qp.b 32))
    (PpMem.mk m0 m1 m2 m3 m0 m1 m2 m3 (Qp.b8 w 0) (Qp.b8 w 1) (Qp.b8 w 2) (Qp.b8 w 3) (Qp.b 8) (Qp.b 8) (Qp.b 8) (Qp.b 8)
      (Qp.rf a) (Qp.rf a)
      (Qp.zm (L1.bits 9) 128) (Qp.zm (L1.bits 9) (L1.tagW 9)) (Qp.zm (L1.bits 9) (L1.tagW 9)) (Qp.b 128) (Qp.b (L1.tagW 9)) (Qp.b (L1.tagW 9))
      (Qp.zm (L1.bits 9) 128) (Qp.zm (L1.bits 9) (L1.tagW 9)) (Qp.b 128) (Qp.b (L1.tagW 9)))
    (PpWr.mk (Qp.b 4) (Qp.b 9) (Qp.b 32) (Qp.b 4) (Qp.b 9) (Qp.b 32)
      (Qp.b 1) (Qp.b 1) (Qp.b (L1.bits 9)) (Qp.b 128) (Qp.b (L1.tagW 9)) (Qp.b 1) (Qp.b (L1.bits 9)) (Qp.b 128)
      (Qp.b 1) (Qp.b 1) (Qp.b (L1.bits 9)) (Qp.b 128) (Qp.b (L1.tagW 9)))
    (PpE.mk (Qp.b 1) (Qp.b 1) (Qp.b 32) (Qp.b 32) (Qp.b 32) ea eb
      (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1)
      (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 4) (Qp.b 1)
      (Qp.b 1) (Qp.b 12) (Qp.b 1) (Qp.b 1) (Qp.b 1))
    (PpM.mk (Qp.b 1) (Qp.b 1) (Qp.b 32) (Qp.b 5) (Qp.b 1) (Qp.b 1) mres (Qp.b 32) (Qp.b 32) (Qp.b 3)
      (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 3) (Qp.b 32) (Qp.b 1) (Qp.b 32) (Qp.b 32) (Qp.b 32) (Qp.b 32) (Qp.b 32)
      (Qp.b 1) (Qp.b 32) (Qp.b 5) (Qp.b 1) (Qp.b 1))
    (PpR.mk (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 1) (Qp.b 32) (Qp.b 5) (Qp.b 1) rval (Qp.b 3) (Qp.b 32) (Qp.b 32) (Qp.b 1))
    (PpDiv.mk (Qp.b 1) (Qp.b 5) (Qp.b 32) (Qp.b 32) (Qp.b 32) (Qp.b 1))
    (PpBus.mk (Qp.b 1) (Qp.b 32) (Qp.b 32) (Qp.b 4) (Qp.b 1) (Qp.b 1) (Qp.b 32) (Qp.b 32) (Qp.b 4) (Qp.b 1) (Qp.b 2)
      (Qp.b 2) (Qp.b 128) (Qp.b 1) (Qp.b 1) (Qp.b 32))
    (Qp.b 3) (Qp.b 32) (Qp.b 32) CsrFile.init

def Qp.un (v : HwTy.El (PpSt.code 4 9)) : PpSt 4 9 HwTy.El := Bundle.ofEl (PpSt.bundle 4 9) v
-- the first cycle with D's word and hit given
def Qp.stepW (q : BitVec 32 × BitVec 1) (s : PpSt 4 9 HwTy.El) : PpSt 4 9 HwTy.El :=
  Qp.un (pipeStepW (r := HwTy.El) 4 9 .false q.1 q.2 s In.idle).1
-- one cycle: `pipeStep` is by definition `pipeStepW` at D's word and hit, and so is this
-- (spelt as `Qp.stepW` so that `Qp.ok` matches it by one unfolding; spelt through
-- `pipeStep`, the checker evaluated the cycle on both sides to compare them, about
-- 480 s of the file's cold check; rv FINDINGS H13)
def Qp.step (s : PpSt 4 9 HwTy.El) : PpSt 4 9 HwTy.El :=
  Qp.stepW (Pp.dWord (r := HwTy.El) 4 9 s, Pp.dHit (r := HwTy.El) 4 9 s) s

-- what is compared: the next fetch address after one cycle; after three, R's PC,
-- whether it retires writing rd (valid, write enable, rd), and the value
structure Qp.Obs where
  npc : BitVec 32
  pc : BitVec 32
  v : BitVec 1
  we : BitVec 1
  rd : BitVec 5
  val : BitVec 32

def Qp.obs (s1 s3 : PpSt 4 9 HwTy.El) : Qp.Obs := Qp.Obs.mk s1.fe.pc s3.rr.pc s3.rr.v s3.rr.we s3.rr.rd s3.rr.val
def Qp.spec (a : Arch) (w rd : Nat) : Qp.Obs :=
  Qp.Obs.mk (Rv.exec Qp.cfg a w).pc a.pc (BitVec.ofNat 1 1) (BitVec.ofNat 1 1) (BitVec.ofNat 5 rd) (Rv.reg (Rv.exec Qp.cfg a w) rd)

-- the three cycles, as a function of D's word and hit
def Qp.G (s : PpSt 4 9 HwTy.El) (q : BitVec 32 × BitVec 1) : Qp.Obs :=
  Qp.obs (Qp.stepW q s) (Qp.step (Qp.step (Qp.stepW q s)))

-- The glue: if D presents `w` as a hit and the three cycles on it do what the
-- specification says, the core does.
def Qp.ok (s : PpSt 4 9 HwTy.El) (o : Qp.Obs) (w : Nat)
    (hE : Qp.G s (BitVec.ofNat 32 w, BitVec.ofNat 1 1) = o)
    (h : (Pp.dWord (r := HwTy.El) 4 9 s, Pp.dHit (r := HwTy.El) 4 9 s) = (BitVec.ofNat 32 w, BitVec.ofNat 1 1)) :
    Qp.obs (Qp.step s) (Qp.step (Qp.step (Qp.step s))) = o :=
  -- (every implicit argument given: inferring them made the checker compare two
  -- equations at `Qp.Obs`, a record of equations, and normalise the three cycles;
  -- rv FINDINGS H13)
  Eq.trans (A := Qp.Obs)
    (a := Qp.obs (Qp.step s) (Qp.step (Qp.step (Qp.step s))))
    (b := Qp.G s (BitVec.ofNat 32 w, BitVec.ofNat 1 1)) (c := o)
    (Eq.congrArg (A := BitVec 32 × BitVec 1) (B := Qp.Obs) (Qp.G s)
      (a := (Pp.dWord (r := HwTy.El) 4 9 s, Pp.dHit (r := HwTy.El) 4 9 s))
      (b := (BitVec.ofNat 32 w, BitVec.ofNat 1 1)) h)
    hE

-- the claim for an instruction word `w` writing rd
def Qp.Claim (w rd : Nat) : Prop :=
  (a : Arch) → (m0 m1 m2 m3 : BitVec 9 → BitVec 8) → (ea eb mres rval : BitVec 32) →
  (Pp.dWord (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval), Pp.dHit (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))
    = (BitVec.ofNat 32 w, BitVec.ofNat 1 1) →
  Qp.obs (Qp.step (Qp.at a w m0 m1 m2 m3 ea eb mres rval)) (Qp.step (Qp.step (Qp.step (Qp.at a w m0 m1 m2 m3 ea eb mres rval))))
    = Qp.spec a w rd

------------------------------------------------------------------------------------
-- The same claim, proved field by field
--
-- A whole-record `rfl` of `Qp.Claim` costs the conversion check one evaluation of the
-- three cycles per observed value, and for the immediate forms that went over heavy's
-- 5 GB cap (FINDINGS.md, H10). The claim below is the same proposition — `Qp.obs` is
-- `Qp.Obs.mk` of the six observed values, and `Qp.step` is `Qp.stepW` at
-- `(Pp.dWord s, Pp.dHit s)` — but stated in the form the field proofs can build: the
-- constructor unfolded, and `Qp.G`'s word and hit as separate arguments (`Qp.GW`) so
-- the hypothesis rewrites them one at a time. Each observed value is then one field
-- lemma, proved by its own `rfl` (seconds), and the six are assembled along the
-- hypothesis alone. No step is evaluated during the assembly.

-- `Qp.G` with D's word and hit as separate arguments
def Qp.GW (s : PpSt 4 9 HwTy.El) (wd : BitVec 32) (ht : BitVec 1) : Qp.Obs :=
  Qp.G s (wd, ht)

-- transport a two-argument value along two equalities
def Qp.tr2 {X : Type} (F : BitVec 32 → BitVec 1 → X) {a b : BitVec 32} {c d : BitVec 1}
    (e1 : a = b) (e2 : c = d) : F a c = F b d :=
  Eq.trans (Eq.congrArg (fun z => F z c) e1) (Eq.congrArg (fun z => F b z) e2)

-- constructor congruence for the observed values
def Qp.Obs.eq6 (a1 a2 : BitVec 32) (a3 a4 : BitVec 1) (a5 : BitVec 5) (a6 : BitVec 32)
    (b1 b2 : BitVec 32) (b3 b4 : BitVec 1) (b5 : BitVec 5) (b6 : BitVec 32)
    (h1 : a1 = b1) (h2 : a2 = b2) (h3 : a3 = b3) (h4 : a4 = b4) (h5 : a5 = b5) (h6 : a6 = b6) :
    Qp.Obs.mk a1 a2 a3 a4 a5 a6 = Qp.Obs.mk b1 b2 b3 b4 b5 b6 :=
  Eq.trans (Eq.congrArg (fun z => Qp.Obs.mk z a2 a3 a4 a5 a6) h1)
    (Eq.trans (Eq.congrArg (fun z => Qp.Obs.mk b1 z a3 a4 a5 a6) h2)
      (Eq.trans (Eq.congrArg (fun z => Qp.Obs.mk b1 b2 z a4 a5 a6) h3)
        (Eq.trans (Eq.congrArg (fun z => Qp.Obs.mk b1 b2 b3 z a5 a6) h4)
          (Eq.trans (Eq.congrArg (fun z => Qp.Obs.mk b1 b2 b3 b4 z a6) h5)
            (Eq.congrArg (fun z => Qp.Obs.mk b1 b2 b3 b4 b5 z) h6)))))

-- the second component of the hypothesis: an equality of pairs is a pair of equalities,
-- and the second one is cast along the first (the pair encoding is dependent)
def Qp.hitEq (s : PpSt 4 9 HwTy.El) (w : Nat)
    (h : (Pp.dWord (r := HwTy.El) 4 9 s, Pp.dHit (r := HwTy.El) 4 9 s)
      = (BitVec.ofNat 32 w, BitVec.ofNat 1 1)) :
    Pp.dHit (r := HwTy.El) 4 9 s = BitVec.ofNat 1 1 :=
  Eq.trans (Eq.symm (castRefl (transp (fun y _ => BitVec 1 = BitVec 1) (refl (BitVec 1)) h.1)
    (Pp.dHit (r := HwTy.El) 4 9 s))) h.2

-- one observed value, transported from (w, 1) to what D presents
def Qp.trF {X : Type} (s : PpSt 4 9 HwTy.El) (w : Nat) (F : BitVec 32 → BitVec 1 → X)
    (h : (Pp.dWord (r := HwTy.El) 4 9 s, Pp.dHit (r := HwTy.El) 4 9 s)
      = (BitVec.ofNat 32 w, BitVec.ofNat 1 1)) :
    F (Pp.dWord (r := HwTy.El) 4 9 s) (Pp.dHit (r := HwTy.El) 4 9 s)
      = F (BitVec.ofNat 32 w) (BitVec.ofNat 1 1) :=
  Qp.tr2 F h.1 (Qp.hitEq s w h)

-- assemble the six field lemmas into the observation
def Qp.glueG (s : PpSt 4 9 HwTy.El) (a : Arch) (w rd : Nat)
    (h1 : (Qp.GW s (BitVec.ofNat 32 w) (BitVec.ofNat 1 1)).npc = (Qp.spec a w rd).npc)
    (h2 : (Qp.GW s (BitVec.ofNat 32 w) (BitVec.ofNat 1 1)).pc = (Qp.spec a w rd).pc)
    (h3 : (Qp.GW s (BitVec.ofNat 32 w) (BitVec.ofNat 1 1)).v = (Qp.spec a w rd).v)
    (h4 : (Qp.GW s (BitVec.ofNat 32 w) (BitVec.ofNat 1 1)).we = (Qp.spec a w rd).we)
    (h5 : (Qp.GW s (BitVec.ofNat 32 w) (BitVec.ofNat 1 1)).rd = (Qp.spec a w rd).rd)
    (h6 : (Qp.GW s (BitVec.ofNat 32 w) (BitVec.ofNat 1 1)).val = (Qp.spec a w rd).val)
    (h : (Pp.dWord (r := HwTy.El) 4 9 s, Pp.dHit (r := HwTy.El) 4 9 s)
      = (BitVec.ofNat 32 w, BitVec.ofNat 1 1)) :
    Qp.Obs.mk
      (Qp.GW s (Pp.dWord (r := HwTy.El) 4 9 s) (Pp.dHit (r := HwTy.El) 4 9 s)).npc
      (Qp.GW s (Pp.dWord (r := HwTy.El) 4 9 s) (Pp.dHit (r := HwTy.El) 4 9 s)).pc
      (Qp.GW s (Pp.dWord (r := HwTy.El) 4 9 s) (Pp.dHit (r := HwTy.El) 4 9 s)).v
      (Qp.GW s (Pp.dWord (r := HwTy.El) 4 9 s) (Pp.dHit (r := HwTy.El) 4 9 s)).we
      (Qp.GW s (Pp.dWord (r := HwTy.El) 4 9 s) (Pp.dHit (r := HwTy.El) 4 9 s)).rd
      (Qp.GW s (Pp.dWord (r := HwTy.El) 4 9 s) (Pp.dHit (r := HwTy.El) 4 9 s)).val
    = Qp.Obs.mk
      (Qp.spec a w rd).npc (Qp.spec a w rd).pc (Qp.spec a w rd).v
      (Qp.spec a w rd).we (Qp.spec a w rd).rd (Qp.spec a w rd).val :=
  Qp.Obs.eq6 _ _ _ _ _ _ _ _ _ _ _ _
    (Eq.trans (Qp.trF s w (fun wd ht => (Qp.GW s wd ht).npc) h) h1)
    (Eq.trans (Qp.trF s w (fun wd ht => (Qp.GW s wd ht).pc) h) h2)
    (Eq.trans (Qp.trF s w (fun wd ht => (Qp.GW s wd ht).v) h) h3)
    (Eq.trans (Qp.trF s w (fun wd ht => (Qp.GW s wd ht).we) h) h4)
    (Eq.trans (Qp.trF s w (fun wd ht => (Qp.GW s wd ht).rd) h) h5)
    (Eq.trans (Qp.trF s w (fun wd ht => (Qp.GW s wd ht).val) h) h6)

-- `Qp.Claim`, in the form the field proofs build (`Qp.Obs.mk` is `Qp.obs`; `Qp.GW` is
-- `Qp.G`; the pair hypothesis is the same one). `Qp.Claim` and `Qp.ClaimG` are the same
-- proposition, not two theorems: only the spelling differs, so that the checker does
-- not re-evaluate the three cycles once per observed value.
def Qp.ClaimG (w rd : Nat) : Prop :=
  (a : Arch) → (m0 m1 m2 m3 : BitVec 9 → BitVec 8) → (ea eb mres rval : BitVec 32) →
  (h : (Pp.dWord (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval),
        Pp.dHit (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))
      = (BitVec.ofNat 32 w, BitVec.ofNat 1 1)) →
  Qp.Obs.mk
    (Qp.GW (Qp.at a w m0 m1 m2 m3 ea eb mres rval)
      (Pp.dWord (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))
      (Pp.dHit (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))).npc
    (Qp.GW (Qp.at a w m0 m1 m2 m3 ea eb mres rval)
      (Pp.dWord (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))
      (Pp.dHit (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))).pc
    (Qp.GW (Qp.at a w m0 m1 m2 m3 ea eb mres rval)
      (Pp.dWord (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))
      (Pp.dHit (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))).v
    (Qp.GW (Qp.at a w m0 m1 m2 m3 ea eb mres rval)
      (Pp.dWord (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))
      (Pp.dHit (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))).we
    (Qp.GW (Qp.at a w m0 m1 m2 m3 ea eb mres rval)
      (Pp.dWord (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))
      (Pp.dHit (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))).rd
    (Qp.GW (Qp.at a w m0 m1 m2 m3 ea eb mres rval)
      (Pp.dWord (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))
      (Pp.dHit (r := HwTy.El) 4 9 (Qp.at a w m0 m1 m2 m3 ea eb mres rval))).val
    = Qp.Obs.mk
    (Qp.spec a w rd).npc (Qp.spec a w rd).pc (Qp.spec a w rd).v
    (Qp.spec a w rd).we (Qp.spec a w rd).rd (Qp.spec a w rd).val

