import Rv.Golem.Bus
import Rv.Doom
import Rv.Pipe
-- The pipelined core in the machine (`Doom.pipeStep`, `Doom.pipeCore`, `doomFull`) and
-- the machine's simple-DDR simulation top (`simTop`). They are kept out of Rv.Doom so
-- that a test which only needs the multi-cycle machine (src/Rv/GolemSim.wiz) does not
-- compile the pipeline's large state.
--
-- the pipelined core (src/Rv/Pipe.wiz); events: an instruction retired, a bus access, E
-- waiting for a load or product in M, the divider, the front end waiting (a miss, a
-- restart)
def Doom.pipeStep {r : HwTy → Type} [Hw r] (s : PpSt 5 12 r) (x : CIn r) : r (HwTy.prod (PpSt.code 5 12) COut.code) :=
  let cr := pipeStep 5 12 .true s x.i;
  let ω e := s.e;
  let ω m := s.m;
  let wait := gate e.v (gate (Hw.not s.fe.rdr) e.lu);
  Hw.pair (PpSt.pack 5 12 (Pp.reset 5 12 x.rst (PpSt.unpack 5 12 (Hw.fst cr))))
    (COut.pack (COut.mk (Out.unpack (Hw.snd cr)) (CEv.mk (Hw.and s.rr.v (Hw.not s.rr.miss)) s.bus.act wait s.dv.on
      (Hw.not (isK s.fe.fz 0)))))
def Doom.pipeCore (prog : List Nat) : Circuit CIn.code COut.code :=
  Circuit.bundled (PpSt.bundle 5 12) CIn.bundle COut.bundle (PpSt.init 5 12 prog) Doom.pipeStep

def doomFull (prog : List Nat) : Circuit DIn.code DOut.code := doomSys .true (Doom.pipeCore prog)

------------------------------------------------------------------------------------
-- For simulation: the machine at half rate, the adapter, and in place of the cache and
-- DDR a memory that answers a request two cycles after it is made (a word memory of
-- 2^ab words; addresses wrap).

structure SimDdr (ab : Nat) (r : HwTy → Type) where
  m : r (HwTy.mem ab 32)
  wait : r B2
  deriving Bundle

structure SimIn (r : HwTy → Type) where
  uart_rx : r W1
  deriving Bundle

def ddrModel {r : HwTy → Type} [Hw r] (ab : Nat) (s : SimDdr ab r) (q : CacheReq r) : r (HwTy.prod (SimDdr.code ab) CacheResp.code) :=
  let go := Hw.and q.valid (isK s.wait 2);
  let ix : r (HwTy.bits ab) := Hw.slice 2 ab q.addr;
  let old := Hw.memRead s.m ix;
  let ml := fun (l : Nat) => Hw.mux (bitOf l q.wstrb) (Hw.slice (8 * l) 8 q.wdata) (Hw.slice (8 * l) 8 old : r W8);
  let nw : r B32 := Hw.cat (ml 3) (Hw.cat (ml 2) (Hw.cat (ml 1) (ml 0)));
  Hw.pair
    (SimDdr.pack ab (SimDdr.mk (Hw.memWrite s.m (Hw.and go q.we) ix nw)
      (Hw.mux q.valid (Hw.mux go (Hw.lit 2 0) (inc s.wait)) (Hw.lit 2 0))))
    (CacheResp.pack (CacheResp.mk go (Hw.and go (Hw.not q.we)) old))

structure SimOut (r : HwTy → Type) where
  uart_tx : r W1
  led : r B4
  ja : r W8
  jb : r W8
  deriving Bundle

-- (the pipelined machine at the full rate)
def simTop (ab : Nat) (prog : List Nat) : Circuit SimIn.code SimOut.code :=
  let ω h := doomFull prog;
  Circuit.mk (HwTy.prod h.st (HwTy.prod BusA.code (SimDdr.code ab)))
    (h.init, (Bundle.toEl BusA.bundle BusA.init, Bundle.toEl (SimDdr.bundle ab)
      (SimDdr.mk (fun (a : BitVec ab) => BitVec.ofNat 32 0) (BitVec.ofNat 2 0))))
    (fun s x =>
      let hs := Hw.fst s;
      let ω bs := BusA.unpack (Hw.fst (Hw.snd s));
      let ω ds := SimDdr.unpack ab (Hw.snd (Hw.snd s));
      let rx := (SimIn.unpack x).uart_rx;
      let quiet := DIn.pack (DIn.mk rx (Hw.lit 4 0) (Hw.lit 1 0) (Hw.lit 1 0) (Hw.lit 32 0) (Hw.lit 2 1) (Hw.lit 32 0) (Hw.lit 32 0));
      let ω o0 := DOut.unpack (Hw.snd (Circuit.inst h hs quiet));
      let ω q := CacheReq.unpack (Hw.fst (Hw.snd (busStep bs o0.valid o0.pend o0.we o0.addr o0.wdata o0.wstrb o0.aop o0.af5
        (CacheResp.mk (Hw.lit 1 0) (Hw.lit 1 0) (Hw.lit 32 0)))));
      let dr := ddrModel ab ds q;
      let ω resp := CacheResp.unpack (Hw.snd dr);
      let br := busStep bs o0.valid o0.pend o0.we o0.addr o0.wdata o0.wstrb o0.aop o0.af5 resp;
      let ω toCore := CacheResp.unpack (Hw.snd (Hw.snd br));
      let hr := Circuit.inst h hs (DIn.pack (DIn.mk rx (Hw.lit 4 0) toCore.ready toCore.rvalid toCore.rdata (Hw.lit 2 1) (Hw.lit 32 0) (Hw.lit 32 0)));
      let ω o := DOut.unpack (Hw.snd hr);
      Hw.pair (Hw.pair (Hw.fst hr) (Hw.pair (Hw.fst br) (Hw.fst dr)))
        (SimOut.pack (SimOut.mk o.uart_tx o.led o.ja o.jb)))
