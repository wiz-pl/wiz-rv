import Rv.Golem
import Rv.Golem.Board
import Rv.Golem.FourProg
import Rv.Asm
-- golem's board circuits: `golem`, `golemMc` and the four-hart variants (which always
-- use the four-hart boot/park image, src/Rv/Golem/FourProg.wiz, whatever --boot says) for
-- `Timing.arty`, in the wrapper
-- `Verilog.emitTop` builds from `GBoard.clocking`. The board's values (boot images,
-- clocking, pins, XDC, reset domains, the check) are in src/Rv/Golem/Board.wiz, which
-- does not import the SoC; this module is only what elaborates it.

inductive GBoard.Variant where
  | full      -- golem: the pipelined core at 100 MHz
  | mc        -- golemMc: the multi-cycle core at 50 MHz effective
  | four      -- golem_four: four multi-cycle harts, shared peripherals, per-hart L1
  | fourNocache -- golem_four_nol1: the same with every hart's L1 disabled

def GBoard.Variant.name : GBoard.Variant → String
  | .full => "golem"
  | .mc => "golem_mc"
  | .four => "golem_four"
  | .fourNocache => "golem_four_nol1"

def GBoard.Variant.circuit (v : GBoard.Variant) (boot : GBoard.Boot) :
    Circuit GIn.code (HwTy.prod Ddr3Pads.code GOut.code) :=
  match v with
  | .full => Golem.golem Timing.arty (GBoard.Boot.prog boot)
  | .mc => Golem.golemMc Timing.arty (GBoard.Boot.prog boot)
  | .four => Golem.four Timing.arty G4.allL1 (Asm.assemble FProg.four)
  | .fourNocache => Golem.four Timing.arty G4.noL1 (Asm.assemble FProg.four)

def GBoard.Variant.xdc (v : GBoard.Variant) : String :=
  match v with
  | .four => GBoard.xdc20
  | .fourNocache => GBoard.xdc20
  | .full => GBoard.xdc
  | .mc => GBoard.xdc

-- the timing report's expected line: 50 MHz for the enabled-every-other-cycle harts
def GBoard.Variant.target (v : GBoard.Variant) : String :=
  match v with
  | .four => "PASS at 50.00 MHz"
  | .fourNocache => "PASS at 50.00 MHz"
  | .full => "PASS at 100.00 MHz"
  | .mc => "PASS at 100.00 MHz"

def GBoard.Variant.netlist (v : GBoard.Variant) (boot : GBoard.Boot) : Netlist :=
  Circuit.netlist (GBoard.Variant.name v) (GBoard.Variant.circuit v boot)

def GBoard.variantOf (s : String) : Option GBoard.Variant :=
  match Hdl.strEq s "golem", Hdl.strEq s "mc", Hdl.strEq s "golem_mc" with
  | .true, _, _ => .some .full
  | _, .true, _ => .some .mc
  | _, _, .true => .some .mc
  | _, _, _ => match Hdl.strEq s "four", Hdl.strEq s "golem_four" with
    | .true, _ => .some .four
    | _, .true => .some .four
    | _, _ => match Hdl.strEq s "four_nol1", Hdl.strEq s "four_nocache" with
      | .true, _ => .some .fourNocache
      | _, .true => .some .fourNocache
      | _, _ => .none

def GBoard.variantsOf (s : String) : Option (List GBoard.Variant) :=
  match Hdl.strEq s "both" with
  | .true => .some (.cons .full (.cons .mc .nil))
  | .false => match GBoard.variantOf s with
    | .some v => .some (.cons v .nil)
    | .none => .none
