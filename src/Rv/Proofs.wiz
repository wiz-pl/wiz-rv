import Rv.Core
import Rv.Asm
-- Kernel-checked single-instruction proofs: the RV32E core (16 registers, 2 KB), started
-- in its decode phase on an instruction, is after two cycles where the specification's
-- `Rv.exec` says: in decode again, with the specification's PC and the specification's
-- value in rd. The architectural state is symbolic (any PC, any registers, any memory,
-- any leftovers in the core's other registers); the instruction is a fixed word.
--
-- What goes through by `rfl` and what does not: FINDINGS.md, P1.

def Pf.wb : Nat := 9
def Pf.cfg : Cfg := Cfg.rv32e 11

-- the core's register file holding the architectural registers
def Pf.rf (a : Arch) : BitVec 4 → BitVec 32 := fun (i : BitVec 4) => a.regs (BitVec.ofNat 5 i.toNat)

-- the core in its decode phase on the word `w`, at the architectural state `a`
def Pf.at (a : Arch) (w : Nat) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (x1 x2 acc : BitVec 32) (cnt srd : BitVec 5)
    (sf3 : BitVec 3) (slo : BitVec 2) : St 4 9 HwTy.El :=
  St.mk (BitVec.ofNat 3 Ph.d) a.pc
    (BitVec.ofNat 8 (Rv.bits w 0 8)) (BitVec.ofNat 8 (Rv.bits w 8 8)) (BitVec.ofNat 8 (Rv.bits w 16 8)) (BitVec.ofNat 8 (Rv.bits w 24 8))
    m0 m1 m2 m3 (Pf.rf a) (Pf.rf a) x1 x2 acc cnt srd sf3 slo (BitVec.ofNat 3 0)

def Pf.step (s : St 4 9 HwTy.El) : St 4 9 HwTy.El :=
  Bundle.ofEl (St.bundle 4 9) (coreStep (r := HwTy.El) 4 9 s (BitVec.ofNat 1 0)).1

-- what is compared: the phase, the PC, register rd (core: its register file; spec: x[rd])
def Pf.core (s : St 4 9 HwTy.El) (rd : Nat) : BitVec 3 × BitVec 32 × BitVec 32 :=
  (s.ph, s.pc, s.rfa (BitVec.ofNat 4 rd))
def Pf.spec (a : Arch) (w rd : Nat) : BitVec 3 × BitVec 32 × BitVec 32 :=
  (BitVec.ofNat 3 Ph.d, (Rv.exec Pf.cfg a w).pc, Rv.reg (Rv.exec Pf.cfg a w) rd)

-- the instruction words
def Pf.w (i : Asm) : Nat := Rv.wordAt (Asm.assemble (.cons i .nil)) 0


-- the four bytes the decode phase reads (from memory at PC), and those of a word
def Pf.Q : Type := BitVec 8 × BitVec 8 × BitVec 8 × BitVec 8
def Pf.fetchQ (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) : Pf.Q :=
  let ω ix : HwTy.El (HwTy.bits 9) := Hw.slice (r := HwTy.El) 2 9 a.pc;
  (Hw.memRead (r := HwTy.El) m0 ix, Hw.memRead (r := HwTy.El) m1 ix, Hw.memRead (r := HwTy.El) m2 ix, Hw.memRead (r := HwTy.El) m3 ix)
def Pf.bytes (w : Nat) : Pf.Q :=
  (BitVec.ofNat 8 (Rv.bits w 0 8), BitVec.ofNat 8 (Rv.bits w 8 8), BitVec.ofNat 8 (Rv.bits w 16 8), BitVec.ofNat 8 (Rv.bits w 24 8))

-- a state with other read data
def Pf.setQ (s : St 4 9 HwTy.El) (q : Pf.Q) : St 4 9 HwTy.El :=
  St.mk s.ph s.pc q.1 q.2.1 q.2.2.1 q.2.2.2 s.m0 s.m1 s.m2 s.m3 s.rfa s.rfb s.x1 s.x2 s.acc s.cnt s.srd s.sf3 s.slo s.trap

-- the execute cycle, as a function of the read data
def Pf.G (a : Arch) (w rd : Nat) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (x1 x2 acc : BitVec 32) (cnt srd : BitVec 5)
    (sf3 : BitVec 3) (slo : BitVec 2) (q : Pf.Q) : BitVec 3 × BitVec 32 × BitVec 32 :=
  Pf.core (Pf.step (Pf.setQ (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo)) q)) rd

-- The glue: if memory at PC holds the instruction and the execute cycle on it does what
-- the specification says, the two cycles from decode do. (For any `w`: the decode
-- cycle reads the memory at PC whatever the instruction.)
def Pf.ok (a : Arch) (w rd : Nat) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (x1 x2 acc : BitVec 32) (cnt srd : BitVec 5)
    (sf3 : BitVec 3) (slo : BitVec 2)
    (hE : Pf.G a w rd m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo (Pf.bytes w) = Pf.spec a w rd)
    (h : Pf.fetchQ a m0 m1 m2 m3 = Pf.bytes w) :
    Pf.core (Pf.step (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo))) rd = Pf.spec a w rd :=
  Eq.trans (Eq.congrArg (Pf.G a w rd m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo) h) hE

-- The claim for one instruction word `w` writing rd.
def Pf.Claim (w rd : Nat) : Prop :=
  (a : Arch) → (m0 m1 m2 m3 : BitVec 9 → BitVec 8) → (x1 x2 acc : BitVec 32) → (cnt srd : BitVec 5) → (sf3 : BitVec 3) → (slo : BitVec 2) →
  Pf.fetchQ a m0 m1 m2 m3 = Pf.bytes w →
  Pf.core (Pf.step (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo))) rd = Pf.spec a w rd

def Pf.xor_ok : Pf.Claim (Pf.w (A.xor 3 1 2)) 3 := fun a m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo h =>
  Pf.ok a (Pf.w (A.xor 3 1 2)) 3 m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo rfl h
def Pf.or_ok : Pf.Claim (Pf.w (A.or 7 14 9)) 7 := fun a m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo h =>
  Pf.ok a (Pf.w (A.or 7 14 9)) 7 m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo rfl h
def Pf.and_ok : Pf.Claim (Pf.w (A.and 15 15 1)) 15 := fun a m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo h =>
  Pf.ok a (Pf.w (A.and 15 15 1)) 15 m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo rfl h
def Pf.xori_ok : Pf.Claim (Pf.w (A.xori 2 5 (-1))) 2 := fun a m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo h =>
  Pf.ok a (Pf.w (A.xori 2 5 (-1))) 2 m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo rfl h
def Pf.ori_ok : Pf.Claim (Pf.w (A.ori 4 4 1365)) 4 := fun a m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo h =>
  Pf.ok a (Pf.w (A.ori 4 4 1365)) 4 m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo rfl h
def Pf.andi_ok : Pf.Claim (Pf.w (A.andi 9 3 (-2048))) 9 := fun a m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo h =>
  Pf.ok a (Pf.w (A.andi 9 3 (-2048))) 9 m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo rfl h
def Pf.lui_ok : Pf.Claim (Pf.w (A.lui 1 74565)) 1 := fun a m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo h =>
  Pf.ok a (Pf.w (A.lui 1 74565)) 1 m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo rfl h
def Pf.auipc_ok : Pf.Claim (Pf.w (A.auipc 6 1048575)) 6 := fun a m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo h =>
  Pf.ok a (Pf.w (A.auipc 6 1048575)) 6 m0 m1 m2 m3 x1 x2 acc cnt srd sf3 slo rfl h
