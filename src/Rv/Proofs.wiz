import Rv.Core
import Rv.Asm
-- Kernel-checked single-instruction proofs: the RV32E core (16 registers, 2 KB), started
-- in its decode phase on an instruction, is after two cycles where the specification's
-- `Rv.exec` says: in decode again, with the specification's PC and the specification's
-- value in rd. The architectural state is symbolic (any PC, any registers, any memory,
-- any leftovers in the core's other registers); the instruction is a fixed word.
--
-- The trap half (`Pf.TrapClaimAt`): with no handler (mtvec 0), a trapping instruction
-- stops with the specification's cause, tval and epc. Trap entry into a handler,
-- interrupts, MRET, WFI and a CSR instruction are src/Rv/TrapProofs (one file per claim, checked by grail build). ECALL, EBREAK and an illegal instruction are proved for a fully
-- symbolic architectural state; the misaligned load and store, whose tval is an
-- address, are proved from a state with a concrete x1 (the PC, memory and the other
-- registers stay symbolic), because the core's address adder and the specification's
-- `BitVec.add` are not yet bridged for a symbolic operand (rv-core-proofs.md §6 item 1).
--
-- With the C extension a 32-bit instruction at `pc[1] = 1` needs a second fetch (the
-- `J` phase), so these two-cycle claims are about an aligned 32-bit instruction: the
-- core state's `al` (bit 1 of the instruction's PC) is 0. That is the case the claims
-- are about; `tests/lockstep.wiz` and `tests/plockstep.wiz` cover the unaligned one.
-- With `al` 0 the core's second-fetch test (`need2`, a `gate`) is 0 for any word, so the
-- glue (`Pf.ok`, for a symbolic word) never reduces the C expansion; FINDINGS.md H12.
--
-- What goes through by `rfl` and what does not: FINDINGS.md, P1.

def Pf.wb : Nat := 9
def Pf.cfg : Cfg := Cfg.rv32e 11

-- the core's register file holding the architectural registers
def Pf.rf (a : Arch) : BitVec 4 → BitVec 32 := fun (i : BitVec 4) => a.regs (BitVec.ofNat 5 i.toNat)

-- the core in its decode phase on the word `w`, at the architectural state `a`, with
-- the given mtval and CSR file (`Pf.at`: 0 and the reset CSRs, no handler)
def Pf.atX (a : Arch) (w : Nat) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (x1 x2 acc dv rm : BitVec 32) (cnt srd : BitVec 5)
    (sf3 : BitVec 3) (slo : BitVec 2) (sio : BitVec 1) (tv : BitVec 32) (cs : CsrFile HwTy.El) : CoreSt 4 9 HwTy.El :=
  CoreSt.mk (BitVec.ofNat 4 Ph.d) a.pc
    (BitVec.ofNat 8 (Rv.bits w 0 8)) (BitVec.ofNat 8 (Rv.bits w 8 8)) (BitVec.ofNat 8 (Rv.bits w 16 8)) (BitVec.ofNat 8 (Rv.bits w 24 8))
    m0 m1 m2 m3 (Pf.rf a) (Pf.rf a) x1 x2 acc dv rm cnt srd sf3 slo sio (BitVec.ofNat 3 0)
    tv
    (BitVec.ofNat 32 0) (BitVec.ofNat 1 0) (BitVec.ofNat 32 0) (BitVec.ofNat 1 0) (BitVec.ofNat 32 0)
    (BitVec.ofNat 4 0) (BitVec.ofNat 4 0) (BitVec.ofNat 1 0)
    (BitVec.ofNat 32 0) (BitVec.ofNat 128 0) (BitVec.ofNat (L1.tagW 9) 0)
    (fun (a : BitVec (L1.bits 9)) => BitVec.ofNat 128 0) (fun (a : BitVec (L1.bits 9)) => BitVec.ofNat (L1.tagW 9) 0)
    (BitVec.ofNat 1 0) (BitVec.ofNat 1 0) (BitVec.ofNat 2 0) (BitVec.ofNat 1 0) (BitVec.ofNat 128 0) (BitVec.ofNat 32 0) (BitVec.ofNat 1 0)
    (BitVec.ofNat 32 0) (BitVec.ofNat 1 0) (BitVec.ofNat 32 0) (BitVec.ofNat 32 0) (BitVec.ofNat 32 0)
    (BitVec.ofNat 5 0) (BitVec.ofNat 2 0) (BitVec.ofNat 2 0) (BitVec.ofNat 5 0) cs
    (BitVec.ofNat 32 0) (BitVec.ofNat 32 0) (BitVec.ofNat 1 0) (BitVec.ofNat 1 0)

def Pf.at (a : Arch) (w : Nat) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (x1 x2 acc dv rm : BitVec 32) (cnt srd : BitVec 5)
    (sf3 : BitVec 3) (slo : BitVec 2) (sio : BitVec 1) : CoreSt 4 9 HwTy.El :=
  Pf.atX a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio (BitVec.ofNat 32 0) CsrFile.init

def Pf.step (s : CoreSt 4 9 HwTy.El) : CoreSt 4 9 HwTy.El :=
  Bundle.ofEl (CoreSt.bundle 4 9) (coreStep (r := HwTy.El) 4 9 .false s In.idle).1

-- what is compared: the PC and register rd (core: its register file; spec: x[rd]).
-- (Not the phase: after the execute cycle it is D, or P when the next PC is in DDR,
-- which depends on the symbolic PC.)
def Pf.core (s : CoreSt 4 9 HwTy.El) (rd : Nat) : BitVec 32 × BitVec 32 :=
  (s.pc, s.rfa (BitVec.ofNat 4 rd))
def Pf.spec (a : Arch) (w rd : Nat) : BitVec 32 × BitVec 32 :=
  ((Rv.exec Pf.cfg a w).pc, Rv.reg (Rv.exec Pf.cfg a w) rd)

-- the instruction words
def Pf.w (i : Asm) : Nat := Rv.wordAt (Asm.assemble (.cons i .nil)) 0


-- the four bytes the decode phase reads (from memory at PC), and those of a word
def Pf.Q : Type := BitVec 8 × BitVec 8 × BitVec 8 × BitVec 8
def Pf.fetchQ (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) : Pf.Q :=
  let ω ix : HwTy.El (HwTy.bits 9) := Hw.slice (r := HwTy.El) 2 9 a.pc;
  (Hw.memRead (r := HwTy.El) m0 ix, Hw.memRead (r := HwTy.El) m1 ix, Hw.memRead (r := HwTy.El) m2 ix, Hw.memRead (r := HwTy.El) m3 ix)
def Pf.bytes (w : Nat) : Pf.Q :=
  (BitVec.ofNat 8 (Rv.bits w 0 8), BitVec.ofNat 8 (Rv.bits w 8 8), BitVec.ofNat 8 (Rv.bits w 16 8), BitVec.ofNat 8 (Rv.bits w 24 8))

-- a state with other read data
def Pf.setQ (s : CoreSt 4 9 HwTy.El) (q : Pf.Q) : CoreSt 4 9 HwTy.El :=
  CoreSt.mk s.ph s.pc q.1 q.2.1 q.2.2.1 q.2.2.2 s.m0 s.m1 s.m2 s.m3 s.rfa s.rfb s.x1 s.x2 s.acc s.dv s.rm s.cnt s.srd s.sf3 s.slo s.sio s.trap s.tval s.busq s.fromBus s.badr s.bwe s.bwd s.bst s.bret s.bsent s.ra s.l1q s.l1t s.l1d s.l1tag s.fromL1 s.rmode s.rk s.rgap s.rbuf s.rline s.bnew s.resv s.resOk s.amoA s.amoD s.amoO s.sf5 s.ak s.baop s.baf5 s.csr
    s.w1 s.ins s.half s.al

-- The glue. It goes in steps, none of which compares two cycles of the core with an
-- unknown instruction: equality at a record type is a record of equations, so inferring
-- `Eq.trans`'s middle term (or comparing the two sides) would put both cycles in normal
-- form, which with the CSR file did not fit in 8 GB (FINDINGS.md H13). `Pf.eta` (a state
-- is itself with its own read data put back: η, for any state), a one-cycle `rfl` that
-- compares only the decode cycle's read data (`Pf.readQ`), and congruence
-- (`Pf.glueG`, nothing evaluated), with every implicit argument given.
def Pf.eta (s : CoreSt 4 9 HwTy.El) : s = Pf.setQ s (s.q0, s.q1, s.q2, s.q3) := rfl

-- any observation `F` of a state is `F` of that state with its read data replaced by
-- data equal to them (for any state and data)
def Pf.glueG {0 T : Type} (F : CoreSt 4 9 HwTy.El → T) (D : CoreSt 4 9 HwTy.El) (q : Pf.Q)
    (hq : (D.q0, D.q1, D.q2, D.q3) = q) : F D = F (Pf.setQ D q) :=
  Eq.trans (A := T) (a := F D) (b := F (Pf.setQ D (D.q0, D.q1, D.q2, D.q3))) (c := F (Pf.setQ D q))
    (Eq.congrArg (A := CoreSt 4 9 HwTy.El) (B := T) F
      (a := D) (b := Pf.setQ D (D.q0, D.q1, D.q2, D.q3)) (Pf.eta D))
    (Eq.congrArg (A := Pf.Q) (B := T) (fun (q' : Pf.Q) => F (Pf.setQ D q'))
      (a := (D.q0, D.q1, D.q2, D.q3)) (b := q) hq)

-- the glue's shape: `F D = o` from the read data and `F` at the given read data
def Pf.glueO {0 T : Type} (F : CoreSt 4 9 HwTy.El → T) (D : CoreSt 4 9 HwTy.El) (q : Pf.Q) (o : T)
    (hq : (D.q0, D.q1, D.q2, D.q3) = q) (hE : F (Pf.setQ D q) = o) : F D = o :=
  Eq.trans (A := T) (a := F D) (b := F (Pf.setQ D q)) (c := o) (Pf.glueG F D q hq) hE

-- the read data of a decode cycle `D`, given that they are memory at the PC and memory
-- there holds the word
def Pf.readW (D : CoreSt 4 9 HwTy.El) (f : Pf.Q) (w : Nat)
    (hr : (D.q0, D.q1, D.q2, D.q3) = f) (h : f = Pf.bytes w) : (D.q0, D.q1, D.q2, D.q3) = Pf.bytes w :=
  Eq.trans (A := Pf.Q) (a := (D.q0, D.q1, D.q2, D.q3)) (b := f) (c := Pf.bytes w) hr h

-- the decode cycle from `Pf.at` reads memory at the PC (one cycle; only the read data
-- compared)
def Pf.readQ (a : Arch) (w : Nat) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (x1 x2 acc dv rm : BitVec 32) (cnt srd : BitVec 5)
    (sf3 : BitVec 3) (slo : BitVec 2) (sio : BitVec 1) :
    ((Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio)).q0,
     (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio)).q1,
     (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio)).q2,
     (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio)).q3) = Pf.fetchQ a m0 m1 m2 m3 := rfl

-- If memory at PC holds the instruction and the execute cycle on it does what the
-- specification says, the two cycles from decode do. (For any `w`.)
def Pf.ok (a : Arch) (w rd : Nat) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (x1 x2 acc dv rm : BitVec 32) (cnt srd : BitVec 5)
    (sf3 : BitVec 3) (slo : BitVec 2) (sio : BitVec 1)
    (hE : Pf.core (Pf.step (Pf.setQ (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio)) (Pf.bytes w))) rd = Pf.spec a w rd)
    (h : Pf.fetchQ a m0 m1 m2 m3 = Pf.bytes w) :
    Pf.core (Pf.step (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio))) rd = Pf.spec a w rd :=
  Pf.glueO (T := BitVec 32 × BitVec 32) (fun (s : CoreSt 4 9 HwTy.El) => Pf.core (Pf.step s) rd)
    (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio)) (Pf.bytes w) (Pf.spec a w rd)
    (Pf.readW (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio)) (Pf.fetchQ a m0 m1 m2 m3) w
      (Pf.readQ a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio) h)
    hE

-- The claim for one instruction word `w` writing rd.
def Pf.Claim (w rd : Nat) : Prop :=
  (a : Arch) → (m0 m1 m2 m3 : BitVec 9 → BitVec 8) → (x1 x2 acc dv rm : BitVec 32) → (cnt srd : BitVec 5) → (sf3 : BitVec 3) → (slo : BitVec 2) → (sio : BitVec 1) →
  Pf.fetchQ a m0 m1 m2 m3 = Pf.bytes w →
  Pf.core (Pf.step (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio))) rd = Pf.spec a w rd

------------------------------------------------------------------------------------
-- The trap-state claim: cause, tval and epc

-- what a core state shows of its trap (in H, the PC is the epc: it stopped on the
-- trapping instruction and does not move), and what the specification says
def Pf.trapCore (s : CoreSt 4 9 HwTy.El) : Nat × BitVec 32 × BitVec 32 :=
  (s.trap.toNat, s.tval, s.pc)
def Pf.trapSpec (a : Arch) (w : Nat) : Nat × BitVec 32 × BitVec 32 :=
  let a' := Rv.exec Pf.cfg a w; (a'.trap, a'.tval, a'.epc)

def Pf.trapOk (a : Arch) (w : Nat) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (x1 x2 acc dv rm : BitVec 32) (cnt srd : BitVec 5)
    (sf3 : BitVec 3) (slo : BitVec 2) (sio : BitVec 1)
    (hE : Pf.trapCore (Pf.step (Pf.setQ (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio)) (Pf.bytes w))) = Pf.trapSpec a w)
    (h : Pf.fetchQ a m0 m1 m2 m3 = Pf.bytes w) :
    Pf.trapCore (Pf.step (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio))) = Pf.trapSpec a w :=
  Pf.glueO (T := Nat × BitVec 32 × BitVec 32) (fun (s : CoreSt 4 9 HwTy.El) => Pf.trapCore (Pf.step s))
    (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio)) (Pf.bytes w) (Pf.trapSpec a w)
    (Pf.readW (Pf.step (Pf.at a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio)) (Pf.fetchQ a m0 m1 m2 m3) w
      (Pf.readQ a w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio) h)
    hE

-- The trap-state claim for `w`, from a state built by `p` (the traps that record an
-- address need a concrete register value; see `Pf.x1is2`). These are the halting
-- traps: `p` leaves no handler (`Pf.noVec`: the reset CSRs, mtvec 0, as the core's
-- `Pf.at` has them); trap entry into a handler is src/Rv/TrapProofs (one file per claim, checked by grail build).
def Pf.TrapClaimAt (p : Arch → Arch) (w : Nat) : Prop :=
  (a : Arch) → (m0 m1 m2 m3 : BitVec 9 → BitVec 8) → (x1 x2 acc dv rm : BitVec 32) → (cnt srd : BitVec 5) → (sf3 : BitVec 3) → (slo : BitVec 2) → (sio : BitVec 1) →
  Pf.fetchQ (p a) m0 m1 m2 m3 = Pf.bytes w →
  Pf.trapCore (Pf.step (Pf.step (Pf.at (p a) w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio))) = Pf.trapSpec (p a) w

-- no handler: the reset CSRs (mtvec 0); everything else symbolic
def Pf.noVec (a : Arch) : Arch := Rv.withCsr a Csr.init

-- x1 = 2, the other registers 0, no handler: the PC, memory, trap state and ports stay
-- symbolic
def Pf.x1is2 (a : Arch) : Arch :=
  Arch.mk a.pc (fun (j : BitVec 5) => if BitVec.beq j (BitVec.ofNat 5 1) then Rv.w32 2 else Rv.w32 0)
    a.mem a.trap a.tval a.epc Csr.init a.irq a.out a.inp a.res

-- ECALL and EBREAK: tval 0; epc the instruction's PC; nothing else moves
def Pf.ecall_trap : Pf.TrapClaimAt Pf.noVec (Pf.w A.ecall) := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.trapOk (Pf.noVec a) (Pf.w A.ecall) m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
def Pf.ebreak_trap : Pf.TrapClaimAt Pf.noVec (Pf.w A.ebreak) := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.trapOk (Pf.noVec a) (Pf.w A.ebreak) m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
-- an illegal instruction: tval is the instruction word (here 0xffffffff)
def Pf.illegal_trap : Pf.TrapClaimAt Pf.noVec 4294967295 := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.trapOk (Pf.noVec a) 4294967295 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
-- a misaligned load (x1 = 2, LW at 2): tval is the effective address
def Pf.load_trap : Pf.TrapClaimAt Pf.x1is2 (Pf.w (A.lw 2 0 1)) := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.trapOk (Pf.x1is2 a) (Pf.w (A.lw 2 0 1)) m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
-- a misaligned store (x1 = 2, SW at 2): tval is the effective address
def Pf.store_trap : Pf.TrapClaimAt Pf.x1is2 (Pf.w (A.sw 2 0 1)) := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.trapOk (Pf.x1is2 a) (Pf.w (A.sw 2 0 1)) m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
-- With C a jump target need only be a multiple of 2, so JALR to x1 = 2 is not a trap
-- (and no JAL/JALR/branch encoding can make one: JALR clears bit 0, the offsets are
-- even). What is proved instead: the core's next PC is the specification's, 2, and x0
-- stays 0.
def Pf.ClaimAt (p : Arch → Arch) (w rd : Nat) : Prop :=
  (a : Arch) → (m0 m1 m2 m3 : BitVec 9 → BitVec 8) → (x1 x2 acc dv rm : BitVec 32) → (cnt srd : BitVec 5) → (sf3 : BitVec 3) → (slo : BitVec 2) → (sio : BitVec 1) →
  Pf.fetchQ (p a) m0 m1 m2 m3 = Pf.bytes w →
  Pf.core (Pf.step (Pf.step (Pf.at (p a) w m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio))) rd = Pf.spec (p a) w rd
def Pf.jump_half : Pf.ClaimAt Pf.x1is2 (Pf.w (A.jalr 0 1 0)) 0 := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.ok (Pf.x1is2 a) (Pf.w (A.jalr 0 1 0)) 0 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h

def Pf.xor_ok : Pf.Claim (Pf.w (A.xor 3 1 2)) 3 := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.ok a (Pf.w (A.xor 3 1 2)) 3 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
def Pf.or_ok : Pf.Claim (Pf.w (A.or 7 14 9)) 7 := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.ok a (Pf.w (A.or 7 14 9)) 7 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
def Pf.and_ok : Pf.Claim (Pf.w (A.and 15 15 1)) 15 := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.ok a (Pf.w (A.and 15 15 1)) 15 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
def Pf.xori_ok : Pf.Claim (Pf.w (A.xori 2 5 (-1))) 2 := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.ok a (Pf.w (A.xori 2 5 (-1))) 2 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
def Pf.ori_ok : Pf.Claim (Pf.w (A.ori 4 4 1365)) 4 := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.ok a (Pf.w (A.ori 4 4 1365)) 4 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
def Pf.andi_ok : Pf.Claim (Pf.w (A.andi 9 3 (-2048))) 9 := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.ok a (Pf.w (A.andi 9 3 (-2048))) 9 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
def Pf.lui_ok : Pf.Claim (Pf.w (A.lui 1 74565)) 1 := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.ok a (Pf.w (A.lui 1 74565)) 1 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
def Pf.auipc_ok : Pf.Claim (Pf.w (A.auipc 6 1048575)) 6 := fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
  Pf.ok a (Pf.w (A.auipc 6 1048575)) 6 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio rfl h
