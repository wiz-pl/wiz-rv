import Rv.Core
import Hdl.Uart
-- The board's UART: `Hdl.Uart` at this machine's counter width (`Uart.cntW10`, 1 … 1024
-- cycles per bit: 866 at 100 MHz, 433 at half rate), plus the one-bit vocabulary the
-- design is written in (wiz-arty's src/Arty/Gates.wiz).
--
-- `Hdl.Uart` is this module's design, lifted into the library: the iCEstick UART with
-- the board parts removed, the receiver's two-flop input synchroniser inside `Rx`, a
-- `busy` output on each part, and the clocks-per-bit counter width as a parameter
-- (`Uart.txCw`/`Uart.rxCw`, `Uart.tx10C`/`Uart.rx10C`). A transmitter's `busy` is an
-- output of its step, so a core that must not store while a byte is going out asks the
-- state directly: `txIdle`.

def hi {r : HwTy → Type} [Hw r] : r W1 := Hw.lit 1 1
def lo {r : HwTy → Type} [Hw r] : r W1 := Hw.lit 1 0
def band {r : HwTy → Type} [Hw r] (a b : r W1) : r W1 := Hw.and a b
def bor {r : HwTy → Type} [Hw r] (a b : r W1) : r W1 := Hw.or a b
def bnot {r : HwTy → Type} [Hw r] (a : r W1) : r W1 := Hw.not a
def eqLit {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) (k : Nat) : r W1 := Hw.eq x (Hw.lit n k)
def inc {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) : r (HwTy.bits n) := Hw.add x (Hw.lit n 1)
def dec {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) : r (HwTy.bits n) := Hw.sub x (Hw.lit n 1)

-- the transmitter is idle (no bit periods left), from the state alone
def txIdle {r : HwTy → Type} [Hw r] (s : Uart.Tx 10 r) : r W1 := s.left === Hw.ofNat 0
