import Rv.Core
import Hdl.UartBoard
-- The RV boards' UART: the shared 8N1 UART of the Wiz library (`lib/Hdl/Uart.wiz`),
-- through its board API (`lib/Hdl/UartBoard.wiz`). Nothing of the protocol is defined
-- here. This page fixes the width of the clocks-per-bit counter (ten bits, 1 … 1024
-- cycles per bit, as the Arty's 100 MHz / 866 needs), declares the bundles the boards
-- are written against (the shapes of `UartB.Tx`, `UartB.Rx`, `UartB.Sync`, …), and
-- forwards every step function to the shared implementation. It was taken from
-- wiz-arty's `src/Arty/Uart.wiz`; both are now the same shared implementation.
--
-- Why the bundles are declared here rather than aliased: Wiz structures are structural,
-- so these declarations *are* `Uart.Tx 10`, `Uart.RxBits 10`, `Uart.Sync`, … (same
-- fields, same order), and every part below takes them directly; a meta-level alias is
-- not a structure, so `deriving Bundle` of a design that has one of them as a field
-- could not see the nested `code`/`pack`/`unpack`.

------------------------------------------------------------------------------------
-- The small signal vocabulary the board modules share (they import this module for the
-- UART, and it has always carried these).

def B9 : HwTy := HwTy.bits 9
def B10 : HwTy := HwTy.bits 10

def hi {r : HwTy → Type} [Hw r] : r W1 := Hw.lit 1 1
def lo {r : HwTy → Type} [Hw r] : r W1 := Hw.lit 1 0
def band {r : HwTy → Type} [Hw r] (a b : r W1) : r W1 := Hw.and a b
def bor {r : HwTy → Type} [Hw r] (a b : r W1) : r W1 := Hw.or a b
def bnot {r : HwTy → Type} [Hw r] (a : r W1) : r W1 := Hw.not a
def eqLit {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) (k : Nat) : r W1 := Hw.eq x (Hw.lit n k)
def inc {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) : r (HwTy.bits n) := Hw.add x (Hw.lit n 1)
def dec {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) : r (HwTy.bits n) := Hw.sub x (Hw.lit n 1)
def frame9 {r : HwTy → Type} [Hw r] (d : r W8) : r B9 := Hw.cat (Hw.lit 1 1) d
def shiftIn9 {r : HwTy → Type} [Hw r] (x : r B9) (b : r W1) : r B9 := Hw.cat b (Hw.slice 1 8 x)
def shiftIn8 {r : HwTy → Type} [Hw r] (x : r W8) (b : r W1) : r W8 := Hw.cat b (Hw.slice 1 7 x)

------------------------------------------------------------------------------------
-- The bundles (the shapes of the shared ones, at the boards' counter width).

structure UTx (r : HwTy → Type) where
  line : r W1
  left : r B4
  cnt : r B10
  sh : r B9
  deriving Bundle

structure Rx (r : HwTy → Type) where
  ph : r B4
  cnt : r B10
  sh : r W8
  deriving Bundle

structure Sync (r : HwTy → Type) where
  ff1 : r W1
  ff2 : r W1
  deriving Bundle

structure Byte (r : HwTy → Type) where
  valid : r W1
  data : r W8
  deriving Bundle

def UTx.init : UTx HwTy.El := Uart.Tx.init Uart.cntW10
def Rx.init : Rx HwTy.El := Uart.RxBits.init Uart.cntW10
def Sync.init : Sync HwTy.El := Uart.Sync.init

------------------------------------------------------------------------------------
-- The parts, as step functions (the shapes `Rv.Board`, `Rv.PBoard` and `Rv.Doom` are
-- written against).

def baudStep {r : HwTy → Type} [Hw r] (n : Nat) (c : r B10) : r (HwTy.prod B10 W1) :=
  UartB.baudStep Uart.cntW10 n c

def txIdle {r : HwTy → Type} [Hw r] (s : UTx r) : r W1 := UartB.txIdle Uart.cntW10 s

def txStep {r : HwTy → Type} [Hw r] (n : Nat) (s : UTx r) (start : r W1) (d : r W8) : r UTx.code :=
  UartB.txStep Uart.cntW10 n s start d

def syncStep {r : HwTy → Type} [Hw r] (s : Sync r) (pin : r W1) : r Sync.code :=
  Uart.syncStep s pin

def rxStep {r : HwTy → Type} [Hw r] (n : Nat) (s : Rx r) (rx : r W1) :
    r (HwTy.prod Rx.code Byte.code) :=
  UartB.rxStep Uart.cntW10 n s rx
