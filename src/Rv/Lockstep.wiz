import Rv.Core
import Rv.Asm
import Text
-- Lockstep simulation: the core (`core ab wb prog`, on values, cycle by cycle) against
-- the specification (`Rv.step`, instruction by instruction). Whenever the core is in its
-- execute phase it is at an instruction boundary (the registers are those before it), and its PC and every register (both
-- copies of the register file) must be the specification's; when it stops, its trap
-- code and PC; at the end, the bytes written to the output port and every byte of
-- memory.

def Ls.cfg (ab wb : Nat) : Cfg := Cfg.mk ab (wb + 2) .false
def Ls.cfgM (ab wb : Nat) (mx : Bool) : Cfg := Cfg.mk ab (wb + 2) mx

def Ls.hw {ω ab wb : Nat} (v : HwTy.El (CoreSt.code ab wb)) : CoreSt ab wb HwTy.El := Bundle.ofEl (CoreSt.bundle ab wb) v

-- the registers 1 … n - 1 that differ, as text
def Ls.regDiff (ab wb : Nat) (s : CoreSt ab wb HwTy.El) (a : Arch) : Nat → List String
  | .zero => .nil
  | .succ k =>
    let ω i := Nat.succ k;
    let ω hwA := (s.rfa (BitVec.ofNat ab i)).toNat;
    let ω hwB := (s.rfb (BitVec.ofNat ab i)).toNat;
    let ω sp := (Rv.reg a i).toNat;
    let ω here : List String := if Bool.and (Nat.beq hwA sp) (Nat.beq hwB sp) then .nil
      else .cons ("x" ++ Nat.repr i ++ ": core " ++ Nat.repr hwA ++ "/" ++ Nat.repr hwB ++ ", spec " ++ Nat.repr sp) .nil;
    List.append (Ls.regDiff ab wb s a k) here

def Ls.compare (ab wb : Nat) (s : CoreSt ab wb HwTy.El) (a : Arch) : List String :=
  List.append (if Nat.beq s.pc.toNat a.pc.toNat then .nil
      else .cons ("pc: core " ++ Nat.repr s.pc.toNat ++ ", spec " ++ Nat.repr a.pc.toNat) .nil)
    (Ls.regDiff ab wb s a (Rv.pow2 ab - 1))

-- the core's byte at address `x`
def Ls.byte (ab wb : Nat) (s : CoreSt ab wb HwTy.El) (x : Nat) : Nat :=
  let ω ix := BitVec.ofNat wb (Nat.div x 4);
  let ω l := Nat.mod x 4;
  (if Nat.beq l 0 then s.m0 ix else if Nat.beq l 1 then s.m1 ix else if Nat.beq l 2 then s.m2 ix else s.m3 ix).toNat

def Ls.memDiff (ab wb : Nat) (s : CoreSt ab wb HwTy.El) (a : Arch) : Nat → List String
  | .zero => .nil
  | .succ k =>
    let ω hw := Ls.byte ab wb s k;
    let ω sp := Rv.byte (Ls.cfg ab wb) a (Rv.w32 k);
    List.append (if Nat.beq hw sp then .nil
      else .cons ("mem[" ++ Nat.repr k ++ "]: core " ++ Nat.repr hw ++ ", spec " ++ Nat.repr sp) .nil)
      (Ls.memDiff ab wb s a k)

-- the result of a run
structure Ls.Result where
  cycles : Nat
  instrs : Nat
  trap : Nat
  out : List Nat          -- the core's output, in order
  problems : List String  -- empty: the core agreed with the specification throughout

def Ls.natsEq : List Nat → List Nat → Bool
  | .nil, .nil => .true
  | .cons a as, .cons b bs => Bool.and (Nat.beq a b) (Ls.natsEq as bs)
  | _, _ => .false

-- DDR bytes 0x40000000 … + n - 1 that differ
def Ls.ddrDiff (ddr : BitVec 32 → BitVec 8) (a : Arch) : Nat → List String
  | .zero => .nil
  | .succ k =>
    let ω x := Rv.w32 (1073741824 + k);
    let ω hw := (ddr x).toNat;
    let ω sp := (a.mem x).toNat;
    List.append (if Nat.beq hw sp then .nil
      else .cons ("ddr[" ++ Nat.repr k ++ "]: core " ++ Nat.repr hw ++ ", spec " ++ Nat.repr sp) .nil)
      (Ls.ddrDiff ddr a k)

def Ls.finish (ab wb : Nat) (s : CoreSt ab wb HwTy.El) (a : Arch) (cyc ins : Nat) (out : List Nat) (ddr : BitVec 32 → BitVec 8) (why : List String) : Ls.Result :=
  let ω o := List.reverse out;
  let ω outP : List String := if Ls.natsEq o (List.reverse a.out) then .nil else .cons "output differs" .nil;
  let ω trapP : List String := if Nat.beq s.trap.toNat a.trap then .nil
    else .cons ("trap: core " ++ Nat.repr s.trap.toNat ++ ", spec " ++ Nat.repr a.trap) .nil;
  Ls.Result.mk cyc ins s.trap.toNat o
    (List.append why (List.append trapP (List.append outP (List.append (Ls.compare ab wb s a)
      (List.append (Ls.memDiff ab wb s a (Rv.pow2 (wb + 2))) (Ls.ddrDiff ddr a 256))))))

-- The bus: a DDR model (bytes, initially zero) that answers a request `lat` cycles
-- after it is made.
def Ls.lat : Nat := 3
def Ls.ddrWord (m : BitVec 32 → BitVec 8) (a : BitVec 32) : BitVec 32 :=
  let ω b := Nat.mul (Nat.div a.toNat 4) 4;
  Rv.w32 ((m (Rv.w32 b)).toNat + 256 * (m (Rv.w32 (b + 1))).toNat + 65536 * (m (Rv.w32 (b + 2))).toNat
    + 16777216 * (m (Rv.w32 (b + 3))).toNat)
def Ls.ddrStore (m : BitVec 32 → BitVec 8) (a : BitVec 32) (d : BitVec 32) (st : BitVec 4) : BitVec 32 → BitVec 8 :=
  fun (x : BitVec 32) =>
    let ω b := Nat.mul (Nat.div a.toNat 4) 4;
    let ω k := x.toNat - b;
    if Bool.and (Bool.not (Nat.lt x.toNat b)) (Bool.and (Nat.lt x.toNat (b + 4)) (Rv.bit st.toNat k))
    then BitVec.ofNat 8 (Rv.bits d.toNat (8 * k) 8) else m x

-- `fuel` cycles at most; `a` is the specification's state for the instruction the core
-- is on (or will decode next)
def Ls.go (ab wb : Nat) (mx : Bool) (prog : List Nat) :
    Nat → Nat → List Nat → List Nat → (BitVec 32 → BitVec 8) → Nat → Nat → HwTy.El (CoreSt.code ab wb) → Arch → Ls.Result
  | cyc, ins, out, inp, ddr, lat, .zero, v, a => Ls.finish ab wb (Ls.hw (ab := ab) (wb := wb) v) a cyc ins out ddr (.cons "out of cycles" .nil)
  | cyc, ins, out, inp, ddr, lat, .succ fuel, v, a =>
    let ω s := Ls.hw (ab := ab) (wb := wb) v;
    let ω ph := s.ph.toNat;
    if Nat.beq ph Ph.h then Ls.finish ab wb s a cyc ins out ddr .nil
    else
      -- (at E: every instruction passes E once; D can repeat after a cache miss)
      let ω bad : List String := if Nat.beq ph Ph.e then Ls.compare ab wb s a else .nil;
      match bad with
      | .cons p ps => Ls.finish ab wb s a cyc ins out ddr (.cons ("after " ++ Nat.repr ins ++ " instructions") bad)
      | .nil =>
        let ω q := Bundle.ofEl Out.bundle (coreStep (r := HwTy.El) ab wb mx s In.idle).2;
        let ω req := BitVec.isTrue q.valid;
        let ω ans := Bool.and req (Nat.beq lat 0);
        let ω wr := Bool.and ans (BitVec.isTrue q.we);
        let ω ioIn : BitVec 32 := (match inp with
          | .cons c cs => BitVec.ofNat 32 c
          | .nil => BitVec.ofNat 32 4294967295);
        let ω port : In HwTy.El := In.mk (BitVec.ofNat 1 1) ioIn
          (Bool.toBits ans) (Bool.toBits (Bool.and ans (Bool.not (BitVec.isTrue q.we)))) (Ls.ddrWord ddr q.addr);
        let ω r := coreStep (r := HwTy.El) ab wb mx s port;
        let ω o := Bundle.ofEl Out.bundle r.2;
        let ω out2 : List Nat := if BitVec.isTrue o.wr then .cons o.byte.toNat out else out;
        let ω a2 := if Nat.beq ph Ph.e then Rv.step (Ls.cfgM ab wb mx) a else a;
        let ω ins2 := if Nat.beq ph Ph.e then Nat.succ ins else ins;
        let ω ddr2 := if wr then Ls.ddrStore ddr q.addr q.wdata q.wstrb else ddr;
        let ω lat2 := if req then (if Nat.beq lat 0 then Ls.lat else lat - 1) else Ls.lat;
        let ω inp2 : List Nat := (match BitVec.isTrue o.rd, inp with
          | .true, .cons c cs => cs
          | _, _ => inp);
        Ls.go ab wb mx prog (Nat.succ cyc) ins2 out2 inp2 ddr2 lat2 fuel r.1 a2

def Ls.runIn (ab wb : Nat) (mx : Bool) (prog : List Nat) (input : List Nat) (fuel : Nat) : Ls.Result :=
  Ls.go ab wb mx prog 0 0 .nil input (fun (x : BitVec 32) => BitVec.ofNat 8 0) Ls.lat fuel (Bundle.toEl (CoreSt.bundle ab wb) (CoreSt.init ab wb prog))
    (Rv.setInp (Arch.start (Ls.cfgM ab wb mx) prog) input)
def Ls.run (ab wb : Nat) (mx : Bool) (prog : List Nat) (fuel : Nat) : Ls.Result :=
  Ls.runIn ab wb mx prog .nil fuel
