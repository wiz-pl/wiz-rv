import Rv.Uart
-- The core on a board: the output port drives LEDs (the low bits of the last byte
-- written), the trap code is shown too. iCEstick: five LEDs, the 12 MHz clock.

structure Pins (r : HwTy → Type) where
  uart_rx : r Bit       -- unused (an input so that the design has one)
  deriving Bundle

structure Leds (r : HwTy → Type) where
  leds : r B5
  deriving Bundle

structure Sys (ab wb : Nat) (r : HwTy → Type) where
  cpu : St ab wb r
  latch : r B5
  deriving Bundle

-- LED1 … LED4: the low four bits of the last byte written; LED5 (green): stopped
def sysStep {r : HwTy → Type} [Hw r] (ab wb : Nat) (mx : Bool) (s : Sys ab wb r) (x : Pins r) :
    r (HwTy.prod (Sys.code ab wb) Leds.code) :=
  let cr := coreStep ab wb mx s.cpu (In.mk (Hw.lit 1 1) (Hw.lit 1 0) (Hw.lit 8 0));
  let ω o := Out.unpack (Hw.snd cr);
  let latch := Hw.mux o.wr (Hw.slice 0 5 o.byte) s.latch;
  Hw.pair (Sys.pack ab wb (Sys.mk (St.unpack ab wb (Hw.fst cr)) latch))
    (Leds.pack (Leds.mk (Hw.cat (Hw.not (isK s.cpu.trap 0)) (Hw.slice 0 4 s.latch : r (HwTy.bits 4)))))

def board (ab wb : Nat) (mx : Bool) (prog : List Nat) : Circuit Pins.code Leds.code :=
  Circuit.bundled (Sys.bundle ab wb) Pins.bundle Leds.bundle (Sys.mk (St.init ab wb prog) (BitVec.ofNat 5 0))
    (sysStep ab wb mx)

-- iCEstick pins (icestorm's examples/icestick/icestick.pcf)
def Icestick.clk : Nat := 21
def Icestick.pins : List Pin :=
  .cons (Pin.one "uart_rx" 9) (.cons (Pin.bus "leds" (.cons 99 (.cons 98 (.cons 97 (.cons 96 (.cons 95 .nil)))))) .nil)

------------------------------------------------------------------------------------
-- The Arty A7 (`rv32im_arty_uart`): the output port is the UART's transmitter, the
-- input port its receiver (a one-byte buffer: a byte that arrives while one is waiting
-- replaces it), 115473 baud from the 100 MHz clock (`n` = 866 cycles per bit: the
-- FT2232's "115200" is 3 MHz / 26 = 115384.6 baud, and the board must not be slower;
-- wiz-arty's src/Arty/Designs.wiz). BTN0 resets the core (PC, phase, trap; the memory and
-- the registers keep their contents). LD4 blinks (a heartbeat), LD5: a byte was sent,
-- LD6: an instruction was executed, LD7: stopped (a trap).
-- Port names as in lib/Hdl/Arty.wiz (agent/artix-target).

def Arty.n : Nat := 866
def B26 : HwTy := HwTy.bits 26

structure APins (r : HwTy → Type) where
  uart_rx : r Bit
  btn : r B4
  deriving Bundle

structure ABoard (r : HwTy → Type) where
  uart_tx : r Bit
  led : r B4
  deriving Bundle

structure ASys (ab wb : Nat) (r : HwTy → Type) where
  cpu : St ab wb r
  sync : Sync r
  rx : Rx r
  tx : Tx r
  full : r Bit
  byte : r B8
  beat : r B26
  sent : r Bit    -- a byte has been sent (since reset)
  ran : r Bit     -- an instruction has been executed (since reset)
  deriving Bundle

def aStep {r : HwTy → Type} [Hw r] (ab wb : Nat) (mx : Bool) (n : Nat)
    (s : ASys ab wb r) (x : APins r) : r (HwTy.prod (ASys.code ab wb) ABoard.code) :=
  let rr := rxStep n s.rx s.sync.ff2;
  let ω got := Byte.unpack (Hw.snd rr);
  let cr := coreStep ab wb mx s.cpu (In.mk (txIdle s.tx) s.full s.byte);
  let ω o := Out.unpack (Hw.snd cr);
  let rst := bitOf 0 x.btn;
  let ω c := St.unpack ab wb (Hw.fst cr);
  -- the reset: the phase, the PC and the trap code only (no reset on the memories'
  -- read registers, which are block RAM's output latches)
  let c2 := St.mk (Hw.mux rst (Hw.lit 3 Ph.f) c.ph) (Hw.mux rst (Hw.lit 32 0) c.pc) c.q0 c.q1 c.q2 c.q3
    c.m0 c.m1 c.m2 c.m3 c.rfa c.rfb c.x1 c.x2 c.acc c.dv c.rm c.cnt c.srd c.sf3 c.slo c.sio (Hw.mux rst (Hw.lit 3 0) c.trap);
  Hw.pair
    (ASys.pack ab wb (ASys.mk
      c2
      (Sync.unpack (syncStep s.sync x.uart_rx))
      (Rx.unpack (Hw.fst rr))
      (Tx.unpack (txStep n s.tx o.wr o.byte))
      (Hw.mux got.valid hi (Hw.mux o.take lo s.full))
      (Hw.mux got.valid got.data s.byte)
      (inc s.beat)
      (Hw.mux rst lo (Hw.mux o.wr hi s.sent))
      (Hw.mux rst lo (Hw.mux (isK s.cpu.ph Ph.e) hi s.ran))))
    -- LD4: heartbeat, LD5: a byte was sent, LD6: running (an instruction executed),
    -- LD7: stopped (a trap)
    (ABoard.pack (ABoard.mk s.tx.line (Hw.cat (Hw.not (isK s.cpu.trap 0)) (Hw.cat s.ran (Hw.cat s.sent (bitOf 25 s.beat))))))

def arty (ab wb : Nat) (mx : Bool) (n : Nat) (prog : List Nat) : Circuit APins.code ABoard.code :=
  Circuit.bundled (ASys.bundle ab wb) APins.bundle ABoard.bundle
    (ASys.mk (St.init ab wb prog) Sync.init Rx.init Tx.init (BitVec.ofNat 1 0) (BitVec.ofNat 8 0) (BitVec.ofNat 26 0) (BitVec.ofNat 1 0) (BitVec.ofNat 1 0))
    (aStep ab wb mx n)

-- Half rate: every register of `c` (and every memory write) is enabled in every other
-- cycle, by a toggle flip-flop (`half`), so that each path between them has two clock
-- periods. On the Arty the core's execute path is about 12.6 ns (nextpnr, xc7a35t):
-- too long for 100 MHz, fine for 50. The only one-period path is from the toggle to
-- the enables.
def Circuit.half {ω i o : HwTy} (c : Circuit i o) : Circuit i o :=
  Circuit.mk (HwTy.prod (HwTy.named "half" HwTy.bit) c.st) (BitVec.ofNat 1 0, c.init) (fun s x =>
    let t := Hw.untag (Hw.fst s);
    let r := (Circuit.withEnable c).step (Hw.snd s) (Hw.pair (Hw.tag "en" t) x);
    Hw.pair (Hw.pair (Hw.tag "half" (Hw.not t)) (Hw.fst r)) (Hw.snd r))

-- the design for the board: at 50 MHz effective, 433 cycles per bit (50 MHz * 26 / 3 MHz,
-- rounded down: 115473 baud, a little fast of the FT2232's 115384.6)
def Arty.nHalf : Nat := 433
def artyHalf (prog : List Nat) : Circuit APins.code ABoard.code := Circuit.half (arty 5 12 .true Arty.nHalf prog)
