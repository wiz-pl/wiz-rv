import Rv.Asm
-- Test programs, riscv-tests style: each computes something and writes bytes to the
-- output port (a store to 0x80000000; x31 … hold that address where needed), then stops
-- with `ebreak`. Registers stay below x16, so every program runs on RV32E too.

-- the output port's address in x15
def P.port : Asm := A.lui 15 524288

-- sum 1 … 10 = 55, output
def Prog.sum : List Asm :=
  P.port :: A.li 1 0 :: A.li 2 10 ::
  A.label "loop" :: A.add 1 1 2 :: A.addi 2 2 (-1) :: A.bnez 2 "loop" ::
  A.sb 1 0 15 :: A.ebreak :: .nil

-- output x`r`'s low byte
def P.out (r : Nat) : Asm := A.sb r 0 15

-- the ALU: every OP and OP-IMM operation on a few operands, each result output
def Prog.alu : List Asm :=
  P.port :: A.li 1 (-7) :: A.li 2 3 :: A.li 3 2147483647 :: A.li 4 (-2147483648) ::
  A.add 5 1 2 :: P.out 5 :: A.sub 5 1 2 :: P.out 5 :: A.sub 5 2 1 :: P.out 5 ::
  A.add 5 3 2 :: A.srli 6 5 24 :: P.out 6 ::
  A.slt 5 1 2 :: P.out 5 :: A.slt 5 2 1 :: P.out 5 :: A.sltu 5 1 2 :: P.out 5 :: A.sltu 5 2 1 :: P.out 5 ::
  A.slt 5 4 3 :: P.out 5 :: A.sltu 5 4 3 :: P.out 5 ::
  A.xor 5 1 2 :: P.out 5 :: A.or 5 1 2 :: P.out 5 :: A.and 5 1 2 :: P.out 5 ::
  A.addi 5 1 (-100) :: P.out 5 :: A.slti 5 1 (-6) :: P.out 5 :: A.slti 5 1 (-8) :: P.out 5 ::
  A.sltiu 5 2 (-1) :: P.out 5 :: A.sltiu 5 1 5 :: P.out 5 ::
  A.xori 5 1 (-1) :: P.out 5 :: A.ori 5 2 1024 :: A.srli 5 5 8 :: P.out 5 :: A.andi 5 1 2047 :: P.out 5 ::
  A.lui 6 74565 :: A.srli 7 6 12 :: P.out 7 :: A.srli 7 6 20 :: P.out 7 ::
  A.add 0 1 2 :: A.addi 0 0 5 :: P.out 0 ::
  A.ebreak :: .nil

-- the shifts, by register and by constant: 0, 1, 4, 31 places, and amounts above 31
-- (only the low five bits count)
def Prog.shift : List Asm :=
  P.port :: A.li 1 (-1985229329) :: A.li 2 0 :: A.li 3 1 :: A.li 4 4 :: A.li 5 31 :: A.li 6 36 ::
  A.sll 7 1 2 :: A.srli 8 7 24 :: P.out 8 ::
  A.sll 7 1 3 :: P.out 7 :: A.srl 7 1 4 :: A.srli 8 7 24 :: P.out 8 :: A.sra 7 1 4 :: A.srli 8 7 24 :: P.out 8 ::
  A.sra 7 1 5 :: P.out 7 :: A.srl 7 1 5 :: P.out 7 :: A.sll 7 1 5 :: A.srli 8 7 24 :: P.out 8 ::
  A.sll 7 1 6 :: P.out 7 :: A.srl 7 1 6 :: A.srli 8 7 24 :: P.out 8 ::
  A.slli 7 1 3 :: P.out 7 :: A.srli 7 1 9 :: P.out 7 :: A.srai 7 1 9 :: A.srli 8 7 16 :: P.out 8 ::
  A.srai 7 1 0 :: P.out 7 :: A.slli 7 1 31 :: A.srli 8 7 24 :: P.out 8 ::
  A.ebreak :: .nil

-- loads and stores of every size at every legal offset, sign and zero extension
def Prog.mem : List Asm :=
  P.port :: A.li 1 256 :: A.li 2 (-2023406815) ::
  A.sw 2 0 1 :: A.lw 3 0 1 :: P.out 3 :: A.lbu 3 1 1 :: P.out 3 :: A.lb 3 3 1 :: A.srli 4 3 24 :: P.out 4 ::
  A.lh 3 2 1 :: A.srli 4 3 16 :: P.out 4 :: A.lhu 3 2 1 :: A.srli 4 3 8 :: P.out 4 ::
  A.li 5 171 :: A.sb 5 5 1 :: A.sb 5 6 1 :: A.lw 3 4 1 :: A.srli 4 3 8 :: P.out 4 :: A.srli 4 3 16 :: P.out 4 ::
  A.li 5 (-292) :: A.sh 5 10 1 :: A.lh 3 10 1 :: A.srli 4 3 8 :: P.out 4 :: A.lw 3 8 1 :: A.srli 4 3 24 :: P.out 4 ::
  A.sh 5 8 1 :: A.lhu 3 8 1 :: A.srli 4 3 8 :: P.out 4 :: A.lb 3 (-255) 1 :: P.out 3 ::
  A.sw 2 1020 0 :: A.lbu 3 1023 0 :: P.out 3 ::
  A.ebreak :: .nil

-- branches taken and not, each condition on signed and unsigned edge cases; a call
-- and a return (JAL, JALR), AUIPC
def Prog.branch : List Asm :=
  P.port :: A.li 1 (-1) :: A.li 2 1 :: A.li 10 0 ::
  A.beq 1 2 "f1" :: A.addi 10 10 1 :: A.label "f1" ::
  A.bne 1 2 "t1" :: A.addi 10 10 100 :: A.label "t1" ::
  A.blt 1 2 "t2" :: A.addi 10 10 100 :: A.label "t2" ::
  A.bltu 1 2 "f2" :: A.addi 10 10 2 :: A.label "f2" ::
  A.bge 1 2 "f3" :: A.addi 10 10 4 :: A.label "f3" ::
  A.bgeu 1 2 "t3" :: A.addi 10 10 100 :: A.label "t3" ::
  A.bge 2 2 "t4" :: A.addi 10 10 100 :: A.label "t4" ::
  A.beq 0 0 "t5" :: A.addi 10 10 100 :: A.label "t5" ::
  P.out 10 ::
  A.jal 1 "sub" :: P.out 10 :: A.auipc 3 0 :: P.out 3 :: A.auipc 3 1 :: A.srli 3 3 12 :: P.out 3 ::
  A.li 11 3 :: A.label "back" :: A.addi 11 11 (-1) :: P.out 11 :: A.bnez 11 "back" ::
  A.ebreak ::
  A.label "sub" :: A.addi 10 10 16 :: A.jalr 0 1 0 :: .nil

-- bubble sort of eight words at 512, then output
def Prog.sort : List Asm :=
  P.port :: A.li 1 512 ::
  A.li 2 5 :: A.sw 2 0 1 :: A.li 2 (-3) :: A.sw 2 4 1 :: A.li 2 9 :: A.sw 2 8 1 :: A.li 2 0 :: A.sw 2 12 1 ::
  A.li 2 77 :: A.sw 2 16 1 :: A.li 2 (-100) :: A.sw 2 20 1 :: A.li 2 2 :: A.sw 2 24 1 :: A.li 2 9 :: A.sw 2 28 1 ::
  A.li 3 7 ::
  A.label "outer" :: A.mv 4 1 :: A.li 5 0 ::
  A.label "inner" :: A.lw 6 0 4 :: A.lw 7 4 4 :: A.bge 7 6 "noswap" :: A.sw 7 0 4 :: A.sw 6 4 4 ::
  A.label "noswap" :: A.addi 4 4 4 :: A.addi 5 5 1 :: A.blt 5 3 "inner" ::
  A.addi 3 3 (-1) :: A.bnez 3 "outer" ::
  A.li 5 8 :: A.mv 4 1 ::
  A.label "print" :: A.lw 6 0 4 :: P.out 6 :: A.addi 4 4 4 :: A.addi 5 5 (-1) :: A.bnez 5 "print" ::
  A.ebreak :: .nil

-- traps: a misaligned load, a misaligned store, a misaligned jump, an illegal
-- instruction (all zeros), ECALL; and x16 (illegal on RV32E only)
def Prog.trapLoad : List Asm := A.li 1 2 :: A.lw 2 0 1 :: A.ebreak :: .nil
def Prog.trapStore : List Asm := A.li 1 1 :: A.sh 2 0 1 :: A.ebreak :: .nil
def Prog.trapJump : List Asm := A.li 1 6 :: A.jalr 0 1 0 :: A.ebreak :: .nil
def Prog.trapIllegal : List Asm := A.nop :: Asm.word 0 :: .nil
def Prog.trapEcall : List Asm := A.nop :: A.ecall :: .nil
def Prog.x16 : List Asm := A.li 16 5 :: A.ebreak :: .nil

-- blink: a counter on the output port, a delay between steps (for the board)
def Prog.blink : List Asm :=
  P.port :: A.li 1 0 ::
  A.label "top" :: P.out 1 :: A.addi 1 1 1 :: A.li 2 1000000 ::
  A.label "wait" :: A.addi 2 2 (-1) :: A.bnez 2 "wait" :: A.j "top" :: .nil

-- the M extension: every operation on signed and unsigned edge cases (division by
-- zero, -2^31 / -1); each result's four bytes are folded into one (xor) and output
def P.out4 (r : Nat) : List Asm :=
  A.srli 13 r 8 :: A.xor 13 13 r :: A.srli 14 r 16 :: A.xor 13 13 14 :: A.srli 14 r 24 :: A.xor 13 13 14 :: P.out 13 :: .nil
def P.all8 (a b : Nat) : List Asm :=
  List.append (A.mul 12 a b :: P.out4 12) (List.append (A.mulh 12 a b :: P.out4 12) (List.append (A.mulhsu 12 a b :: P.out4 12)
  (List.append (A.mulhu 12 a b :: P.out4 12) (List.append (A.div 12 a b :: P.out4 12) (List.append (A.divu 12 a b :: P.out4 12)
  (List.append (A.rem 12 a b :: P.out4 12) (A.remu 12 a b :: P.out4 12)))))))
def Prog.muldiv : List Asm :=
  P.port :: A.li 1 (-7) :: A.li 2 3 :: A.li 3 (-2147483648) :: A.li 4 (-1) :: A.li 5 0 :: A.li 6 123456789 :: A.li 7 (-98765) ::
  List.append (P.all8 1 2) (List.append (P.all8 2 1) (List.append (P.all8 3 4) (List.append (P.all8 6 5)
  (List.append (P.all8 6 7) (List.append (P.all8 7 6) (List.append (P.all8 4 4) (A.ebreak :: .nil)))))))

-- the sieve of Eratosthenes below 1000 (a byte per number, from address 1024): the
-- number of primes (168, as two bytes) and the last one (997, as two bytes)
def Prog.sieve : List Asm :=
  P.port :: A.li 1 1024 :: A.li 2 1000 :: A.li 3 2 ::
  -- clear
  A.li 4 0 :: A.label "clr" :: A.add 5 1 4 :: A.sb 0 0 5 :: A.addi 4 4 1 :: A.blt 4 2 "clr" ::
  -- for p = 2 …: if not marked, mark 2p, 3p, …
  A.label "outer" :: A.add 5 1 3 :: A.lbu 6 0 5 :: A.bnez 6 "next" ::
  A.add 7 3 3 :: A.li 8 1 ::
  A.label "mark" :: A.bge 7 2 "next" :: A.add 5 1 7 :: A.sb 8 0 5 :: A.add 7 7 3 :: A.j "mark" ::
  A.label "next" :: A.addi 3 3 1 :: A.blt 3 2 "outer" ::
  -- count and remember the last
  A.li 3 2 :: A.li 9 0 :: A.li 10 0 ::
  A.label "count" :: A.add 5 1 3 :: A.lbu 6 0 5 :: A.bnez 6 "skip" :: A.addi 9 9 1 :: A.mv 10 3 ::
  A.label "skip" :: A.addi 3 3 1 :: A.blt 3 2 "count" ::
  P.out 9 :: A.srli 9 9 8 :: P.out 9 :: P.out 10 :: A.srli 10 10 8 :: P.out 10 :: A.ebreak :: .nil
-- the same on three operand pairs (division by zero, the signed overflow, mixed signs),
-- short enough for the full lockstep
def Prog.muldivShort : List Asm :=
  P.port :: A.li 1 (-7) :: A.li 2 3 :: A.li 3 (-2147483648) :: A.li 4 (-1) :: A.li 5 0 :: A.li 6 123456789 ::
  List.append (P.all8 1 2) (List.append (P.all8 3 4) (List.append (P.all8 6 5) (A.ebreak :: .nil)))

------------------------------------------------------------------------------------
-- The board demo (RV32IM; registers below x16, so that it would run on RV32E but for
-- the M instructions): a banner; an M self-test against values the specification
-- computes when the program is assembled; the primes up to 1000 (trial division with
-- REMU); then a prompt that echoes what is typed (input: a load from the port, -1
-- while nothing has come). x15: the port, x2: the stack, x10: the argument.

-- puts: the zero-terminated string at x10
def D.puts : List Asm :=
  A.label "puts" :: A.lbu 5 0 10 :: A.beqz 5 "puts.done" :: A.sb 5 0 15 :: A.addi 10 10 1 :: A.j "puts" ::
  A.label "puts.done" :: A.ret :: .nil
-- putd: x10 in decimal (digits pushed on the stack, then printed)
def D.putd : List Asm :=
  A.label "putd" :: A.addi 2 2 (-16) :: A.mv 5 10 :: A.li 7 10 :: A.li 12 0 ::
  A.label "putd.l" :: A.remu 6 5 7 :: A.addi 6 6 48 :: A.add 13 2 12 :: A.sb 6 0 13 :: A.addi 12 12 1 ::
    A.divu 5 5 7 :: A.bnez 5 "putd.l" ::
  A.label "putd.p" :: A.addi 12 12 (-1) :: A.add 13 2 12 :: A.lbu 6 0 13 :: A.sb 6 0 15 :: A.bnez 12 "putd.p" ::
  A.addi 2 2 16 :: A.ret :: .nil

-- one self-test case: funct3 of an M instruction and its operands; the expected value
-- is the specification's
def D.expect (f3 : Nat) (a b : Int) : Int :=
  Int.ofNat (Rv.muldiv f3 (Rv.w32 (Asm.tc 32 a)) (Rv.w32 (Asm.tc 32 b))).toNat
def D.case (f3 : Nat) (a b : Int) : List Asm :=
  A.li 5 a :: A.li 6 b :: Asm.op f3 1 7 5 6 :: A.li 12 (D.expect f3 a b) :: A.bne 7 12 "fail" :: .nil
def D.cases8 (a b : Int) : List Asm :=
  List.append (D.case 0 a b) (List.append (D.case 1 a b) (List.append (D.case 2 a b) (List.append (D.case 3 a b)
  (List.append (D.case 4 a b) (List.append (D.case 5 a b) (List.append (D.case 6 a b) (D.case 7 a b)))))))
def D.selftest : List Asm :=
  List.append (D.cases8 (-7) 3) (List.append (D.cases8 (-2147483648) (-1)) (List.append (D.cases8 123456789 0)
  (List.append (D.cases8 (-98765) 4321) (D.cases8 2147483647 (-2147483648)))))

def D.primes : List Asm :=
  A.li 8 2 ::
  A.label "pl" :: A.li 9 2 ::
  A.label "dl" :: A.mul 11 9 9 :: A.bltu 8 11 "isp" :: A.remu 11 8 9 :: A.beqz 11 "notp" :: A.addi 9 9 1 :: A.j "dl" ::
  A.label "isp" :: A.mv 10 8 :: A.call "putd" :: A.li 11 32 :: A.sb 11 0 15 ::
  A.label "notp" :: A.addi 8 8 1 :: A.li 11 1001 :: A.blt 8 11 "pl" :: .nil

def Prog.demo (stack : Nat) : List Asm :=
  List.append (P.port :: A.li 2 (Int.ofNat stack) :: A.la 10 "banner" :: A.call "puts" :: A.la 10 "mtest" :: A.call "puts" :: .nil)
    (List.append D.selftest
    (List.append (A.la 10 "pass" :: A.call "puts" :: A.j "primes" ::
      A.label "fail" :: A.la 10 "failed" :: A.call "puts" ::
      A.label "primes" :: A.la 10 "ptext" :: A.call "puts" :: .nil)
    (List.append D.primes
    (List.append (A.la 10 "prompt" :: A.call "puts" ::
      A.label "echo" :: A.lw 5 0 15 :: A.blt 5 0 "echo" :: A.li 6 13 :: A.beq 5 6 "cr" :: A.sb 5 0 15 :: A.j "echo" ::
      A.label "cr" :: A.la 10 "prompt" :: A.call "puts" :: A.j "echo" :: .nil)
    (List.append D.puts (List.append D.putd
    (List.append (A.string "banner" "\nwiz-rv RV32IM on Arty\n")
    (List.append (A.string "mtest" "M self-test: ")
    (List.append (A.string "pass" "PASS\n")
    (List.append (A.string "failed" "FAIL\n")
    (List.append (A.string "ptext" "primes up to 1000:\n")
    (A.string "prompt" "\n> "))))))))))))

-- the input port with nothing waiting: every load size gives -1 (and rd = x0 is fine)
def Prog.ioload : List Asm :=
  P.port :: A.lw 1 0 15 :: A.lb 2 4 15 :: A.lhu 3 8 15 :: A.lw 0 0 15 ::
  A.srli 4 1 24 :: P.out 4 :: P.out 2 :: P.out 3 :: A.ebreak :: .nil
