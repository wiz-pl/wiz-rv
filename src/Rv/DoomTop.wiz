import Rv.Doom
import Ddr3.Cache
import Ddr3.Board
import Ddr3.Model
-- The Doom board top for the Arty A7-35T (`doomTop`): wiz-ddr3's PLL wrapper
-- (`Board.clocking`: the circuit at 100 MHz, the PHY's clocks), its PHY, controller and
-- 8 KB write-back cache, and the Doom machine (`doomSys`, src/Rv/Doom.wiz) at half rate
-- behind the bus adapter (`busStep`).
--
-- The core is held in reset until the DDR's calibration has finished (done or failed);
-- the boot loader then prints "DDR ok" or "DDR fail". LEDs: LD4 calibrated, LD5
-- calibration failed, LD6 a heartbeat from the core's side (its cycle counter), LD7 one
-- from the 100 MHz side. BTN0 resets the core.
--
-- `doomSim`: the same with wiz-ddr3's behavioural DDR3 device in place of the PHY (no
-- clocks), for simulation.

structure TIn (r : HwTy → Type) where
  sys4x : r HwTy.clock
  sys4xDqs : r HwTy.clock
  ref200 : r HwTy.clock
  locked : r W1
  uart_rx : r W1
  btn : r B4
  deriving Bundle

structure TOut (r : HwTy → Type) where
  uart_tx : r W1
  led : r B4
  ja : r W8
  jb : r W8
  deriving Bundle

-- the parts common to both: the cache, the controller, the adapter and the machine, given
-- the controller's PHY input; the next state of these, the controller's DFI output, the
-- board's outputs
def Top.half (prog : List Nat) : Circuit DIn.code DOut.code := Circuit.half (doomSys prog)

structure TSt (h : HwTy) (r : HwTy → Type) where
  ctrl : r St.code
  cache : r CSt.code
  bus : BusA r
  sys : r h
  beat : r (HwTy.bits 27)
  deriving Bundle

def Top.core {r : HwTy → Type} [Hw r] (t : Timing) (h : Circuit DIn.code DOut.code) (s : TSt h.st r) (phyIn : r PhyIn.code)
    (rx : r W1) (btn : r B4) : r (HwTy.prod (TSt.code h.st) (HwTy.prod Dfi.code TOut.code)) :=
  let ω cs := St.unpack s.ctrl;
  let ω bs := s.bus;
  -- the machine's bus request comes from its state: ask with no answer first
  let quiet := DIn.pack (DIn.mk rx btn (Hw.lit 1 0) (Hw.lit 1 0) (Hw.lit 32 0) (Hw.lit 2 0));
  let ω o0 := DOut.unpack (Hw.snd (Circuit.inst h s.sys quiet));
  let ω a0 := Hw.snd (busStep bs o0.valid o0.pend o0.we o0.addr o0.wdata o0.wstrb (CacheResp.mk (Hw.lit 1 0) (Hw.lit 1 0) (Hw.lit 32 0)));
  let ω q := CacheReq.unpack (Hw.fst a0);
  -- the controller's answer to the cache comes from its state and its PHY input
  let co0 := Ctrl.step t cs (PortIn.mk U.lo U.lo (Hw.lit 24 0) (Hw.lit 128 0) (Hw.lit 16 0)) (PhyIn.unpack phyIn);
  let ω po0 := PortOut.unpack (Hw.fst (Hw.snd co0));
  let cr := C.step (CSt.unpack s.cache) (CReq.mk q.valid q.addr q.we q.wdata q.wstrb) po0;
  let ω resp := CResp.unpack (Hw.fst (Hw.snd cr));
  let co := Ctrl.step t cs (PortIn.unpack (Hw.snd (Hw.snd cr))) (PhyIn.unpack phyIn);
  let ω po := PortOut.unpack (Hw.fst (Hw.snd co));
  let br := busStep bs o0.valid o0.pend o0.we o0.addr o0.wdata o0.wstrb (CacheResp.mk resp.ready resp.rvalid resp.rdata);
  let ω toCore := CacheResp.unpack (Hw.snd (Hw.snd br));
  -- the core waits in reset for the calibration
  let calEnd := Hw.or po.calDone po.calFail;
  let rst := Hw.or (bitOf 0 btn) (Hw.not calEnd);
  let hr := Circuit.inst h s.sys (DIn.pack (DIn.mk rx (Hw.cat (Hw.slice 1 3 btn : r B3) rst)
    toCore.ready toCore.rvalid toCore.rdata (Hw.cat po.calFail po.calDone)));
  let ω o := DOut.unpack (Hw.snd hr);
  Hw.pair
    (TSt.pack h.st (TSt.mk (Hw.fst co) (Hw.fst cr) (BusA.unpack (Hw.fst br)) (Hw.fst hr) (inc s.beat)))
    (Hw.pair (Hw.snd (Hw.snd co))
      (TOut.pack (TOut.mk o.uart_tx
        (Hw.cat (bitOf 26 s.beat) (Hw.cat (bitOf 0 o.led) (Hw.cat po.calFail po.calDone)))
        o.ja o.jb)))

def Top.init (t : Timing) (h : Circuit DIn.code DOut.code) : HwTy.El (TSt.code h.st) :=
  Bundle.toEl (TSt.bundle h.st) (TSt.mk (Ctrl.init t) C.init (BusA.init) h.init (BitVec.ofNat 27 0))

-- the board: the PHY between the controller and the pins (its input registered, as in
-- wiz-ddr3's memory test), its reset held until the PLL has locked for 255 cycles
structure BSt (h : HwTy) (r : HwTy → Type) where
  top : r (TSt.code h)
  phy : r PhyIn.code
  rstCnt : r W8
  deriving Bundle

def Top.board (t : Timing) (h : Circuit DIn.code DOut.code) : Circuit TIn.code (HwTy.prod Ddr3Pads.code TOut.code) :=
  let ω hst := h.st;
  Circuit.mk (BSt.code hst)
    (Bundle.toEl (BSt.bundle hst) (BSt.mk (Top.init t h) (HwTy.unpack PhyIn.code 0) (BitVec.ofNat 8 0)))
    (fun s x =>
      let ω b := BSt.unpack hst s;
      let ω i := TIn.unpack x;
      let ω ts := TSt.unpack hst b.top;
      let ω cs := St.unpack ts.ctrl;
      let phyRst := Hw.not (isK b.rstCnt 255);
      let tr := Top.core t h ts b.phy i.uart_rx i.btn;
      let ω dfi := Dfi.unpack (Hw.fst (Hw.snd tr));
      let phy := Phy.io (PhyClk.mk i.sys4x i.sys4xDqs i.ref200) phyRst cs.rstN dfi;
      Hw.pair (BSt.pack hst (BSt.mk (Hw.fst tr) (Hw.snd phy) (Hw.mux phyRst (Hw.mux i.locked (inc b.rstCnt) b.rstCnt) b.rstCnt)))
        (Hw.pair (Hw.fst phy) (Hw.snd (Hw.snd tr))))

-- simulation: the behavioural device in place of the PHY
structure SSt (h : HwTy) (r : HwTy → Type) where
  top : r (TSt.code h)
  model : r MSt.code
  phy : r PhyIn.code
  deriving Bundle

def doomTop (t : Timing) (prog : List Nat) : Circuit TIn.code (HwTy.prod Ddr3Pads.code TOut.code) := Top.board t (Top.half prog)

def doomSim (t : Timing) (mp : MParams) (prog : List Nat) : Circuit SimIn.code TOut.code :=
  let ω h := Top.half prog;
  let ω hst := h.st;
  Circuit.mk (SSt.code hst)
    (Bundle.toEl (SSt.bundle hst) (SSt.mk (Top.init t h) Model.init (HwTy.unpack PhyIn.code 0)))
    (fun s x =>
      let ω b := SSt.unpack hst s;
      let tr := Top.core t h (TSt.unpack hst b.top) b.phy (SimIn.unpack x).uart_rx (Hw.lit 4 0);
      let mo := Model.step t mp (MSt.unpack b.model) (Dfi.unpack (Hw.fst (Hw.snd tr)));
      Hw.pair (SSt.pack hst (SSt.mk (Hw.fst tr) (Hw.fst mo) (Hw.fst (Hw.snd mo))))
        (Hw.snd (Hw.snd tr)))

-- For checking the timing of the full-rate part alone (FINDINGS.md, H5): the machine
-- replaced by registers that make bus requests (an LFSR) and absorb the answers
structure Stub (r : HwTy → Type) where
  lfsr : r B32
  valid : r W1
  addr : r B32
  we : r W1
  acc : r B32
  deriving Bundle
def stubStep {r : HwTy → Type} [Hw r] (s : Stub r) (x : DIn r) : r (HwTy.prod Stub.code DOut.code) :=
      let next := Hw.xor (Hw.cat (Hw.slice 0 31 s.lfsr : r (HwTy.bits 31)) (Hw.xor (bitOf 31 s.lfsr) (bitOf 21 s.lfsr))) (Hw.cat (Hw.lit 31 0) x.uart_rx);
      let busy := Hw.and s.valid (Hw.not x.ready);
      Hw.pair
        (Stub.pack (Stub.mk next (Hw.mux busy (Hw.lit 1 1) (bitOf 3 s.lfsr))
          (Hw.mux busy s.addr (Hw.cat (Hw.lit 6 16) (Hw.slice 0 26 s.lfsr : r (HwTy.bits 26))))
          (Hw.mux busy s.we (bitOf 5 s.lfsr))
          (Hw.mux x.rvalid (Hw.xor s.acc x.rdata) s.acc)))
        (DOut.pack (DOut.mk (bitOf 0 s.acc) (Hw.slice 1 4 s.acc) (Hw.slice 8 8 s.acc) (Hw.slice 16 8 s.acc)
          s.valid s.addr s.we s.lfsr (Hw.slice 4 4 s.lfsr) s.valid))
def stubSys : Circuit DIn.code DOut.code :=
  Circuit.bundled Stub.bundle DIn.bundle DOut.bundle
    (Stub.mk (BitVec.ofNat 32 2463534242) (BitVec.ofNat 1 0) (BitVec.ofNat 32 1073741824) (BitVec.ofNat 1 0) (BitVec.ofNat 32 0))
    stubStep
def stubTop (t : Timing) : Circuit TIn.code (HwTy.prod Ddr3Pads.code TOut.code) := Top.board t stubSys
