import Sys
import Text
-- `bin2wiz IN.bin OUT.wiz NAME`: a binary as a Wiz definition `def NAME : String`, its
-- bytes in hexadecimal (two digits each), for `Hex.words` (src/Rv/Progs.wiz).

def hexDigit (n : Nat) : Char := Char.mk (if Nat.lt n 10 then 48 + n else 87 + n)
def hexBytes : List Nat → List Char → List Char
  | .nil, acc => List.reverse acc
  | .cons b bs, acc => hexBytes bs (.cons (hexDigit (Nat.mod b 16)) (.cons (hexDigit (Nat.div b 16)) acc))

def main : IO Unit := EIO.toIO (do
  args ← EIO.lift IO.args;
  match args with
  | .cons inp (.cons out (.cons name .nil)) => do
    b ← FS.readBytes inp;
    FS.writeFile out ("-- generated by app/bin2wiz.wiz from " ++ inp ++ "\nimport Rv.Progs\ndef " ++ name ++ " : String := \""
      ++ String.mk (hexBytes (Bytes.toList b) .nil) ++ "\"\n")
  | _ => EIO.fail "usage: bin2wiz IN.bin OUT.wiz NAME")
