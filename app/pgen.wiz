import Rv.PBoard
import Rv.Progs
import Hdl.Arty
import Sys
-- `pgen arty`: write build/p_arty.v and build/p_arty.xdc: the pipelined core with the
-- UART demo (`Prog.demo`) on the Arty at 100 MHz (src/Rv/PBoard.wiz).

def say (s : String) : EIO Unit := EIO.lift (IO.println s)

def ensureDir (p : String) : EIO Unit := do
  d ← EIO.lift (FS.isDir p);
  match d with
  | .true => EIO.pure ()
  | .false => FS.createDir p

def arty : EIO Unit := do
  ensureDir "build";
  let n := Circuit.netlist "p_arty" (pArty 5 12 .true Arty.n (Asm.assemble (Prog.demo 16380)));
  say ("p_arty: " ++ Nat.repr (List.length n.nodes) ++ " nodes, " ++ Nat.repr (List.length n.regs) ++ " registers, "
    ++ Nat.repr (List.length n.mems) ++ " memories, errors: " ++ Nat.repr (List.length n.errors));
  FS.writeFile "build/p_arty.v" (Verilog.emit n);
  FS.writeFile "build/p_arty.xdc" (Xdc.emit n Arty.board)

def main : IO Unit := EIO.toIO (do
  args ← EIO.lift IO.args;
  match args with
  | .cons "arty" .nil => arty
  | _ => EIO.fail "usage: pgen arty")
