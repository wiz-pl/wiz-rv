-- test: run
import Rv.PLockstep
import Rv.Progs
import IO

def go : Nat → HwTy.El (PpSt.code 4 8) → IO Unit
  | .zero, _ => IO.pure ()
  | .succ k, v =>
    let s := PLs.hw (ab := 4) (wb := 8) v;
    let r := pipeStep (r := HwTy.El) 4 8 .false s In.idle;
    let r2 := Bundle.ofEl (PpSt.bundle 4 8) r.1;
    IO.bind (IO.println ("cyc fe " ++ Nat.repr s.fe.pc.toNat ++ " al " ++ Nat.repr s.fe.al.toNat
      ++ " e " ++ Nat.repr s.e.pc.toNat ++ " ins " ++ Nat.repr s.e.ins.toNat
      ++ " J " ++ Nat.repr s.e.jal.toNat ++ Nat.repr s.e.jalr.toNat ++ Nat.repr s.e.branch.toNat
      ++ " imm " ++ Nat.repr s.e.imm.toNat ++ " A " ++ Nat.repr s.e.a.toNat ++ " B " ++ Nat.repr s.e.b.toNat ++ " rdr " ++ Nat.repr s.fe.rdr.toNat ++ " rtgt " ++ Nat.repr s.fe.rtgt.toNat
      ++ " rrpc " ++ Nat.repr s.rr.pc.toNat))
      (fun _ => go k r.1)

def main : IO Unit :=
  go 90 (Bundle.toEl (PpSt.bundle 4 8) (PpSt.init 4 8 (Asm.assemble (Prog.cProg Prog.cPad))))
