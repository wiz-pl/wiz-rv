-- test: check
import Rv.Lockstep
import Rv.Progs
import Rv.CTest
-- The core against the specification, in lockstep (src/Rv/Lockstep.wiz), on the test
-- programs: RV32E (16 registers, the HX1K configuration) and RV32I (32), 1 KB of
-- memory. Each line: instructions, cycles, trap code, the bytes output, and "agrees"
-- or what differed. (By `#eval`, in the kernel's evaluator: compiled, the value
-- simulation is slower; FINDINGS.md, S2.)

def showBytes : List Nat → String
  | .nil => ""
  | .cons x xs => Nat.repr x ++ " " ++ showBytes xs

def lines : List String → String
  | .nil => ""
  | .cons s ss => "; " ++ s ++ lines ss

def reportM (ab : Nat) (mx : Bool) (p : List Asm) (fuel : Nat) : String :=
  (fun (r : Ls.Result) => Nat.repr r.instrs ++ " instructions, " ++ Nat.repr r.cycles ++ " cycles, trap "
    ++ Nat.repr r.trap ++ ", out " ++ showBytes r.out
    ++ (match r.problems with
      | .nil => "agrees"
      | ps => "DISAGREES" ++ lines ps)) (Ls.run ab 8 mx (Asm.assemble p) fuel)
def report (ab : Nat) (p : List Asm) (fuel : Nat) : String := reportM ab .false p fuel
-- with the interrupt inputs driven by `irq` (cycle → mip bits)
def reportIrq (ab : Nat) (p : List Asm) (irq : Nat → Nat) (fuel : Nat) : String :=
  (fun (r : Ls.Result) => Nat.repr r.instrs ++ " instructions, " ++ Nat.repr r.cycles ++ " cycles, trap "
    ++ Nat.repr r.trap ++ ", out " ++ showBytes r.out
    ++ (match r.problems with
      | .nil => "agrees"
      | ps => "DISAGREES" ++ lines ps)) (Ls.runIrq ab 8 .false (Asm.assemble p) irq fuel)
-- with the A extension in the specification
def reportA (ab : Nat) (mx : Bool) (p : List Asm) (fuel : Nat) : String :=
  (fun (r : Ls.Result) => Nat.repr r.instrs ++ " instructions, " ++ Nat.repr r.cycles ++ " cycles, trap "
    ++ Nat.repr r.trap ++ ", out " ++ showBytes r.out
    ++ (match r.problems with
      | .nil => "agrees"
      | ps => "DISAGREES" ++ lines ps)) (Ls.runA ab 8 mx (Asm.assemble p) fuel)

def sumE : String := report 4 Prog.sum 400
#eval sumE
def aluE : String := report 4 Prog.alu 400
#eval aluE
def shiftE : String := report 4 Prog.shift 1000
#eval shiftE
def memE : String := report 4 Prog.mem 400
#eval memE
def branchE : String := report 4 Prog.branch 400
#eval branchE
def sortE : String := report 4 Prog.sort 6000
#eval sortE
def trapsE : List String :=
  .cons (report 4 Prog.trapLoad 50) (.cons (report 4 Prog.trapStore 50) (.cons (report 4 Prog.trapJump 50)
  (.cons (report 4 Prog.trapIllegal 50) (.cons (report 4 Prog.trapEcall 50) (.cons (report 4 Prog.x16 50) .nil)))))
#eval trapsE
-- Zicsr: write, read back, set and clear bits, the immediate forms, the WARL masks
-- (docs/csr.md)
def csrE : String := report 4 Prog.csr 400
#eval csrE
-- traps and interrupts with handlers (vectored mtvec): ECALL handled and returned past,
-- the timer interrupt in a loop, WFI waiting for MEIP with MIE off, the external
-- interrupt once MIE is set; then interrupts at arbitrary points of a load/store/branch
-- loop (the timer input pulses). The specification is given the interrupts the core
-- took (src/Rv/Lockstep.wiz) and must agree on every one.
def irqE : String := reportIrq 4 Prog.irq Prog.irqAt 1500
#eval irqE
def irqStressE : String := reportIrq 4 Prog.irqStress Prog.pulseAt 3000
#eval irqStressE
-- RV32I: x16 is a register
def ddrE : String := report 4 Prog.ddr 600
#eval ddrE
def ioE : String := report 4 Prog.ioload 100
#eval ioE
def x16I : String := report 5 Prog.x16 50
#eval x16I
def aluI : String := report 5 Prog.alu 400
#eval aluI
-- RV32IM: the M extension (and without it, MUL is illegal)
def mulI : String := report 5 Prog.muldivShort 400
#eval mulI
def mulIM : String := reportM 5 .true Prog.muldivShort 3000
#eval mulIM
-- RV32A: LR/SC success and failure, every AMO, reservation invalidation, fences, and
-- the misaligned/illegal traps
def atomicsI : String := reportA 5 .false Prog.atomics 5000
#eval atomicsI
def atomicsResvI : String := reportA 5 .false Prog.atomicsResv 500
#eval atomicsResvI
def aTrapsI : List String :=
  .cons (reportA 5 .false Prog.aTrapLr 50) (.cons (reportA 5 .false Prog.aTrapSc 50)
  (.cons (reportA 5 .false Prog.aTrapAmo 50) (.cons (reportA 5 .false Prog.aTrapIo 50)
  (.cons (reportA 5 .false Prog.aTrapF5 50) .nil))))
#eval aTrapsI
-- the Doom machine's boot loader (on-chip RAM, 16 KB), loading a program into DDR over
-- the UART and running it there (the specification models every I/O load as the UART's:
-- the boot loader's read of the DDR status takes the first byte, 1: "DDR ok")
def bootE : String := (fun (r : Ls.Result) => Nat.repr r.instrs ++ " instructions, out " ++ showBytes r.out
    ++ (match r.problems with
      | .nil => "agrees"
      | ps => "DISAGREES" ++ lines ps)) (Ls.runIn 4 12 .false (Asm.assemble Prog.boot) (.cons 1 (Boot.session (Asm.assemble Prog.hello))) 6000)
#eval bootE
-- compiled C (sw/ctest, gcc for RV32IM, newlib's string functions on misaligned
-- buffers, division, a 64-bit product), in the on-chip RAM
def ctestE : String := (fun (r : Ls.Result) => Nat.repr r.instrs ++ " instructions, out \""
    ++ String.mk (List.map Char.mk r.out) ++ "\" "
    ++ (match r.problems with
      | .nil => "agrees"
      | ps => "DISAGREES" ++ lines ps)) (Ls.run 5 12 .true (Hex.words CTest.hex) 40000)
#eval ctestE
